{
  "name": "engine-sim-web-v4pro-fkxqs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Low-cost procedural cross-plane V8 engine-sound synthesis + drivable Three.js track simulator (browser), inspired by the public principles of ange-yaghi/engine-sim.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:audio": "node --test \"test/audio-*.test.mjs\"",
    "test:vehicle": "node --test \"test/vehicle-*.test.mjs\" \"test/track-layout.test.mjs\"",
    "test:integration": "node --test \"test/integration-*.test.mjs\"",
    "test:browser": "node scripts/test-browser.mjs",
    "test:all": "node scripts/run-all-tests.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "render:wav": "node scripts/render-audio-wav.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "puppeteer-core": "^24.0.0"
  }
}

        {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"ccf_front_motor"},
         {"nodeWeight":12},
         ["tra1", 0, -0.7137, 0.279],
         {"group":""},

         ["e3l",  0.197, -0.91,   0.40],
         ["e4r", -0.197, -1.296,  0.40],
         ["e4l",  0.197, -1.296,  0.40],
         {"group":""},
         {"engineGroup":""},
         //engine mount nodes
         ["em1r", -0.38159, -1.110, 0.41, {"nodeWeight":2}],
         ["em1l", 0.38159, -1.110, 0.41, {"nodeWeight":2}],
         {"group":""},

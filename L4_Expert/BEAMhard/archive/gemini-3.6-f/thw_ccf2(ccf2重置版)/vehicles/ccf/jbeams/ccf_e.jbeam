        //"eqHighGain": -5,
        //"eqHighFreq": 6000,
        //"eqHighWidth": 0.1,
        //"eqFundamentalGain": -5,
    },
    "vehicleController": {
        "shiftLogicName":"electricMotor",
        "motorNames": ["frontMotor"],
        "topSpeedLimitReverse": 75,
        "onePedalRegenCoef": 0,
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["ccf_emotor_small", ["ccf_front_motor"],[]{"pos":{"x":0,"y":0,"z":0}}],
        ["ccf_emotor_small_mount", ["ccf_front_motor"],[]{"pos":{"x":0,"y":0,"z":0}}],
        {"deformGroup":"frontdeformeng", "deformMaterialBase":"ccf_mechanical", "deformMaterialDamaged":"invis"},

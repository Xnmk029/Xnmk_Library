    "ccf_DSE_drivemodes_offroadster": {
        "information":{
            "authors":"Theo Wilkinson",
            "name":"Swaybar Modes (Offroadster)",
            "value":250,
        },
        "slotType" : "ccf_DSE_drivemodes",
        "slots":[
            ["type", "default", "description"],
            ["ccf_DSE_drivemodes_swaybaron","ccf_DSE_drivemodes_swaybaron", "Swaybar On Mode"],
        ],
        "controller": [
            ["fileName"],
            ["driveModes"]
        ],

        "driveModes": {
            "enabledModes":["swaybaroff"],
            "defaultMode": "swaybaroff",
            "defaultSettings": [
                ["type"]                ["exhaust" {"name": "mainEngine", "mufflingOffset": 0, "gainOffset": 0}]
                ["turbocharger", {"name": "mainEngine", "wastegateOffset": 0}],
                ["transmission", {"defaultForwardMode": "D"}]

                ["controller", {"controllerName":"electronicSplitShaftLock", "isEnabled":false, "minimumLock":"default"}]

                ["controller", {"controllerName":"tractionControl", "isEnabled":false}]
                ["controller", {"controllerName":"yawControl", "isEnabled":false}]
                ["controller", {"controllerName":"motorTorqueControl", "isEnabled":false}]
                ["controller", {"controllerName":"brakeControl", "isEnabled":false}]

                ["controller", {"controllerName":"activeBiasFront", "isEnabled":false, "maxBiasOffset":0.2}]
                ["controller", {"controllerName":"activeBiasRear", "isEnabled":false, "maxBiasOffset":0.1}]

                ["controller", {"controllerName":"twoStepLaunch", "isEnabled":false, "launchRPM":4000}]
                ["controller", {"controllerName":"aeb", "isEnabled":true}]

                ["controller", {"controllerName":"adaptiveFrontSwayBar", "torsionBarMode":"regular"}]
                ["controller", {"controllerName":"adaptiveRearSwayBar", "torsionBarMode":"regular"}]
            ],
            "modes": {
                "swaybaroff": {
                    "name": "Swaybars Disabled",
                    "order": 10,
                    "settings": [
                        ["type"]
                        ["controller", {"controllerName":"adaptiveFrontSwayBar", "torsionBarMode":"off"}]
                        ["controller", {"controllerName":"adaptiveRearSwayBar", "torsionBarMode":"off"}]

                        ["controller", {"controllerName":"ccfGauges", "modeName": "Off", "modeColor": "#FF0000"}]
                        ["controller", {"controllerName":"gauge", "modeName": "OFF", "modeColor": "#FF0000"}]
                        ["controller", {"controllerName":"CMU", "uiDisplayData.simplePowertrainApp.activeColor": "FF0000"}]
                        ["controller", {"controllerName":"aeb", "isEnabled":false}]
                        ["controller", {"controllerName":"tractionControl", "isEnabled":false}]
                    ],
                }
                "swaybaron": {
                    "name": "Swaybars Enabled",
                    "order": 20,
                    "settings": [
                        ["type"]
                        ["controller", {"controllerName":"adaptiveFrontSwayBar", "torsionBarMode":"regular"}]
                        ["controller", {"controllerName":"adaptiveRearSwayBar", "torsionBarMode":"regular"}]

                        ["controller", {"controllerName":"ccfGauges", "modeName": "On", "modeColor": "#00FF00"}]
                        ["controller", {"controllerName":"gauge", "modeName": "ON", "modeColor": "#00FF00"}]
                        ["controller", {"controllerName":"CMU", "uiDisplayData.simplePowertrainApp.activeColor": "00FF00"}]
                        ["controller", {"controllerName":"aeb", "isEnabled":false}]
                        ["controller", {"controllerName":"tractionControl", "isEnabled":true}]
                    ],
                }
            },
        },
    },

    "ccf_DSE_drivemodes_swaybaron": {
        "information":{
            "authors":"Theo Wilkinson",
            "name":"Swaybar On Mode",
            "value":100,

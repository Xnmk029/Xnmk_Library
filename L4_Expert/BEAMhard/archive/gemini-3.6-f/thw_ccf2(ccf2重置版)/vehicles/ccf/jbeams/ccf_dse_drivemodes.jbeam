{
    "ccf_DSE_drivemodes_ICE": {
        "information":{
            "authors":"Theo Wilkinson",
            "name":"Drive Modes (ICE)",
            "value":250,
        },
        "slotType" : "ccf_DSE_drivemodes",
        "slots":[
            ["type", "default", "description"],
            ["ccf_DSE_drivemodes_default","ccf_DSE_drivemodes_default_Street", "Default Mode"],
            ["ccf_DSE_drivemodes_crawl","", "Crawl Mode"],
            ["ccf_DSE_drivemodes_trail","", "Trail Mode"],
            ["ccf_DSE_drivemodes_street","ccf_DSE_drivemodes_street", "Street Mode"],
            ["ccf_DSE_drivemodes_track","ccf_DSE_drivemodes_track", "Track Mode"],
            ["ccf_DSE_drivemodes_offTC","ccf_DSE_drivemodes_offTC", "TCS Off Mode"],
        ],

        "controller": [
            ["fileName"],
            ["driveModes"]
        ],

        "driveModes": {
            "enabledModes":["off"],
            "defaultMode": "Street",
            "defaultSettings": [
                ["type"]
                ["exhaust" {"name": "mainEngine", "mufflingOffset": 0, "gainOffset": 0}]
                ["turbocharger", {"name": "mainEngine", "wastegateOffset": 0}],
                ["transmission", {"defaultForwardMode": "D"}]

                ["controller", {"controllerName":"electronicSplitShaftLock", "isEnabled":true, "minimumLock":"default"}]

                ["controller", {"controllerName":"adaptiveFrontDamper", "damperMode":"hard"}]
                ["controller", {"controllerName":"adaptiveRearDamper", "damperMode":"hard"}]

                ["controller", {"controllerName":"adaptiveFrontSwayBar", "torsionBarMode":"regular"}]
                ["controller", {"controllerName":"adaptiveRearSwayBar", "torsionBarMode":"regular"}]

                ["controller", {"controllerName":"tractionControl", "isEnabled":true}]
                ["controller", {"controllerName":"yawControl", "isEnabled":true}]
                ["controller", {"controllerName":"motorTorqueControl", "tractionControl": "default", "yawControl": "default"}]
                ["controller", {"controllerName":"brakeControl", "tractionControl": "default", "yawControl": "default"}]
                ["controller", {"controllerName":"spoiler", "spoilerLow": 0, "spoilerNormal": 0.4, "spoilerHigh": 0.4}]

                ["controller", {"controllerName":"activeBiasFront", "isEnabled":true, "maxBiasOffset":0.2}]
                ["controller", {"controllerName":"activeBiasRear", "isEnabled":true, "maxBiasOffset":0.1}]

                ["controller", {"controllerName":"twoStepLaunch", "isEnabled":false, "launchRPM":4000}]
                ["controller", {"controllerName":"aeb", "isEnabled":true}]
            ],
            "modes": {
                "Street": {
                    "name": "Street",
                    "order": 10,
                    "settings": [
                        ["type"]
                        ["controller", {"controllerName":"ccfGauges", "modeName": "Street", "modeColor": "#0094FF"}]
                        ["controller", {"controllerName":"gauge", "modeName": "STREET", "modeColor": "#0094FF"}]
                        ["controller", {"controllerName":"CMU", "uiDisplayData.simplePowertrainApp.activeColor": "0094FF"}]
                        ["controller", {"controllerName":"aeb", "isEnabled":true}]
                    ],
                },
                "Track": {
                    "name": "Track",
                    "order": 20,
                    "settings": [
                        ["type"]
                        ["exhaust", {"name": "mainEngine", "mufflingOffset": -0.15, "gainOffset": 0}],
                        ["transmission", {"defaultForwardMode": "S"}],

                        ["controller", {"controllerName":"electronicSplitShaftLock", "isEnabled":true, "minimumLock":0.25}]

                        ["controller", {"controllerName":"adaptiveFrontDamper", "damperMode":"hard"}]
                        ["controller", {"controllerName":"adaptiveRearDamper", "damperMode":"hard"}]

                        ["controller", {"controllerName":"adaptiveFrontSwayBar", "torsionBarMode":"regular"}]
                        ["controller", {"controllerName":"adaptiveRearSwayBar", "torsionBarMode":"regular"}]

                        ["controller", {"controllerName":"activeBiasFront", "isEnabled":true, "maxBiasOffset":0.3}]
                        ["controller", {"controllerName":"activeBiasRear", "isEnabled":true, "maxBiasOffset":0.1}]

                        ["controller", {"controllerName":"motorTorqueControl",
                            "tractionControl.isEnabled":true,
                            "tractionControl.wheelGroupSettings.mainEngine.slipThreshold": 0.3,
                            "yawControl.isEnabled":true,
                        }]
                        ["controller", {"controllerName":"brakeControl",
                            "tractionControl.isEnabled":true,
                            "tractionControl.wheelGroupSettings.mainEngine.slipThreshold": 0.2,
                            "yawControl.isEnabled":true,
                            "yawControl.slipAngleThreshold": 0.1,
                            "yawControl.yawAvThreshold": 0.5
                        }]

                        ["controller", {"controllerName":"ccfGauges", "modeName": "Track", "modeColor": "#AF0000"}]
                        ["controller", {"controllerName":"gauge", "modeName": "TRACK", "modeColor": "#AF0000"}]
                        ["controller", {"controllerName":"CMU", "uiDisplayData.simplePowertrainApp.activeColor": "AF0000"}]
                        ["controller", {"controllerName":"spoiler", "spoilerLow": 0.45, "spoilerNormal": 0.45, "spoilerHigh": 1}]
                        ["controller", {"controllerName":"twoStepLaunch", "isEnabled":true, "launchRPM":6000}]
                        ["controller", {"controllerName":"aeb", "isEnabled":true}]
                    ],
                },
                "trail": {
                    "name": "Trail",
                    "order": 21,
                    "settings": [
                        ["type"]
                        ["exhaust", {"name": "mainEngine", "mufflingOffset": -0.15, "gainOffset": 1}],
                        ["turbocharger", {"name": "mainEngine", "wastegateOffset": 2}],
                        ["transmission", {"defaultForwardMode": "M1"}],

                        ["controller", {"controllerName":"electronicSplitShaftLock", "minimumLock":1.0}]

                        ["controller", {"controllerName":"adaptiveFrontDamper", "damperMode":"nonexistent"}]
                        ["controller", {"controllerName":"adaptiveRearDamper", "damperMode":"nonexistent"}]

                        ["controller", {"controllerName":"adaptiveFrontSwayBar", "torsionBarMode":"regular"}]
                        ["controller", {"controllerName":"adaptiveRearSwayBar", "torsionBarMode":"regular"}]

                        ["controller", {"controllerName":"tractionControl", "isEnabled":false}]
                        ["controller", {"controllerName":"motorTorqueControl", "tractionControl.isEnabled":false}]
                        ["controller", {"controllerName":"brakeControl", "tractionControl.isEnabled":false}]
                        ["controller", {"controllerName":"yawControl", "isEnabled":false}]

                        ["controller", {"controllerName":"ccfGauges", "modeName": "trail", "modeColor": "#61ff61"}]
                        ["controller", {"controllerName":"gauge", "modeName": "TRAIL", "modeColor": "#61ff61"}]
                        ["controller", {"controllerName":"CMU", "uiDisplayData.simplePowertrainApp.activeColor": "61ff61"}]
                        ["controller", {"controllerName":"aeb", "isEnabled":false}]
                    ],
                },
                "crawl": {
                    "name": "Crawl",
                    "order": 26,
                    "settings": [
                        ["type"]
                        ["exhaust", {"name": "mainEngine", "mufflingOffset": -0.15, "gainOffset": 1}],
                        ["turbocharger", {"name": "mainEngine", "wastegateOffset": 2}],
                        ["transmission", {"defaultForwardMode": "M1"}],

                        ["controller", {"controllerName":"electronicSplitShaftLock", "minimumLock":1.0}]

                        ["controller", {"controllerName":"adaptiveFrontDamper", "damperMode":"nonexistent"}]
                        ["controller", {"controllerName":"adaptiveRearDamper", "damperMode":"nonexistent"}]

                        ["controller", {"controllerName":"adaptiveFrontSwayBar", "torsionBarMode":"off"}]
                        ["controller", {"controllerName":"adaptiveRearSwayBar", "torsionBarMode":"off"}]

                        ["controller", {"controllerName":"tractionControl", "isEnabled":false}]
                        ["controller", {"controllerName":"motorTorqueControl", "tractionControl.isEnabled":false}]
                        ["controller", {"controllerName":"brakeControl", "tractionControl.isEnabled":false}]
                        ["controller", {"controllerName":"yawControl", "isEnabled":false}]

                        ["controller", {"controllerName":"ccfGauges", "modeName": "crawl", "modeColor": "#964B00"}]
                        ["controller", {"controllerName":"gauge", "modeName": "CRAWL", "modeColor": "#964B00"}]
                        ["controller", {"controllerName":"CMU", "uiDisplayData.simplePowertrainApp.activeColor": "964B00"}]
                        ["controller", {"controllerName":"aeb", "isEnabled":false}]
                    ],
                },
                "offTC": {
                    "name": "TCS Disabled",
                    "order": 30,
                    "settings": [
                        ["type"]
                        ["exhaust", {"name": "mainEngine", "mufflingOffset": -0.15, "gainOffset": 1}],
                        ["transmission", {"defaultForwardMode": "M1"}],
                        ["controller", {"controllerName":"electronicSplitShaftLock", "isEnabled":true, "minimumLock":0.25}]

                        ["controller", {"controllerName":"adaptiveFrontDamper", "damperMode":"regular"}]
                        ["controller", {"controllerName":"adaptiveRearDamper", "damperMode":"regular"}]

                        ["controller", {"controllerName":"adaptiveFrontSwayBar", "torsionBarMode":"regular"}]
                        ["controller", {"controllerName":"adaptiveRearSwayBar", "torsionBarMode":"regular"}]

                        ["controller", {"controllerName":"tractionControl", "isEnabled":false}]
                        ["controller", {"controllerName":"yawControl", "isEnabled":true}]
                        ["controller", {"controllerName":"motorTorqueControl", "isEnabled":true}]
                        ["controller", {"controllerName":"brakeControl", "isEnabled":false}]

                        ["controller", {"controllerName":"ccfGauges", "modeName": "TCS Disabled", "modeColor": "#BCBC00"}]
                        ["controller", {"controllerName":"gauge", "modeName": "TCS OFF", "modeColor": "#BCBC00"}]
                        ["controller", {"controllerName":"CMU", "uiDisplayData.simplePowertrainApp.activeColor": "BCBC00"}]

                        ["controller", {"controllerName":"spoiler", "spoilerLow": 0.58, "spoilerNormal": 0.58, "spoilerHigh": 1}]
                        ["controller", {"controllerName":"aeb", "isEnabled":false}]
                    ],
                },
                "off": {
                    "name": "DSE Fully Disabled",
                    "order": 40,
                    "settings": [
                        ["type"]
                        ["exhaust", {"name": "mainEngine", "mufflingOffset": -0.15, "gainOffset": 1}],
                        ["transmission", {"defaultForwardMode": "M1"}],
                        ["controller", {"controllerName":"electronicSplitShaftLock", "isEnabled":true, "minimumLock":0.25}]

                        ["controller", {"controllerName":"adaptiveFrontDamper", "damperMode":"regular"}]
                        ["controller", {"controllerName":"adaptiveRearDamper", "damperMode":"regular"}]

                        ["controller", {"controllerName":"adaptiveFrontSwayBar", "torsionBarMode":"regular"}]
                        ["controller", {"controllerName":"adaptiveRearSwayBar", "torsionBarMode":"regular"}]

                        ["controller", {"controllerName":"tractionControl", "isEnabled":false}]
                        ["controller", {"controllerName":"yawControl", "isEnabled":false}]
                        ["controller", {"controllerName":"motorTorqueControl", "isEnabled":false}]
                        ["controller", {"controllerName":"brakeControl", "isEnabled":false}]

                        ["controller", {"controllerName":"ccfGauges", "modeName": "DSE Disabled", "modeColor": "#FF6C00"}]
                        ["controller", {"controllerName":"gauge", "modeName": "DSE OFF", "modeColor": "#FF6C00"}]
                        ["controller", {"controllerName":"CMU", "uiDisplayData.simplePowertrainApp.activeColor": "FF6C00"}]

                        ["controller", {"controllerName":"spoiler", "spoilerLow": 0.58, "spoilerNormal": 0.58, "spoilerHigh": 1}]
                        ["controller", {"controllerName":"aeb", "isEnabled":false}]
                    ],
                }
            },
        },
    },

    "ccf_DSE_drivemodes_electricMotor": {
        "information":{
            "authors":"Theo Wilkinson",
            "name":"Drive Modes (eMotor)",
            "value":250,
        },
        "slotType" : "ccf_DSE_drivemodes",
        "slots":[
            ["type", "default", "description"],
            ["ccf_DSE_drivemodes_default","ccf_DSE_drivemodes_default_Street", "Default Mode"],
            ["ccf_DSE_drivemodes_street","ccf_DSE_drivemodes_street", "Street Mode"],
            ["ccf_DSE_drivemodes_track","ccf_DSE_drivemodes_track", "Track Mode"],
            ["ccf_DSE_drivemodes_offTC","ccf_DSE_drivemodes_offTC", "TCS Off Mode"],
        ],
        "controller": [
            ["fileName"],
            ["driveModes"]
            ["AVAS"]
        ],
        "AVAS": {
            "forwardSoundEvent":"event:>Engine>Pedestrian Warning>Version_01",
            "reverseSoundEvent":"event:>Engine>Pedestrian Warning>Version_01",
            "forwardSoundNode:":["f15"],
            "reverseSoundNode:":["r3"],
            "warningMaxSpeed": 14,
            "warningVolume": 0.5
        },

        "driveModes": {
            "enabledModes":["off"]
            "defaultMode": "Street",
            "defaultSettings": [
                ["type"]

                ["controller", {"controllerName":"adaptiveFrontDamper", "damperMode":"regular"}]
                ["controller", {"controllerName":"adaptiveRearDamper", "damperMode":"regular"}]

                ["controller", {"controllerName":"adaptiveFrontSwayBar", "damperMode":"regular"}]
                ["controller", {"controllerName":"adaptiveRearSwayBar", "damperMode":"regular"}]

                ["controller", {"controllerName":"tractionControl", "isEnabled":true}]
                ["controller", {"controllerName":"yawControl", "isEnabled":true}]
                ["controller", {"controllerName":"motorTorqueControl", "tractionControl": "default", "yawControl": "default"}]
                ["controller", {"controllerName":"brakeControl", "tractionControl": "default", "yawControl": "default"}]

                ["controller", {"controllerName":"spoiler", "spoilerLow": 0, "spoilerNormal": 0.4, "spoilerHigh": 0.4}]
            ],
            "modes": {
                "Street": {
                    "name": "Street",
                    "order": 10,
                    "settings": [
                        ["type"]
                        ["controller", {"controllerName":"gauge", "modeName": "STREET", "modeColor": "#0094FF"}]
                        ["simpleControlButton", {"buttonId":"dse", "uiName":"DSE","icon":"powertrain_esc","color":"0094FF", "offColor":"FFFF00", "offColorElectric":"dseWarningPulse"}],
                        ["controller", {"controllerName":"aeb", "isEnabled":true}]
                    ],
                },
                "Track": {
                    "name": "Track",
                    "order": 20,
                    "settings": [
                        ["type"]
                        ["controller", {"controllerName":"adaptiveFrontDamper", "damperMode":"hard"}]
                        ["controller", {"controllerName":"adaptiveRearDamper", "damperMode":"hard"}]

                        ["controller", {"controllerName":"adaptiveFrontSwayBar", "damperMode":"hard"}]
                        ["controller", {"controllerName":"adaptiveRearSwayBar", "damperMode":"hard"}]

                        ["controller", {"controllerName":"motorTorqueControl",
                            "tractionControl.isEnabled":true,
                            "tractionControl.wheelGroupSettings.frontMotor.slipThreshold": 0.3,
                            "tractionControl.wheelGroupSettings.rearMotor.slipThreshold": 0.3,
                            "yawControl.isEnabled":true,
                        }]
                        ["controller", {"controllerName":"brakeControl",
                            "tractionControl.isEnabled":true,
                            "tractionControl.wheelGroupSettings.frontMotor.slipThreshold": 0.2,
                            "tractionControl.wheelGroupSettings.rearMotor.slipThreshold": 0.2,
                            "yawControl.isEnabled":true,
                            "yawControl.slipAngleThreshold": 0.1,
                            "yawControl.yawAvThreshold": 0.5
                        }]

                        ["controller", {"controllerName":"spoiler", "spoilerLow": 0.58, "spoilerNormal": 0.58, "spoilerHigh": 1}]

                        ["controller", {"controllerName":"gauge", "modeName": "TRACK", "modeColor": "#AF0000"}]
                        ["simpleControlButton", {"buttonId":"dse", "uiName":"DSE","icon":"powertrain_esc","color":"AF0000", "offColor":"FFFF00", "offColorElectric":"dseWarningPulse"}],
                        ["controller", {"controllerName":"aeb", "isEnabled":true}]
                    ],
                },

                "offTC": {
                    "name": "TCS Disabled",
                    "order": 40,
                    "settings": [
                        ["type"]
                        ["controller", {"controllerName":"adaptiveFrontDamper", "damperMode":"hard"}]
                        ["controller", {"controllerName":"adaptiveRearDamper", "damperMode":"hard"}]

                        ["controller", {"controllerName":"adaptiveFrontSwayBar", "damperMode":"hard"}]
                        ["controller", {"controllerName":"adaptiveRearSwayBar", "damperMode":"hard"}]

                        ["controller", {"controllerName":"motorTorqueControl",
                            "tractionControl.isEnabled":false,
                            "yawControl.isEnabled":true,
                        }]
                        ["controller", {"controllerName":"brakeControl",
                            "tractionControl.isEnabled":false,
                            "yawControl.isEnabled":true,
                            "yawControl.slipAngleThreshold": 0.1,
                            "yawControl.yawAvThreshold": 0.5
                        }]

                        ["controller", {"controllerName":"spoiler", "spoilerLow": 0.58, "spoilerNormal": 0.58, "spoilerHigh": 1}]

                        ["controller", {"controllerName":"gauge", "modeName": "TCS OFF", "modeColor": "#BCBC00"}]
                        ["simpleControlButton", {"buttonId":"dse", "uiName":"DSE","icon":"powertrain_esc","color":"BCBC00", "offColor":"FFFF00", "offColorElectric":"dseWarningPulse"}],
                        ["controller", {"controllerName":"aeb", "isEnabled":false}]
                    ],
                },

                "off": {
                    "name": "DSE Fully Disabled",
                    "order": 50,
                    "settings": [
                        ["type"]
                        ["controller", {"controllerName":"adaptiveFrontDamper", "damperMode":"hard"}]
                        ["controller", {"controllerName":"adaptiveRearDamper", "damperMode":"hard"}]

                        ["controller", {"controllerName":"adaptiveFrontSwayBar", "damperMode":"hard"}]
                        ["controller", {"controllerName":"adaptiveRearSwayBar", "damperMode":"hard"}]

                        ["controller", {"controllerName":"tractionControl", "isEnabled":false}]
                        ["controller", {"controllerName":"yawControl", "isEnabled":false}]
                        ["controller", {"controllerName":"motorTorqueControl"}]
                        ["controller", {"controllerName":"brakeControl"}]

                        ["controller", {"controllerName":"spoiler", "spoilerLow": 0.58, "spoilerNormal": 0.58, "spoilerHigh": 1}]

                        ["controller", {"controllerName":"gauge", "modeName": "DSE OFF", "modeColor": "#FFFF00"}]
                        ["simpleControlButton", {"buttonId":"dse", "uiName":"DSE","icon":"powertrain_esc","color":"FFFF00", "offColor":"FFFF00", "offColorElectric":"dseWarningPulse"}],
                        ["controller", {"controllerName":"aeb", "isEnabled":false}]
                    ],
                }
            },
        },
    },


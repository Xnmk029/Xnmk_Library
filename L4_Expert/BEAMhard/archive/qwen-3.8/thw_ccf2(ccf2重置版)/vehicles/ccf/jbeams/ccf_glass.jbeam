{
"ccf_windscreen": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"ADAS Windscreen",
        "value":400,
    },
    "slotType" : "ccf_windscreen",
    "slots": [
        ["type", "default", "description"],
        ["ccf_centremirror","ccf_mirror_rhd_autodim", "Centre Mirror"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //glass
         {"deformGroup":"windscreen_break", "deformMaterialBase":"ccf_glass", "deformMaterialDamaged":"ccf_glass_dmg"},
         ["ccf_windscreen", ["ccf_windscreen","ccf_body","ccf_pillar"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>impact_glass_windscreen_01", "deformVolume":0.7}],

         {"deformGroup":"windscreen_break", "deformMaterialBase":"ccf_glass_int", "deformMaterialDamaged":"ccf_glass_int"},
         ["ccf_windscreen_int", ["ccf_windscreen","ccf_body","ccf_pillar"]],

         {"deformGroup":"windscreen_break", "deformMaterialBase":"glass_invisible", "deformMaterialDamaged":"glass_mirror"},
         ["ccf_windscreen_dmg", ["ccf_windscreen","ccf_body","ccf_pillar"]],
         
         {"deformGroup":"windscreen_break", "deformMaterialBase":"ccf_interior", "deformMaterialDamaged":"invis"},
         ["ccf_adas_rhd", ["ccf_windscreen","ccf_body","ccf_pillar"]]
         {"deformGroup":""},
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":true},
         {"collision":true},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_GLASS"},
         {"nodeWeight":2.0},
         {"group":""},
         //windscreen node
         ["wi1", 0, -0.32248, 0.9526, {"group":["ccf_windscreen","gps"]}],
         {"group":""},
         {"nodeMaterial":"|NM_METAL"},

         //--ADD WEIGHT--

         //windscreen
         {"group":"ccf_body"},
         //roof
         //a pillar
         {"nodeWeight":1.8},
         ["p1r", -0.6299, -0.159, 0.96, {"group":["ccf_body","ccf_windscreen"]}],
         ["p1l", 0.6299, -0.159, 0.96, {"group":["ccf_body","ccf_windscreen"]}],
         //firewall
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          {"breakGroup":""},
          {"deformGroup":""},
          //windscreen node
          {"disableMeshBreaking":true,"disableTriangleBreaking":true},
          {"beamSpring":1348050,"beamDamp":50},
          {"beamDeform":3750,"beamStrength":"FLT_MAX"},
          {"deformGroup":"windscreen_break", "deformationTriggerRatio":0.1},
          {"deformLimitExpansion":""},
          ["wi1","p3"],
          ["wi1","p3r"],
          ["wi1","p3l"],

          ["wi1","p1r"],
          ["wi1","p1l"],
          {"breakGroup":""},

          ["wi1","f9bll"],
          ["wi1","f9brr"],
          ["wi1","f9bl"],
          ["wi1","f9br"],
          ["wi1","f9b"],
          {"deformGroup":""},
          {"disableMeshBreaking":false,"disableTriangleBreaking":false},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          {"breakGroup":""},
          {"deformGroup":""},
          {"deformLimitExpansion":1.1},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //bonnet
            {"groundModel":"glass"},
            {"dragCoef":9},
            {"group":"ccf_windscreen"},
            ["f9bl","f9bll","p1l"],
            ["p1r","f9brr","f9br"],

            ["wi1","f9b","f9bl"],
            ["f9br","f9b","wi1"],

            ["wi1","f9bl","p1l"],
            ["p1r","f9br","wi1"],

            ["p3","wi1","p1l"],
            ["p1r","wi1","p3"],
            ["p1l","p3l","p3"],
            ["p3","p3r","p1r"],
            {"group":""},
    ],
},

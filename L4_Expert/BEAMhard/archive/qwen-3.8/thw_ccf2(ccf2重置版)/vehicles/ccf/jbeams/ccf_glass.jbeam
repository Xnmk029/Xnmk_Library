        {"beamDeform":14000,"beamStrength":34000},
        {"beamLimitSpring":305000,"beamLimitDamp":400},
        {"beamSpring":41000,"beamDamp":940},
        {"beamPrecompression":1},
        {"breakGroupType":1},
        {"disableTriangleBreaking":true},
        ["d8r","d12r", {"inputSource":"window_right","inLimit":1,"outLimit":0.01,"inRate":2,"outRate":2,"inputFactor":1.0}],
        ["d9r","d13r", {"inputSource":"window_right","inLimit":1,"outLimit":0.01,"inRate":2,"outRate":2,"inputFactor":1.0}],
        {"disableTriangleBreaking":false},

        /* 85.783 -98.941 62.419 */
        /* -0.125 0.881 -0.742*/
        ["window_right_prop", "ccf_doorglass_R",     "d12r",   "d13r", "d8r", {"x":85.783, "y":-98.941, "z":62.419}, {"x":0, "y":-14.4, "z":1}, {"x":-0.073, "y":0, "z":0}, 0, 1, 0, 1, {"baseTranslation":{"x":0, "y":0, "z":0}, "deformGroup":"doorglass_R_break"}],
        ["window_right_prop", "ccf_doorglass_R_int", "d12r",   "d13r", "d8r", {"x":85.783, "y":-98.941, "z":62.419}, {"x":0, "y":-14.4, "z":1}, {"x":-0.073, "y":0, "z":0}, 0, 1, 0, 1, {"baseTranslation":{"x":0, "y":0, "z":0}, "deformGroup":"doorglass_R_break"}],
    ],
    "controller": [
        ["fileName"],
        ["windowController", {"name":"windowR", "electricsFunc":"window_right", "electricsFuncProp":"window_right_prop", "electricsStartVal":0, "smootherValue":0.95, "propsmoother":{"in":[1,4], "out":[4,6,2]}}]
    ],    
    "events":[
        ["id", "title", "desc"],
        ["toggle_doorglass_R", "ui.inputActions.ccf.toggle_doorglass_R.title", "ui.inputActions.ccf.toggle_doorglass_R.description", {"onDown": "electrics.values.toggle_doorglass_R = 1-(electrics.values.toggle_doorglass_R or 0)", "order": 1}]
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_GLASS"},
         //right door glass
         {"selfCollision":false},
         {"collision":false},
         {"group":"ccf_door_R"},
         {"nodeWeight":1.8},
         ["d10r",-0.560, 0.15, 1.12],
         ["d11r",-0.597, 0.58888, 1.0919],
         {"collision":true},
         {"group":""},
         {"nodeWeight": 0.075},
         ["d12r",-0.560, 0.15, 1.12],
         ["d13r",-0.597, 0.58888, 1.0919],
         {"group":""},
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamType":"|NORMAL", "beamPrecompression":1, "beamLongBound":1.0, "beamShortBound":1.0},
        {"disableMeshBreaking":true,"disableTriangleBreaking":true},
        //right door glass
        {"beamSpring":2001000,"beamDamp":125},
        {"beamDeform":7800,"beamStrength":"FLT_MAX"},
        {"deformGroup":"doorglass_R_break","deformationTriggerRatio":0.02},
        {"deformLimitExpansion":""},
        ["d10r","d11r"],

        ["d10r","d9r", {"beamStrength":3000,"breakGroup":"doorglass_R_break"}],
        ["d10r","d8r"],
        ["d10r","d7r"],
        ["d11r","d9r"],
        ["d11r","d8r"],
        ["d11r","d7r", {"beamStrength":3000,"breakGroup":"doorglass_R_break"}],

        ["d10r","d14r"],
        ["d11r","d14r"],

        //window frame
        ["d11r", "d6r"],
        ["d10r", "d4r"],
        ["d10r", "d5r"],
        {"deformGroup":""},
        {"disableMeshBreaking":false,"disableTriangleBreaking":false},
        {"deformLimitExpansion":1.1},
    ],
    "rails": {
        "doorWindowRail_r1":{"links:":["d10r", "d8r"], "looped":false, "capped":true},
        "doorWindowRail_r2":{"links:":["d11r", "d9r"], "looped":false, "capped":true}
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["d12r", "doorWindowRail_r1", true, true, 0, 100000, 100000000, 345435],
        ["d13r", "doorWindowRail_r2", true, true, 0, 100000, 100000000, 345435],
    ],
    "hydros": [

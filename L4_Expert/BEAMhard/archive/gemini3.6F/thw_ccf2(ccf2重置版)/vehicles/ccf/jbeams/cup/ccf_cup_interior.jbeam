"ccf_cup_gaugecovers_lhd": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"Cup Gauges",
        "value":270,
    },
    "slotType" : "ccf_gaugecluster_lhd", 
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["ccf_cup_gaugecovers_lhd", ["ccf_body","ccf_dash","ccf_bootfloor"]],
        ["ccf_gaugecluster_lhd", ["ccf_body","ccf_dash","ccf_bootfloor"]],
        {"deformGroup":"dashboard_break", "deformMaterialBase":"ccf_cup_screen", "deformMaterialDamaged":"ccf_cup_screen_off"},
        ["ccf_cup_gaugescreen_lhd", ["ccf_body","ccf_dash","ccf_bootfloor"]],
        {"deformGroup":"dashboard_break", "deformMaterialBase":"ccf_aftermarket_o", "deformMaterialDamaged":"ccf_aftermarket_o"},
        ["ccf_cup_gaugeglass_lhd", ["ccf_body","ccf_dash","ccf_bootfloor"]],
        {"deformGroup":""},
        ["ccf_cup_gauges_lhd", ["ccf_body","ccf_dash","ccf_bootfloor"]],
        ["ccf_cup_gaugewires_lhd", ["ccf_body","ccf_dash","ccf_bootfloor"]],
    ],
    "slots": [
        ["type", "default", "description"],
        ["ccf_tachometer_lhd","ccf_tachometer_lhd", "Tachometer", {"coreSlot":true}],
        ["ccf_gaugescreens_lhd","ccf_gaugescreens_lhd", "Gauge Cluster Screens", {"coreSlot":true}],
    ],    
    "controller": [
        ["fileName"],
        ["gauges/genericGauges", {"name":"cupgauge"}],
        ["gauges/customModules/combustionEngineDataCCF", {"name":"gauges/customModules/combustionEngineDataCCFCup"}],
        ["gauges/customModules/hotlapping", {"updateTime": 0.5}],
        ["shiftLights"],
    ],
    "shiftLights": {
        "engineName":"mainEngine",
        "maxEngineRPMOffset": 100,
        "rpmRange": 4000,
        "keepLEDsActive": true,
        "hasStallWarning": true,
        "outputElectrics": ["led0", "led1", "led2", "led3", "led4", "led5", "led6", "led7","led8","led9"],
        "flashingOutputElectrics": ["led0", "led1", "led2", "led3", "led4", "led5", "led6"],
        "flashingAlternateOutputElectrics": [],
    },
    "glowMap":{
        "ccf_gauges_baked":{"simpleFunction":{"ignitionLevel":0.5}, "off":"ccf_gauges", "on":"ccf_gauges", "on_intense":"ccf_gauges"},
        //extra theo custom gauge lights (based on his sunburst facelift)
        "ccf_deadbatterylight":{"simpleFunction":"battery", "off":"invis", "on":"decals_gauges"},
        "ccf_oilpanlight":     {"simpleFunction":"oilPanLeak", "off":"invis", "on":"ccf_thw_decals_gauges"},
        "ccf_warninglight":    {"simpleFunction":"generalWarning", "off":"invis", "on":"ccf_thw_decals_gauges"},
        "ccf_brakefadelight":  {"simpleFunction":"brakeFade", "off":"invis", "on":"ccf_thw_extra_decals_gauges"},
        "ccf_indicator_L":     {"simpleFunction":"signal_L", "off":"invis", "on":"invis"},
        "ccf_indicator_R":     {"simpleFunction":"signal_R", "off":"invis", "on":"invis"},
        "ccf_abslight":    {"simpleFunction":"abs", "off":"invis", "on":"ccf_thw_extra_decals_gauges"},
        "ccf_shiftup":         {"simpleFunction":{"shiftup":1}, "off":"invis", "on":"invis", "on_intense":"invis"},
        //overwrites and turns off the screens behind the covers
        "ccf_gaugescreens":{"simpleFunction":{"ignitionLevel":0.5}, "off":"ccf_offscreen", "on":"ccf_offscreen", "on_intense":"ccf_offscreen"},

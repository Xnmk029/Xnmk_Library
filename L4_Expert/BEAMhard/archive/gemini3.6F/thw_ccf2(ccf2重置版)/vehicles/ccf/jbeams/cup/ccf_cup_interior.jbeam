{
"ccf_cup_shifter_seq_lhd": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"6-Speed Sequential Shifter",
        "value":120,
    },
    "slotType" : "ccf_shifter_lhd", 
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["ccf_cup_shifterboot_seq", ["ccf_shifterboot_M","ccf_shifterbase_M"]],
        ["ccf_cup_shiftknob_seq", ["ccf_shifterknob_M"]],
    ],          
    "glowMap":{
        "ccf_pedalsambient":{"simpleFunction":{"ignitionLevel":0.5}, "off":"ccf_interior.skin_interior.brown", "on":"ccf_interior.skin_interior.brown", "on_intense":"ccf_interior.skin_interior.brown"},
        }  ,
    "props": [
        ["func",        "mesh",                   "idRef:","idX:","idY:", "baseRotation",              "rotation",               "translation",            "min", "max", "offset", "multiplier"],
        ["brake", "ccf_brakepedal", "int3l","int1","int2l",         {"x":0, "y":0, "z":180},     {"x":-19, "y":0, "z":0},   {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1, {"baseTranslationGlobal":{"x":0.41083,"y":-0.57653,"z":0.779046}}],
        ["throttle", "ccf_accelpedal_lhd", "int3l","int1","int2l",      {"x":0, "y":0, "z":180},     {"x":20, "y":0, "z":0},   {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1, {"baseTranslationGlobal":{"x":0.310484,"y":-0.408203,"z":0.238004}}],
        ["clutch", "ccf_clutchpedal", "int3l","int1","int2l",        {"x":0, "y":0, "z":180},     {"x":-11, "y":0, "z":0},   {"x":0.0, "y":0, "z":0}, 0, 1, 0, 1, {"baseTranslationGlobal":{"x":0.531016,"y":-0.556784,"z":0.779046}}],
    ], 
    "controller": [
        ["fileName"],
        ["propAnimation/sequentialLever", {"name":"sequentialLever"}],
    ],
    "sequentialLever": {
        "shiftSoundNode:":["st_1r"],
        "shiftSoundEventSequentialGearUp": "event:>Vehicle>Interior>Gearshift>sequential_03_out",
        "shiftSoundEventSequentialGearDown": "event:>Vehicle>Interior>Gearshift>sequential_03_in",
        "shiftSoundVolumeSequentialGearUp": 1,
        "shiftSoundVolumeSequentialGearDown": 1,
    },
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":false},
         //--SHIFTER---  has to be jbeamed to allow for realistic movement
         {"group":"ccf_shifterbase_M"},
         {"nodeWeight":0.45}
         ["sh_b1l",  0.0784, 0.0412, 0.57],
         ["sh_b1r",  0.0014, -0.0358, 0.57],
         ["sh_b2l",  -0.0014, 0.1209, 0.57],
         ["sh_b2r",  -0.0784, 0.0440, 0.57],

         ["sh_b3", 0.0002, 0.0547, 0.541],
         {"selfCollision":true},
         {"group":["ccf_shifterknob_M","ccf_shifterboot_M"]},
         {"nodeWeight":0.5}
         ["sh_l3", 0.0000, 0.054922, 0.666509],
         {"selfCollision":false},
         {"nodeWeight":0.30}
         {"group":"ccf_shifterknob_M"},
         ["sh_l1l", 0.0000, 0.0874, 0.5853],
         ["sh_l1r", -0.0325, 0.0549, 0.5853],
         ["sh_l2l", 0.0325, 0.0549, 0.5853],
         ["sh_l2r", 0.0000, 0.0224, 0.5853],
         {"selfCollision":false},
         {"collision":true},
         {"group":""},
    ],
    "beams":[
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //main shape
        {"beamSpring":401000,"beamDamp":55},
        {"beamDeform":259000,"beamStrength":"FLT_MAX"},
        {"deformLimitExpansion":1.1},
        ["sh_b1l", "sh_b1r"],
        ["sh_b1l", "sh_b2l"],
        ["sh_b1l", "sh_b2r"],
        ["sh_b1r", "sh_b2l"],
        ["sh_b1r", "sh_b2r"],
        ["sh_b2l", "sh_b2r"],

        ["sh_b1l", "sh_b3"],
        ["sh_b1r", "sh_b3"],
        ["sh_b2l", "sh_b3"],
        ["sh_b2r", "sh_b3"],
        //lever
        {"beamSpring":121000,"beamDamp":35},
        ["sh_l3", "sh_l1l"],
        ["sh_l3", "sh_l1r"],
        ["sh_l3", "sh_l2l"],
        ["sh_l3", "sh_l2r"],

        ["sh_l1l", "sh_l1r"],
        ["sh_l1l", "sh_l2l"],
        ["sh_l1l", "sh_l2r"],

        ["sh_l1r", "sh_l2l"],
        ["sh_l1r", "sh_l2r"],
        ["sh_l2l", "sh_l2r"],
        //hinge
        {"beamSpring":121000,"beamDamp":25},
        ["sh_b3", "sh_l3"],
        ["sh_b3", "sh_l1l"],
        ["sh_b3", "sh_l1r"],
        ["sh_b3", "sh_l2l"],
        ["sh_b3", "sh_l2r"],

        //stabilize the shifter
        {"beamSpring":0,"beamDamp":175},
        ["sh_b1l", "sh_l3"],
        ["sh_b1r", "sh_l3"],
        ["sh_b2l", "sh_l3"],
        ["sh_b2r", "sh_l3"],
        {"breakGroup":""},
        //attach to body
        {"beamSpring":300000,"beamDamp":70},
        {"beamDeform":1000,"beamStrength":"FLT_MAX"},
        ["sh_b1l", "intb2"],
        ["sh_b1r", "intb2"],
        ["sh_b2l", "intb2"],
        ["sh_b2r", "intb2"],
        ["sh_b3",  "intb2"],

        ["sh_b1l", "f3r"],
        ["sh_b1r", "f3r"],
        ["sh_b2l", "f3r"],
        ["sh_b2r", "f3r"],
        ["sh_b3", "f3r"],

        ["sh_b1l", "f3l"],
        ["sh_b1r", "f3l"],
        ["sh_b2l", "f3l"],
        ["sh_b2r", "f3l"],
        ["sh_b3", "f3l"],

        ["sh_b1l", "f2r"],
        ["sh_b1r", "f2r"],
        ["sh_b2l", "f2r"],
        ["sh_b2r", "f2r"],
        ["sh_b3", "f2r"],

        ["sh_b1l", "f2l"],
        ["sh_b1r", "f2l"],
        ["sh_b2l", "f2l"],
        ["sh_b2r", "f2l"],
        ["sh_b3", "f2l"],

        {"beamSpring":200000,"beamDamp":20},
        ["sh_b1l", "int1r"],
        ["sh_b1r", "int1r"],
        ["sh_b2l", "int1r"],
        ["sh_b2r", "int1r"],
        ["sh_b3",  "int1r"],
        ["sh_b1l", "int1l"],

"ccf_screen": {
    "information":{
        "authors":"DaddelZeit",
        "name":"Central Screen",
        "value":650,
    },
    "slotType" : "ccf_screen",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        {"deformGroup":"dashboard_break", "deformMaterialBase":"ccf_gaugescreens", "deformMaterialDamaged":"ccf_offscreen"},
        ["ccf_screen", ["ccf_body","ccf_dash","ccf_bootfloor"]],
        {"deformGroup":"dashboard_break", "deformMaterialBase":"ccf_interior_un", "deformMaterialDamaged":"ccf_interior_un"},
        ["ccf_hazardpanel", ["ccf_body","ccf_dash","ccf_bootfloor"]],
        {"deformGroup":""},
        ["ccf_screenscreenglass", ["ccf_body","ccf_dash","ccf_bootfloor"]],
    ],
    "controller": [
        ["fileName"],
        ["gauges/genericGauges", {"name":"infotainment"}],
        ["gauges/customModules/environmentData", {"name": "gauges/customModules/environmentDataInfotainment"}],
        ["gauges/customModules/navigationData", {"name": "gauges/customModules/navigationDataInfotainment"}],
        ["gauges/customModules/stateController", {
            "type": "ccf_rhd",
            "saveApplyFuncs": {
                "navi.3d/2d": [1, "function func(s) { s.mapState[0] = VALUE }"],
                "navi.north_lock": [1, "function func(s) { s.mapState[1] = VALUE }"],
            },
            "saves": {
                "navi.3d/2d": false,
                "navi.north_lock": false,
                "settings.car_name":"HIROCHI",
                "audio.radioType": 2,
            },
            "triggerInteracts": {
                "navi.3d/2d": ["function(s) s['navi.3d/2d'] = not s['navi.3d/2d'] end", "function func(s) { s.mapState[0] = VALUE }"],
                "navi.north_lock": ["function(s) s['navi.north_lock'] = not s['navi.north_lock'] end", "function func(s) { s.mapState[1] = VALUE }"]
            }
        }],
        ["gauges/customModules/zeitRadio"]
    ],
    "infotainment": {
        "configuration": {
            "materialName": "@ccf_infotainment_screen",
            "htmlPath": "local://local/vehicles/ccf/infotainment_screen/info_screen.html",
            "displayWidth":1024,
            "displayHeight":512
        },
        "displayData": {
            "electrics": [
                "parkingSensorHits",
                "ignitionLevel"
            ],
            "powertrain": [
                ["deviceName", "property"]
            ],
            "customModules": [
                ["moduleName", "property"],
                ["environmentDataInfotainment", "time"],
                ["navigationDataInfotainment", ""],
                ["stateController", ""],
                ["zeitRadio", "songUpdate"],
            ]
        }
    }
},

{
"ccf_gaugescreens": {
    "information":{
        "authors":"DaddelZeit",
        "name":"Gauge Screens",
        "value":150,
    },
    "slotType" : "ccf_gaugescreens",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        {"deformGroup":"dashboard_break", "deformMaterialBase":"ccf_gaugescreens", "deformMaterialDamaged":"ccf_offscreen"},
        ["ccf_gaugescreens", ["ccf_body","ccf_dash","ccf_bootfloor"]],
        {"deformGroup":""},
    ],
    "controller": [
        ["fileName"],
        ["gauges/genericGauges", {"name":"gauge"}],
        ["gauges/customModules/environmentData"],
        ["gauges/customModules/combustionEngineDataCCF"],
        ["gauges/customModules/ccfMessageBox", {"soundEvent": "/vehicles/ccf/art/chimes/warn.ogg", "soundVolume":3}],
        ["gauges/customModules/navigationData"],
        ["gauges/customModules/speedLimit", {"soundEvent": "/vehicles/ccf/art/chimes/speed.ogg", "soundVolume":3}],
        ["gauges/customModules/accelerationData"],
        ["gauges/customModules/tireData"],
    ],
    "gauge": {
        "configuration": {
            "materialName": "@ccf_gauges_screen",
            "htmlPath": "local://local/vehicles/ccf/gauges_screen/gauges_screen.html",
            "displayWidth":512,
            "displayHeight":256
        },
        "displayData": {
            "electrics": [
                "signal_L",
                "signal_R",
                "lowhighbeam",
                "highbeam",
                "longrange",
                "lowpressure",
                "lowfuel",
                "parkingbrake",
                "checkengineBetter",
                "hazard",
                "ccfOdometer",
                "cruiseControlActive",
                "gear",
                "gearIndex",
                "maxGearIndex",
                "rpmTacho",
                "fuel",
                "watertemp",
                "oiltemp",
                "engineRunning",
                "running",
                "lightBroken",
                "wheelspeed",
                "esc",
                "escActive",
                "abs",
                "absActive",
                "tcs",
                "tcsActive",
                "fog",
                "tcsDisabled",
                "ccfOdometerTrip",
                "highBraketemp",
                "tirepressure",
                "startStopActive",
                "diffLockF",
                "diffLockM",
                "diffLockR",
                "modeRangeBox",
                "mode4WD",
                "ignitionLevel"
            ],
            "powertrain": [
                ["deviceName", "property"]
                //["mainEngine", "outputTorque1"]
                //["mainEngine", "outputAV1"]
                //["gearbox", "outputAV1"]
            ],
            "customModules": [
                ["moduleName", "property"],
                ["combustionEngineDataCCF", "remainingRange"],
                ["combustionEngineDataCCF", "averageFuelConsumption"],
                ["combustionEngineDataCCF", "timeSinceRespawn"],
                ["combustionEngineDataCCF", "gearIndexNoNeutral"],
                ["environmentData", "time"],
                ["navigationData", ""],
                ["accelerationData", "accelerationSmooth"],
                ["speedLimit", ""],
                ["ccfMessageBox", ""],
                ["tireData", "pressures"]
            ]
        }
    }
},

"ccf_fboot": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"Frontal Storage",
        "value":350,
    },
    "slotType" : "ccf_fboot", 
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["ccf_fboot", ["ccf_fboot"]]
   ],
   "nodes": [
        ["id", "posX", "posY", "posZ"],
        //--FRONT BUMPER--
        {"nodeWeight":0.7},
        {"frictionCoef":0.8},
        {"nodeMaterial":"|NM_PLASTIC"},
        {"group":["ccf_fboot"]},
        {"collision":true},
        {"selfCollision":true},

        ["fbo1l", 0.332,-1.297,0.672],
        ["fbo1r",-0.332,-1.297,0.672],

        ["fbo2l", 0.332,-0.838,0.732],
        ["fbo2r",-0.332,-0.838,0.732],

        ["fbo3l", 0.332,-1.297,0.513],
        ["fbo3r",-0.332,-1.297,0.513],

        ["fbo4l", 0.332,-0.748,0.513],
        ["fbo4r",-0.332,-0.748,0.513],

        {"group":""},
        {"collision":false},
        {"selfCollision":false},
   ],
   "beams": [
         ["id1:", "id2:"],
         //--FRONT BUMPER--
         {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
         {"beamSpring":151000,"beamDamp":150},
         {"beamDeform":5000,"beamStrength":59000},
         //main shape
         {"deformLimitExpansion":1.2},
         ["fbo1l", "fbo1r"],
         ["fbo2l", "fbo2r"],
         ["fbo3l", "fbo3r"],
         ["fbo4l", "fbo4r"],

         ["fbo1l", "fbo2l"],
         ["fbo1l", "fbo3l"],
         ["fbo2l", "fbo4l"],
         ["fbo3l", "fbo4l"],

         ["fbo1r", "fbo2r"],
         ["fbo1r", "fbo3r"],
         ["fbo2r", "fbo4r"],
         ["fbo3r", "fbo4r"],
         //crossing
         {"deformLimitExpansion":""},
         {"beamDeform":4750,"beamStrength":59000},
         ["fbo1l", "fbo4l"],
         ["fbo2l", "fbo3l"],
         ["fbo1r", "fbo4r"],
         ["fbo2r", "fbo3r"],

         ["fbo1l", "fbo2r"],
         ["fbo2l", "fbo1r"],
         ["fbo3l", "fbo4r"],
         ["fbo4l", "fbo3r"],

         ["fbo1r", "fbo3l"],
         ["fbo1l", "fbo3r"],
         ["fbo2r", "fbo4l"],
         ["fbo2l", "fbo4r"],

         //vertical rigids
 /*        {"beamDeform":2200,"beamStrength":59000},
         {"beamSpring":101000,"beamDamp":150},

         //widthwise
         {"beamDeform":3500,"beamStrength":120000},
*/

         //attach
         {"disableTriangleBreaking":true},
         {"beamSpring":501000,"beamDamp":100},
         {"beamDeform":14750,"beamStrength":32500},          

         {"breakGroup":"frunk_1"},
         {"deformGroup":""},
         {"optional":false},
         ["fbo3l", "f12l"],
         ["fbo3l", "f10l"],
         ["fbo3l", "f13l"],
         ["fbo3l", "f11l"],

         ["fbo3r", "f12r"],
         ["fbo3r", "f10r"],
         ["fbo3r", "f13r"],
         ["fbo3r", "f11r"],

         ["fbo4l", "f5l"],
         ["fbo4l", "f1l"],
         ["fbo4l", "f12l"],
         ["fbo4l", "f10l"],

         ["fbo4r", "f5r"],
         ["fbo4r", "f1r"],
         ["fbo4r", "f12r"],
         ["fbo4r", "f10r"],

         
         {"beamType":"|SUPPORT", "beamLongBound":4},
         {"beamSpring":1001000,"beamDamp":30},
         {"beamDeform":10000,"beamStrength":125000},
         ["fbo2r", "f9br"],
         ["fbo2l", "f9bl"],

         ["fbo4r", "f2r"],
         ["fbo4l", "f2l"],
         

         {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
         {"deformLimitExpansion":1.2},

         {"breakGroup":""},
         {"deformGroup":""},
   ],
   "triangles": [
           ["id1:","id2:","id3:"],
           //front bumper
           {"groundModel":"plastic"},
           {"dragCoef":4},
           {"group":"ccf_fboot"},
        //   ["fb1rr",  "fb2rrr", "fb2rr"],
           {"group":""},
   ],
},

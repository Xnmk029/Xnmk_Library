"ccf_steering": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"Steering",
        "value":500,
    },
    "slotType" : "ccf_steering",
    "slots": [
        ["type", "default", "description"],
        ["ccf_power_steering","ccf_power_steering", "Electrically Assisted Steering"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],        
         ["ccf_steeringrack", ["ccf_subframe_F"]],
         {"deformGroup":"steeringrack", "deformMaterialBase":"ccf_engbaycrap", "deformMaterialDamaged":"invis"},
         ["ccf_tierods_F", ["ccf_tierod_F"]],        
         {"deformGroup":""},

    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$toe_FR", "range", "", "Wheel Alignment", 1, 1.01, 0.99, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Front"}],
        ["$steer_center_F", "range", "", "Wheel Alignment", 0, -0.002, 0.002, "Toe Left/Right Trim", "Fine tunes the centerpoint of the steering", {"subCategory":"Front"}]
    ],
    "rails": {
        "steeringrack":{
            "links:":["fh6r", "fh6l"], "broken:":[], "looped":false, "capped":true,
        },
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["fx5r", "steeringrack", true, true, 0.0, 15001000, "FLT_MAX", "FLT_MAX"],
        ["fx5l", "steeringrack", true, true, 0.0, 15001000, "FLT_MAX", "FLT_MAX"],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--steering rod--
         {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"ccf_tierod_F"},
         {"nodeWeight":5},
         ["fh6r", -0.34, -1.2993, 0.198],
         {"group":"ccf_tierod_F"},
         ["fh6l", 0.34, -1.2993, 0.198],
         {"group":""},
    ],
    "beams": [
            ["id1:","id2:"],
            {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},        
            {"deformGroup":"steeringrack"},

            {"beamSpring":8001000,"beamDamp":150,"beamDeform":49500,"beamStrength":92500},
            ["fh6r","fh6l"],
            {"deformGroup":""},
            //toe in
            {"beamSpring":14001000,"beamDamp":150},
            ["fw2r","fh6r", {"beamPrecompression":"$=$toe_FR-$steer_center_F","beamPrecompressionTime":0.5}],
            ["fw2l","fh6l", {"beamPrecompression":"$=$toe_FR+$steer_center_F","beamPrecompressionTime":0.5}],
            //steering damper
            {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
            {"beamSpring":0,"beamDeform":16800,"beamStrength":42000},
            {"beamLimitSpring":0,"beamLimitDamp":0},
            {"beamDamp":25},
            ["fw2r","fx1r", {"beamDampVelocitySplit":0.1,"beamDampFast":500,"dampCutoffHz":750}],
            ["fw2r","fx1l", {"beamDampVelocitySplit":0.1,"beamDampFast":500,"dampCutoffHz":750}],
            ["fh5r","fx1r", {"beamDampVelocitySplit":0.1,"beamDampFast":500,"dampCutoffHz":750}],
            ["fh5l","fx1l", {"beamDampVelocitySplit":0.1,"beamDampFast":500,"dampCutoffHz":750}],
            ["fh5r","fx3r", {"beamDampVelocitySplit":0.1,"beamDampFast":500,"dampCutoffHz":750}],
            ["fh5l","fx3l", {"beamDampVelocitySplit":0.1,"beamDampFast":500,"dampCutoffHz":750}],
            {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "hydros": [
        ["id1:","id2:"],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":10001000,"beamDamp":25,"beamDeform":"FLT_MAX","beamStrength":92500},
        {"deformGroup":"steeringrack"},
        ["fh6r","fx5l", {"factor":0.18,"steeringWheelLock":450, "inRate":1.95,"outRate":1.95}],
        ["fh6l","fx5r", {"factor":-0.18,"steeringWheelLock":450, "inRate":1.95,"outRate":1.95}],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"deformGroup":""},
    ],
    "input": {
        "FFBcoef":"$=$ffbstrength*9",
    },
},

"ccf_coilover_F": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"Front Coilovers",
        "value":900,
    },
    "slotType" : "ccf_coilover_F",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["ccf_coilover_F_black", ["ccf_shockbottom_F","ccf_shocktop_F"]],
    ],
    "slots": [
        ["type", "default", "description"],
        ["ccf_strutbar","", "Strut Bar"],
    ],
    "beams": [
          ["id1:", "id2:"],
          //front springs
          {"beamPrecompression":1, "beamType":"|NORMAL"},
          {"beamDeform":40000,"beamStrength":50000},
          {"beamSpring":30000,"beamDamp":0},
          //MR 0.65
          ["fh1r","fs1r", {"name":"spring_FR", "precompressionRange":0.13,
              "soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.5,"attackFactor":10,"volumeFactor":1.3,"decayFactor":6,"noiseFactor":0.01,"pitchFactor":0.2,"maxStress":2900}],
          ["fh1l","fs1l", {"name":"spring_FL", "precompressionRange":0.13,
              "soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.5,"attackFactor":10,"volumeFactor":1.3,"decayFactor":6,"noiseFactor":0.01,"pitchFactor":0.2,"maxStress":2900}],
          //damper
          //MR 0.8
          {"beamPrecompression":1.0, "beamType":"|BOUNDED","beamLongBound":1, "beamShortBound":1},
          {"beamSpring":0,"beamDamp":3900},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          ["fh1r","fs1r", {"name":"damper_FR","beamDampFast":2300,"beamDampRebound":7600,"beamDampReboundFast":3390,"beamDampVelocitySplit":0.08,"dampCutoffHz":500}],
          ["fh1l","fs1l", {"name":"damper_FL","beamDampFast":2300,"beamDampRebound":7600,"beamDampReboundFast":3390,"beamDampVelocitySplit":0.08,"dampCutoffHz":500}],
          //soft bump stop
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":35000,"beamLimitDamp":2000},
          ["fh1r","fs1r", {"longBoundRange":0.06,"shortBoundRange":0.035,"boundZone":0.05,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["fh1l","fs1l", {"longBoundRange":0.06,"shortBoundRange":0.035,"boundZone":0.05,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          //hard bump stop
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":201000,"beamLimitDamp":10000},
          ["fh1r","fs1r", {"longBoundRange":0.06,"shortBoundRange":0.05,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["fh1l","fs1l", {"longBoundRange":0.06,"shortBoundRange":0.05,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          {"breakGroup":""},
          {"deformGroup":""},
    ],
},

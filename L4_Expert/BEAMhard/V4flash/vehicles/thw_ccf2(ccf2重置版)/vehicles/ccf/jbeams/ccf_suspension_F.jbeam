         {"group":["ccf_subframe_F","ccf_upperarm_F_R"]},
         ["fx4r", -0.4527, -1.044, 0.328],         
         
         //--FRONT INDEPENDENT SUSPENSION-- went very high dp
         {"collision":true},
         {"selfCollision":false},
         //front hub
         {"nodeWeight":8.5},
         {"group":["ccf_lowerarm_F_R","ccf_knuckle_FR"]},
         ["fh1r",-0.6794, -1.1993, 0.19668],
         {"group":["ccf_lowerarm_F_L","ccf_knuckle_FL"]},
         ["fh1l", 0.6794, -1.1993, 0.19668],        
         {"nodeWeight":6.75},
         {"selfCollision":false},
         {"group":["ccf_upperarm_F_R","ccf_knuckle_FR"]},
         ["fh4r",-0.6317, -1.1896, 0.386],
         {"group":["ccf_upperarm_F_L","ccf_knuckle_FL"]},
         ["fh4l", 0.6317, -1.1896, 0.386],            
         
         {"group":[""]},
         {"nodeWeight":5.75},
         ["fh5l", 0.65532, -1.1006, 0.28525],
         ["fh5r",-0.65532, -1.1006, 0.28525],
         {"group":["ccf_knuckle_FR","ccf_tierod_F"]},
         {"nodeWeight":5.0},

    "adaptiveFrontSwayBar": {
        "modes": [
            ["name",    "springCoef", "dampCoef"]
            ["regular", 1,            1]
            ["off",    0,        1] //29mm
        ]
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["ccf_swaybar_F", ["ccf_swaybar_F"]],
        ["ccf_swaybar_F_links", ["ccf_swaybar_F"]],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //anti-roll
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"ccf_swaybar_F"},
         {"selfCollision":false},
         {"collision":true},
         {"nodeWeight":2.0},
         //front anti-roll
        ["fxarbl", 0.41657, -1.36, 0.28],
        ["fxarbr", -0.41657, -1.36, 0.28],

         //ARB ends
         ["arbfr", -0.55, -1.1717, 0.27],
         ["arbfl",  0.55, -1.1717, 0.27],
         {"group":""},
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        {"spring":3620, "damp":10, "deform":10000, "strength":9999999},
        ["arbfr", "fxarbr", "fxarbl", "arbfl", {"name": "torsionBarFront"}],
    ],
    "beams": [
          ["id1:", "id2:"],
          //--ANTI-ROLL--
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          {"breakGroup":""},
          {"deformGroup":""},
          {"beamSpring":1501000,"beamDamp":100},
          {"beamDeform":155000,"beamStrength":350000},
          //ARB main beams
          ["arbfr","fxarbr"],
          ["fxarbl","fxarbr"],
          ["arbfl","fxarbl"],
          ["arbfl","fxarbr"],
          ["arbfr","fxarbl"],
          
        //linkets
        ["arbfl","fh2l"]
        ["arbfr","fh2r"]
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          {"breakGroup":""},
          {"deformGroup":""},
    ],
},

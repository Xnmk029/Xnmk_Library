{
"ccf_suspension_F": {
    "information":{
        "authors":"Theo & Finn Wilkinson",
        "name":"Front Subframe",
        "value":4000,
    },
    "slotType" : "ccf_suspension_F",
    "slots": [
        ["type", "default", "description"],
        //The case() is for backwards compatibility for old configs that use "trackwidth_F" variable.
        //To change the base track width, edit the trackoffset_F offset in the expression.
     //   ["wheel_F_5","ccf_wheel_1a_lj_16x8_F_rework", "Front Wheels", {"nodeOffset":{"x":"$=case($trackwidth_F == nil, $trackoffset_F+0.245, $trackwidth_F)", "y":-1.1994, "z":0.28525}}],
        ["ccf_hub_F","ccf_hub_5l_F", "Front Hub"],
        ["ccf_wheeldata_F","ccf_wheeldata_F", "Front Spindles", {"coreSlot":true}],
        ["ccf_coilover_F","ccf_coilover_F", "Front Coilovers"],
        ["ccf_swaybar_F","ccf_swaybar_F", "Front Sway Bar"],
        ["ccf_steering","ccf_steering", "Steering"],
        ["ccf_shielding_F","ccf_shielding_F", "Shielding"],    
        ["ccf_cup_towstrap_f","", "Front Tow Strap"],
    ],    
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$camber_FR", "range", "", "Wheel Alignment", 1.0005, 0.95, 1.05, "Camber Adjust", "Adjusts the wheel camber angle", {"subCategory":"Front"}],
        ["$caster_FR", "range", "", "Wheel Alignment", 1, 0.985, 1.015, "Caster Adjust", "Adjusts forward rake of the steering axis", {"subCategory":"Front"}],
        ["$trackoffset_F", "range", "+m", "Wheels", 0.0, -0.02, 0.1, "Wheel Offset", "Spacing of the wheel from the hub", {"stepDis":0.001,"subCategory":"Front"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
        ["ccf_subframe_F", ["ccf_subframe_F"]],
        ["ccf_lowerarm_F_R", ["ccf_lowerarm_F_R"]],
        ["ccf_upperarm_F_R", ["ccf_upperarm_F_R"]],
        ["ccf_lowerarm_F_L", ["ccf_lowerarm_F_L"]],
        ["ccf_upperarm_F_L", ["ccf_upperarm_F_L"]],
        ["ccf_knuckle_FL", ["ccf_knuckle_FL"]],
        ["ccf_knuckle_FR", ["ccf_knuckle_FR"]],
        

        ["ccf_crossmember_F_a", ["ccf_subframe_F"]],
        {"deformGroup":""},
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"collision":true},
         {"selfCollision":true},
         {"nodeWeight":4.5},
         {"group":["ccf_subframe_F","ccf_lowerarm_F_L","ccf_tierod_F"]},
         //central 'box'
         ["fx1l", 0.38642, -1.2088, 0.1515],
         ["fx2l", 0.38642, -0.8847, 0.18],
         {"group":["ccf_subframe_F","ccf_lowerarm_F_R","ccf_tierod_F"]},
         ["fx1r", -0.38642, -1.2088, 0.1515],
         ["fx2r", -0.38642, -0.8847, 0.18],
         {"group":["ccf_subframe_F","ccf_upperarm_F_L"]},
         ["fx3l", 0.4527, -1.368, 0.35],
         {"group":["ccf_subframe_F","ccf_upperarm_F_R"]},
         ["fx3r", -0.4527, -1.368, 0.35],
         {"group":["ccf_subframe_F","ccf_upperarm_F_L"]},
                  {"selfCollision":false},

        "flutterSoundVolumeCoef":0.60,
        "hissVolumePerPSI": 0.038,
        "whineVolumePer10kRPM": 0.007,
        "whinePitchPer10kRPM": 0.055,
        "wastegateStart":"$wastegateStart",
        "wastegateLimit":"$=$wastegateStart+1",
        "maxExhaustPower": 250000,
        "backPressureCoef": 0.00008,
        "frictionCoef": 100,
        "inertia":7,
        "pressureRatePSI": 95,
        "damageThresholdTemperature": 900,
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            [0,       -3.5],
            [30000,    1.5],
            [60000,      4],
            [90000,     11],
            [150000,    18],
            [200000,    25],
            [250000,    33],
            [300000,    40],
            [350000,    50],
            [400000,    60],
            [450000,    70],
            [500000,    80],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor
            [0,     0.0,    0.0],
            [650,   0.23,   0.05],
            [1400,  0.33,   0.1],
            [2000,  0.41,   0.2],
            [2500,  0.54,   0.3],
            [3000,  0.85,   0.45],
            [4000,  0.92,   0.79],
            [5000,  0.96,   0.93],
            [6000,  0.98,   1.0],
            [7000,  1.0,    1.0],
            [8000,  1.0,    1.0],
            [9000,  1.0,    1.0],
            [10000,  1.0,    1.0],
            [11000,  1.0,    1.0],

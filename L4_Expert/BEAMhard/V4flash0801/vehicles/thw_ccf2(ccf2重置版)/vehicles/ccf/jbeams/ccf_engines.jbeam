        ["rpmspin",             "ccf_pulley_5",      "e3l","e3r","e4l",     {"x":-90, "y":0, "z":0}, {"x":0, "y":1, "z":0}, {"x":0, "y":0, "z":0}, -360,  360,   0,        1],
    ],
    "mainEngine":{
        "torque":[
            ["rpm", "torque"],
            [0, 0],
            [500, 107],
            [1000, 172],
            [2000, 207],
            [3000, 226],
            [4000, 234],
            [4500, 235],
            [4977, 236],
            [5326, 266],
            [5500, 272],
            [6000, 263],
            [6500, 249],
            [7000, 235],
            [7500, 216],
            [8000, 173],
            [9000, 143],
            [10000, 123],
            [11000, 103],
            [12000, 83],
        ],

        "idleRPM":950,
        //max rpm physically capable of
        "maxRPM":10200,
        "revLimiterType": "soft",
        "inertia":0.11,
        "friction":11.5,
        "dynamicFriction":0.024,
        "engineBrakeTorque":38,
        //"burnEfficiency":0.4
        "burnEfficiency":[
            [0, 0.12],
            [0.05, 0.27],
            [0.4, 0.5],
            [0.7, 0.47],
            [1, 0.34],
        ],
        //fuel system
        "energyStorage": "mainTank",
        "requiredEnergyType":"gasoline",

        //exhaust
        "instantAfterFireSound": "event:>Vehicle>Afterfire>box4_01>single",
        "sustainedAfterFireSound": "event:>Vehicle>Afterfire>box4_01>multi",
        "shiftAfterFireSound": "event:>Vehicle>Afterfire>box4_01>shift",
        "particulates":0.02,
        "instantAfterFireCoef": 0.75,
        "sustainedAfterFireCoef": 0.5,

        //cooling and oil system
        "thermalsEnabled":true,
        "engineBlockMaterial":"aluminum",
        "oilVolume":5,
        "engineBlockAirCoolingEfficiency":28,

        //engine durability
        "cylinderWallTemperatureDamageThreshold":150,
        "headGasketDamageThreshold":1500000,
        "pistonRingDamageThreshold":1500000,
        "connectingRodDamageThreshold":2000000,
        "maxTorqueRating": 410,
        "maxOverTorqueDamage": 500,

        //node beam interface
        "torqueReactionNodes:":["e1l","e2l","e4r"],
        "waterDamage": {"[engineGroup]:":["engine_intake"]},
        "radiator": {"[engineGroup]:":["radiator"]},
        "engineBlock": {"[engineGroup]:":["engine_block"]},
        "breakTriggerBeam":"engine",
        "uiName":"Engine",
        "soundConfig": "soundConfig",
        "soundConfigExhaust": "soundConfigExhaust",

        //starter motor
        "starterSample":"event:>Engine>Starter>i6_2007_eng",
        "starterSampleExhaust":"event:>Engine>Starter>i6_2007_exh",
        "shutOffSampleEngine":"event:>Engine>Shutoff>i6_2007_eng",
        "shutOffSampleExhaust":"event:>Engine>Shutoff>i6_2007_exh",
        "starterVolume":0.7,
        "starterVolumeExhaust":1.0,
        "shutOffVolumeEngine":0.4,
        "shutOffVolumeExhaust":0.5,
        "starterThrottleKillTime":0.5,
        "idleRPMStartRate":1.5,
        "idleRPMStartCoef":3,

        //engine deform groups
        "deformGroups":["mainEngine", "mainEngine_intake", "mainEngine_accessories"]
        "deformGroups_oilPan":["oilpan_damage"]
    },
    "soundConfig": {
        "sampleName": "hvvtl_engine_f4",
        "intakeMuffling": 0.0,

        "mainGain": -24,
        "onLoadGain":1,
        "offLoadGain":0.22,

        "maxLoadMix": 0.8,

{
"ccf_auxlight_bumper_F": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"Hirochi Auxiliary Bumper Lights",
        "value":120,
    },
    "slotType" : "ccf_splitter",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         {"deformGroup":"auxlight_break_L", "deformMaterialBase":"ccf_aftermarket", "deformMaterialDamaged":"ccf_aftermarket_dmg"},
         ["ccf_auxiliarylight_bumper_L", ["ccf_auxlight_bumper_L"]]
         {"deformGroup":"auxlight_break_R", "deformMaterialBase":"ccf_aftermarket", "deformMaterialDamaged":"ccf_aftermarket_dmg"},
         ["ccf_auxiliarylight_bumper_R", ["ccf_auxlight_bumper_R"]]
         {"deformGroup":"frontventguide", "deformMaterialBase":"ccf_aftermarket", "deformMaterialDamaged":"invis"},
         ["ccf_auxlightcable_bumpermount", ["ccf_body"]]
         {"deformGroup":"auxlight_break_L", "deformMaterialBase":"ccf_aftermarket", "deformMaterialDamaged":"ccf_aftermarket"},
         ["ccf_auxlightswitch_breaklight", ["ccf_pillar"]]
         {"deformGroup":"auxlight_break_R", "deformMaterialBase":"ccf_aftermarket", "deformMaterialDamaged":"ccf_aftermarket"},
         ["ccf_auxlightswitch_breaklight_B", ["ccf_pillar"]]
         {"deformGroup":""},
         ["ccf_auxlightswitch", ["ccf_pillar"]]
    ],
    "triggers":[
        ["id", "label", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["auxlighttoggle", "", "p4r","p4l","p3r", "box", {"x":0.02, "y":0.02, "z":0.02}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.328, "y":0.05, "z":-0.055}],
    ],
    "triggerEventLinks":[
        ["triggerId:triggers", "action", "targetEventId:events"],
        ["auxlighttoggle", "action0", "auxlighttoggle"],
    ],
    "events":[
        ["id", "title", "desc"],
        ["auxlighttoggle", "", "", {"onDown":"electrics.values.auxlight = 1 - (electrics.values.auxlight or 0)", "order": 1}],
    ],   
    "glowMap":{
            "ccf_auxlight":{"simpleFunction":{"auxlight":1}, "off":"ccf_aftermarket", "on":"ccf_aftermarket_on_intense"},
    },
    "props": [
        ["func", "mesh", "idRef:", "idX:", "idY:", "baseRotation", "rotation", "translation", "min", "max", "offset", "multiplier"],
        {
            "lightInnerAngle":0,
            "lightOuterAngle":80,
            "lightColor":{"r":180, "g":180, "b":255, "a":255},
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":true,
            "flareName":"vehicleHeadLightFlare",
            "cookieName":"art/special/BNG_light_cookie_headlight.dds"
            "texSize":512,
            "shadowSoftness":0.5,
        },
        ["auxlight",  "SPOTLIGHT", "laux1", "laux2", "laux4", {"x":0,"y":0,"z":0}, {"x":0,"y":0,"z":0}, {"x":0,"y":0,"z":0}, 0, 0, 0, 1,{"baseTranslation":{"x":0.5,"y":0.5,"z":0.05},"lightRange":150,"lightBrightness":1.5,"lightOuterAngle":140,"flareScale":0.05,"deformGroup":"auxlight_break_L"}],
        ["auxlight",  "SPOTLIGHT", "raux1", "raux4", "raux2", {"x":0,"y":0,"z":0}, {"x":0,"y":0,"z":0}, {"x":0,"y":0,"z":0}, 0, 0, 0, 1,{"baseTranslation":{"x":0.5,"y":0.5,"z":0.05},"lightRange":150,"lightBrightness":1.5,"lightOuterAngle":140,"flareScale":0.05,"deformGroup":"auxlight_break_R"}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"nodeWeight":0.7},
         {"frictionCoef":0.8},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"group":["ccf_auxlight_bumper_L"]},
         {"collision":true},
         {"selfCollision":false},
         //clockwise from the right
         ["laux1", 0.356,-1.896,0.212],
         ["laux2", 0.311,-1.896,0.163],
         ["laux3", 0.262,-1.896,0.209],
         ["laux4", 0.307,-1.896,0.258],
         ["laux5", 0.309,-1.858,0.210],

         {"group":["ccf_auxlight_bumper_R"]},
         //mirrored from the left light
         ["raux1",-0.356,-1.896,0.212],
         ["raux2",-0.311,-1.896,0.163],
         ["raux3",-0.262,-1.896,0.209],
         ["raux4",-0.307,-1.896,0.258],
         ["raux5",-0.309,-1.858,0.210],
         {"group":[""]},
    ],
    "beams": [
          ["id1:", "id2:"],
          //--FRONT BUMPER--
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          {"breakGroup":""},
          {"deformGroup":""},
          {"beamSpring":151000,"beamDamp":150},
          {"beamDeform":85000,"beamStrength":59000},
          ["laux1", "laux2"],
          ["laux2", "laux3"],
          ["laux3", "laux4"],
          ["laux4", "laux1"],

          ["laux1", "laux5"],
          ["laux2", "laux5"],
          ["laux3", "laux5"],
          ["laux4", "laux5"],

          ["raux1", "raux2"],
          ["raux2", "raux3"],
          ["raux3", "raux4"],
          ["raux4", "raux1"],

          ["raux1", "raux5"],
          ["raux2", "raux5"],
          ["raux3", "raux5"],
          ["raux4", "raux5"],

          ["raux1", "raux3"],
          ["raux2", "raux4"],

          ["laux1", "laux3"],
          ["laux2", "laux4"],

          //attach
          {"disableTriangleBreaking":true},
          {"beamSpring":101000,"beamDamp":100},
          {"beamDeform":15750,"beamStrength":2500},          
          {"deformGroup":"auxlight_break_L", "deformationTriggerRatio":0.04},
          //right
          {"breakGroup":"auxlight_L"},
          ["laux4", "fb3ll"],
          ["laux4", "fb3l"],
          ["laux4", "fb3"],
          ["laux4", "fb2ll"],
          ["laux4", "fb2l"],
          ["laux4", "fb2"],

          ["laux1", "fb2ll"],
          ["laux1", "fb2l"],
          ["laux1", "fb2"],

          ["laux3", "fb2ll"],
          ["laux3", "fb2l"],
          ["laux3", "fb2"],

          {"deformGroup":"auxlight_break_R", "deformationTriggerRatio":0.04},
          //right
          {"breakGroup":"auxlight_R"},
          ["raux4", "fb3rr"],
          ["raux4", "fb3r"],
          ["raux4", "fb3"],
          ["raux4", "fb2rr"],
          ["raux4", "fb2r"],
          ["raux4", "fb2"],

          ["raux1", "fb2rr"],
          ["raux1", "fb2r"],
          ["raux1", "fb2"],

          ["raux3", "fb2rr"],
          ["raux3", "fb2r"],
          ["raux3", "fb2"],

          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          {"breakGroup":""},
          {"deformGroup":""},
          {"deformLimitExpansion":1.2},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //front bumper
            {"groundModel":"plastic"},
            {"dragCoef":4},
            {"group":"ccf_auxlight_bumper_F"},

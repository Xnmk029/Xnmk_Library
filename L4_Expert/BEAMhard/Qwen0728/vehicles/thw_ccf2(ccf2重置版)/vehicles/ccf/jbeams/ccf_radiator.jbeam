{
"ccf_radiator": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"F4 Radiator",
        "value":380,
    },
    "slotType" : "ccf_radiator",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["ccf_radiator", ["ccf_radiator"]],
         ["ccf_coolantreservoir", ["ccf_radiator"]],          
         {"deformGroup":"radiatorhose", "deformMaterialBase":"ccf_mechanical", "deformMaterialDamaged":"invis"},
         ["ccf_coolanttoradiator", ["ccf_airbox","ccf_radiator"]],      
         ["ccf_cpumptoengine", ["ccf_airbox","ccf_engine"]],      
         ["ccf_coolanttoradiator", ["ccf_airbox","ccf_radiator"]],   
         {"deformGroup":"intaketoengine", "deformMaterialBase":"ccf_mechanical", "deformMaterialDamaged":"invis"},
         ["ccf_coolanttopump", ["ccf_radiator","ccf_airbox"]],      
         ["ccf_coolantpump", ["ccf_airbox","ccf_radiator"]],          
         {"deformGroup":""},
    ],
    "mainEngine":{
        "radiatorArea":0.37,
        "radiatorEffectiveness":9000,
        "coolantVolume":8.5,
        "radiatorFanType":"electric",
        "radiatorFanTemperature":90,
        "radiatorFanMaxAirSpeed":2.5,
        "thermostatTemperature":80,
        "radiatorFanLoopEvent": "event:>Vehicle>Cooling Fan>Electric_05",
        "radiatorFanVolume": 1,

        //damage deformGroups
        "deformGroups_radiator":["radiator_damage"],
        },    
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        ["radiatorFanSpin"  , "ccf_fan",     "rad2l","rad1l","rad2r",  {"x":0, "y":0, "z":0}, {"x":0, "y":1, "z":0}    , {"x":0, "y":0, "z":0}, -720, 720, 0, 2],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        //radiator
        {"frictionCoef":0.5},
        {"nodeMaterial":"|NM_METAL"},
        {"selfCollision":false},
        {"collision":true},
        {"group":"ccf_radiator"},
        {"nodeWeight":1.7},
        {"engineGroup":"radiator"},
        {"chemEnergy":200,"burnRate":0.4,"flashPoint":250,"specHeat":0.8,"smokePoint":150,"selfIgnitionCoef":false},
        ["rad1", 0.0, -1.63, 0.568661],
        {"chemEnergy":false,"burnRate":false,"flashPoint":false,"specHeat":false,"smokePoint":false,"selfIgnitionCoef":false},
        ["rad2", 0.0, -1.63, 0.16153],
        {"engineGroup":""},
        //normal nodes
         {"nodeWeight":0.95},
        ["rad1r", -0.33, -1.65, 0.56929],
        ["rad1l", 0.33, -1.65, 0.56929],
        ["rad2r", -0.33, -1.65, 0.16],
        ["rad2l", 0.33, -1.65, 0.16],        
        
        //rigidifier
        {"selfCollision":false},
        {"collision":false},
        {"group":""},
        {"nodeWeight":2.0},
        ["rad3",0.0, -1.506, 0.365],
        {"group":""},
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //to Engine
        {"beamSpring":14000,"beamDamp":300},
        {"beamDeform":1450,"beamStrength":3600},
        {"optional":true},
        //duplicate beams for better flexbody breaking
        ["rad1","e4r"],
        ["rad1","e4l"],
        ["rad1","e4r"],
        ["rad1","e4l"],
        //tube
        ["rad2","e4l"],
        {"optional":false},
        //normal nodes for pazazz          
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":900600,"beamDamp":60},
        {"beamDeform":73535,"beamStrength":"FLT_MAX"},
        ["rad1r","rad1l"],
        ["rad2r","rad2l"],

        ["rad1","rad1l"],
        ["rad1","rad1r"],
        ["rad1","rad2r"],
        ["rad1","rad2l"],
        ["rad2","rad1l"],
        ["rad2","rad1r"],
        ["rad2","rad2r"],
        ["rad2","rad2l"], 

        {"beamDeform":7000,"beamStrength":"FLT_MAX"},
        ["rad1r","rad2l"],
        ["rad2r","rad1l"],
        {"deformGroup":""},        

        //attach
        {"deformGroup":"radiatorhose"}
        {"beamSpring":1101000,"beamDamp":60},
        {"beamDeform":2500,"beamStrength":25000},
        {"breakGroup":"radiator_whole"},   
        {"deformGroup":"radiator_damage","deformationTriggerRatio":0.001},
        ["rad1r","f13r"], 
        ["rad1l","f13l"], 
        ["rad1r","f13l"], 
        ["rad1l","f13r"], 

        ["rad1r","f11r"], 
        ["rad1l","f11l"], 
        ["rad1r","f11l"], 
        ["rad1l","f11r"], 

        ["rad2r","f11r"], 
        ["rad2l","f11l"], 
        ["rad2r","f11l"], 
        ["rad2l","f11r"], 
        {"breakGroup":""},   
        {"deformGroup":""},        

        //rigidifier
        {"beamSpring":1900600,"beamDamp":60},
        {"beamDeform":15000,"beamStrength":"FLT_MAX"},
        ["rad1r","rad3"],  
        ["rad1l","rad3"],  
        ["rad2r","rad3"],  
        ["rad2l","rad3"],  
        ["rad1","rad3"],  
        ["rad2","rad3"],  

        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //front bumper
            {"groundModel":"plastic"},
            {"dragCoef":1},
            {"group":"ccf_radiator"},
            ["rad1r",  "rad2r", "rad2l"],
            ["rad2l",  "rad1l", "rad1r"],
            {"group":""},
    ],
},

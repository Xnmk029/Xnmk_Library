    "information":{
        "authors":"Theo Wilkinson",
        "name":"Limited Slip Rear Differential",
        "value":1900,
    },
    "slotType" : "ccf_differential_R",
    "slots": [
        ["type", "default", "description"],
        ["ccf_driveshaft_R","ccf_driveshaft_R", "Rear Driveshaft"],
        ["ccf_halfshafts_R","ccf_halfshafts_R", "Rear Halfshafts"],
        ["ccf_finaldrive_R","ccf_finaldrive_R_358", "Rear Final Drive", {"coreSlot":true}],

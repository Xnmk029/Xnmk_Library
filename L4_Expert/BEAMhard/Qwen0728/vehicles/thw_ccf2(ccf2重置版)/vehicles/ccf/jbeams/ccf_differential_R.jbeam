        ["type", "name", "inputName", "inputIndex"],
        ["differential", "differential_R", "driveshaft", 1, {"deformGroups":["differential_R"], "diffType":"lsd", "gearRatio": 3.07, "lsdPreload":70, "lsdLockCoef":0.15, "lsdRevLockCoef":0.03, "uiName":"Rear Differential","defaultVirtualInertia":0.25}],
    ],

         {"nodeWeight":20},
         ["rdiff", 0, 1.1192, 0.27903],
         {"nodeWeight":1},
         ["rdifflb", 0.2, 1.1192, 0.27903],
         ["rdiffrb", -0.2, 1.1192, 0.27903],
         {"group":""},

"simple_traffic_ccf_transmission": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"Transmission",
    },
    "slotType" : "simple_traffic_ccf_transmission",
    "gearbox": {
        "uiName":"Gearbox",
        "gearRatios":[-3.55, 0, 3.81, 2.82, 2.15, 1.74, 1.42, 1.06],
        "friction": 1.24,
        "dynamicFriction": 0.0012,
        "torqueLossCoef": 0.0155,
        "parkLockTorque":2000,
        "additionalEngineInertia":0.05,
        "gearboxNode:":["tra1"],

        "gearWhineCoefsInput":  [0.60, 0.00, 0.13, 0.13, 0.13, 0.13, 0.13, 0.13, 0.13, 0.13],
        "gearWhineCoefsOutput": [0.00, 0.00, 0.27, 0.27, 0.27, 0.27, 0.27, 0.27, 0.27, 0.27],,
        "gearWhineInputEvent": "event:>Vehicle>Transmission>helical_01>twine_in_tuned",
        "gearWhineOutputEvent": "event:>Vehicle>Transmission>helical_01>twine_out_tuned",
    },
    "vehicleController": {
        "automaticModes":"PRNDSM",
        "calculateOptimalLoadShiftPoints": true,
        "shiftDownRPMOffsetCoef":1.2,
        //"aggressionSmoothingUp":2
        //"aggressionSmoothingDown":0.06
        "lowShiftDownRPM":[0,0,0,1600,1600,1500,1400,1300,1300],
        "lowShiftUpRPM":[0,0,2800,2600,2400,2200,2000,2000],
        "clutchLaunchStartRPM": 2500,
        "clutchLaunchTargetRPM": 3000,
    },
        "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        ["torqueConverter", "torqueConverter", "mainEngine", 1],
        ["automaticGearbox", "gearbox", "torqueConverter", 1],

        //fwd
        //["differential", "frontDiff", "gearbox", 1, {"diffType":"open", "gearRatio":4.11, "diffTorqueSplit":0.50}],

        //awd
        //["differential", "centreDiff", "gearbox", 1, {"diffType":"open", "gearRatio":1.00, "diffTorqueSplit":1.0}],
        //["shaft",            "frontDriveShaft",      "centreDiff", 1 ],
        //["differential", "frontDiff", "frontDriveShaft", 1, {"diffType":"open", "gearRatio":4.23, "diffTorqueSplit":0.50}],
        //["shaft",            "rearDriveShaft",      "centreDiff", 2 ],
        //["differential", "rearDiff", "rearDriveShaft", 1, {"diffType":"open", "gearRatio":4.23, "diffTorqueSplit":0.50}],


        //rwd
        ["shaft", "driveshaft", "gearbox", 1, {"friction":0, "electricsName":"driveshaft"}],
        ["differential", "rearDiff", "driveshaft", 1, {"diffType":"open", "gearRatio":3.07, "diffTorqueSplit":0.50}],

        ["shaft", "wheelaxleRL", "rearDiff", 1, {"connectedWheel":"RL", "breakTriggerBeam":"axle_RL", "friction":0, "electricsName":"axle_RL"}],
        ["shaft", "wheelaxleRR", "rearDiff", 2, {"connectedWheel":"RR", "breakTriggerBeam":"axle_RR", "friction":0, "electricsName":"axle_RR"}],

        //["shaft", "fixaxleFL", "frontDiff", 1,  {"friction":0}],
        //["shaft", "fixaxleFR", "frontDiff", 2,  {"friction":0}],

        ["shaft", "wheelaxleFL", "fixaxleFL", 1,  {"connectedWheel":"FL", "breakTriggerBeam":"axle_FL", "friction":0, "electricsName":"axle_FL", "visualShaftAVName":"outputAV1"}],
        ["shaft", "wheelaxleFR", "fixaxleFR", 1,  {"connectedWheel":"FR", "breakTriggerBeam":"axle_FR", "friction":0, "electricsName":"axle_FR", "visualShaftAVName":"outputAV1"}],
    ],
},

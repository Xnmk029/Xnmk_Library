{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:benchmark:BilibiliUserscript:report:1",
  "type":"object",
  "required":["schemaVersion","taskId","benchmarkVersion","track","seed","selection","maximumScore","candidate","provenance","environment","score","qualifiedScore","failedGates","verdict","groups","checks","events","requests","rankingEligible"],
  "properties":{
    "schemaVersion":{"const":1},"taskId":{"const":"BilibiliUserscript"},"benchmarkVersion":{"const":"2.0.0"},
    "track":{"enum":["controlled-v2","diagnostic-v1"]},"seed":{"type":"string"},"rankingEligible":{"type":"boolean"},
    "selection":{"type":"object","required":["complete","caseIds"],"properties":{"complete":{"type":"boolean"},"caseIds":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},
    "maximumScore":{"type":"number","minimum":0,"maximum":100},"score":{"type":"number","minimum":0,"maximum":100},
    "qualifiedScore":{"type":["number","null"],"minimum":0,"maximum":100},
    "failedGates":{"type":"array","items":{"enum":["C01","C02","C03","P01"]},"uniqueItems":true},
    "verdict":{"enum":["PASS","STRONG","PARTIAL","FAIL","REJECTED","CALIBRATION"]},
    "candidate":{"type":"object","required":["path","sha256","bytes","metadata"],"properties":{"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"bytes":{"type":"integer","minimum":0},"metadata":{"type":"object"}}},
    "provenance":{"type":"object","required":["promptSha256","contractSha256","originalPromptSha256","fixtureManifestSha256","engineSha256","engineFiles","goldSha256"],"properties":{"contractSha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"}}},
    "environment":{"type":"object","required":["node","platform","osRelease","browserVersion","playwrightVersion"]},
    "groups":{"type":"object","additionalProperties":{"type":"object","required":["earned","maximum"],"properties":{"earned":{"type":"number","minimum":0},"maximum":{"type":"number","minimum":0}}}},
    "checks":{"type":"array","items":{"type":"object","required":["id","group","weight","pass","earned"],"properties":{"id":{"type":"string"},"pass":{"type":"boolean"},"weight":{"type":"number","minimum":0},"earned":{"type":"number","minimum":0}}}},
    "events":{"type":"array"},"requests":{"type":"array"}
  },
  "allOf":[{"if":{"properties":{"selection":{"properties":{"complete":{"const":true}}}}},"then":{"properties":{"maximumScore":{"const":100},"checks":{"minItems":25,"maxItems":25}}}}]
}

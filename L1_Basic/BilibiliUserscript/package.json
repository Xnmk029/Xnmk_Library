{
  "name": "bilibili-userscript-benchmark",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Offline browser replay and behavioral scoring for Bilibili IP-location userscripts",
  "engines": { "node": ">=22" },
  "scripts": {
    "evaluate": "node harness/cli.mjs",
    "calibrate": "node harness/calibrate.mjs",
    "test": "node --test tests/*.test.mjs",
    "gold:build": "node tools/build-gold.mjs",
    "dispatch": "node tools/prepare-run.mjs"
  },
  "devDependencies": {
    "acorn": "8.18.0",
    "playwright-core": "1.63.0"
  }
}

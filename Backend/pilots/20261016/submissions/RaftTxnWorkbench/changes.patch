+		if err != nil {
+			bad(err.Error())
+			return
+		}
+		t, err := parseTransaction(b)
+		if err != nil {
+			bad(err.Error())
+			return
+		}
+		if res, ok := send(command{Kind: "txn", Txn: t}); ok {
+			write(res)
+		}
+		return
+	case "/v1/kv":
+		if r.Method != "GET" {
+			w.WriteHeader(405)
+			return
+		}
+		key := r.URL.Query().Get("key")
+		if key == "" {
+			bad("key required")
+			return
+		}
+		if res, ok := send(command{Kind: "read", Key: key}); ok {
+			write(res)
+		}
+		return
+	}
+	if strings.HasPrefix(r.URL.Path, "/v1/") {
+		http.NotFound(w, r)
+		return
+	}
+	key := r.RequestURI
+	switch r.Method {
+	case "PUT":
+		b, err := body()
+		if err != nil {
+			bad(err.Error())
+			return
+		}
+		v := string(b)
+		t := &Transaction{RequestID: "legacy-" + uniqueToken(), Compare: []Compare{}, Success: []Operation{{Op: "put", Key: key, Value: &v}}}
+		if res, ok := send(command{Kind: "txn", Txn: t}); ok {
+			if res.Code != 200 {
+				write(res)
+				return
+			}
+			w.WriteHeader(204)
+		}
+	case "GET":
+		if res, ok := send(command{Kind: "read", Key: key}); ok {
+			var v ReadResponse
+			if err := json.Unmarshal(res.Body, &v); err != nil {
+				panic(err)
+			}
+			if v.Value == nil {
+				http.NotFound(w, r)
+			} else {
+				_, _ = w.Write([]byte(*v.Value))
+			}
+		}
+	case "POST", "DELETE":
+		id, err := strconv.ParseUint(strings.TrimPrefix(key, "/"), 0, 64)
+		if err != nil || id == 0 || id > maxInteger {
+			bad("invalid node ID")
+			return
+		}
+		cc := raftpb.ConfChange{NodeID: id, Type: raftpb.ConfChangeRemoveNode}
+		if r.Method == "POST" {
+			b, err := body()
+			if err != nil {
+				bad(err.Error())
+				return
+			}
+			cc.Type = raftpb.ConfChangeAddNode
+			cc.Context = b
+		}
+		select {
+		case h.confChangeC <- cc:
+			w.WriteHeader(204)
+		case <-ctx.Done():
+			http.Error(w, "configuration proposal timed out", 504)
+		}
+	default:
+		w.WriteHeader(405)
+	}
+}
+func serveHttpKVAPI(kv *kvstore, port int, confChangeC chan<- raftpb.ConfChange, errorC <-chan error) {
+	srv := http.Server{Addr: ":" + strconv.Itoa(port), Handler: &httpKVAPI{store: kv, confChangeC: confChangeC}, ReadHeaderTimeout: 5 * time.Second}
+	go func() {
+		if err := srv.ListenAndServe(); err != nil {
+			log.Fatal(err)
+		}
+	}()
+	if err, ok := <-errorC; ok {
+		log.Fatal(err)
+	}
+}

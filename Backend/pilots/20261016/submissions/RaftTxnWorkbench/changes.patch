+	if err := gob.NewEncoder(&buf).Encode(kv{k, v}); err != nil {
+		log.Fatal(err)
+	}
+	s.proposeC <- buf.String()
+}
+
+func (s *kvstore) readCommits(commitC <-chan *commit, errorC <-chan error) {
+	for commit := range commitC {
+		if commit == nil {
+			// signaled to load snapshot
+			snapshot, err := s.loadSnapshot()
+			if err != nil {
+				log.Panic(err)
+			}
+			if snapshot != nil {
+				log.Printf("loading snapshot at term %d and index %d", snapshot.Metadata.Term, snapshot.Metadata.Index)
+				if err := s.recoverFromSnapshot(snapshot.Data); err != nil {
+					log.Panic(err)
+				}
+			}
+			continue
+		}
+
+		if commit.snapshot != nil {
+			if err := s.recoverFromSnapshot(commit.snapshot.Data); err != nil {
+				log.Panic(err)
+			}
+			s.mu.Lock()
+			if s.applied != commit.snapshot.Metadata.Index {
+				log.Panic("snapshot payload/index mismatch")
+			}
+			s.mu.Unlock()
+		} else {
+			s.mu.Lock()
+			for _, data := range commit.data {
+				if len(data) > 0 && data[0] == '{' {
+					var c command
+					if err := json.Unmarshal([]byte(data), &c); err != nil {
+						log.Panic(err)
+					}
+					r := s.applyCommand(c)
+					if ch := s.waiters[c.Token]; ch != nil {
+						// A repeated transport proposal must never stall application.
+						select {
+						case ch <- r:
+						default:
+						}
+					}
+				} else {
+					var v kv
+					if err := gob.NewDecoder(bytes.NewBufferString(data)).Decode(&v); err != nil {
+						log.Panic(err)
+					}
+					s.revision++
+					s.kvStore[v.Key] = v.Val
+					s.states[v.Key] = KeyState{&v.Val, s.revision}
+				}
+			}
+			if commit.index > 0 {
+				s.applied = commit.index
+			}
+			s.mu.Unlock()
+		}
+		close(commit.applyDoneC)
+	}
+	if err, ok := <-errorC; ok {
+		log.Fatal(err)
+	}
+}
+
+func (s *kvstore) getSnapshot() ([]byte, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.initialize()
+	return json.Marshal(stateSnapshot{1, s.applied, s.revision, s.states, s.dedup})
+}
+
+func (s *kvstore) loadSnapshot() (*raftpb.Snapshot, error) {
+	snapshot, err := s.snapshotter.Load()
+	if err == snap.ErrNoSnapshot {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	return snapshot, nil
+}
+
+func (s *kvstore) recoverFromSnapshot(snapshot []byte) error {
+	var p stateSnapshot
+	if err := json.Unmarshal(snapshot, &p); err != nil {
+		return err
+	}
+	if err := validateSnapshot(p); err != nil {
+		return err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.states = p.States
+	s.dedup = p.Dedup
+	s.revision = p.Revision
+	s.applied = p.Applied
+	s.kvStore = map[string]string{}
+	for k, v := range s.states {
+		if v.Value != nil {
+			s.kvStore[k] = *v.Value
+		}
+	}
+	s.initialize()
+	return nil
+}

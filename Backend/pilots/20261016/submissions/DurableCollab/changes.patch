+
+```powershell
+# 终端 B，工作目录同一个 repo
+$env:HOST = '127.0.0.1'
+$env:PORT = '1235'
+$env:DB_PATH = Join-Path (Get-Location) 'data/shared.sqlite'
+$env:ROOM_IDLE_MS = '1000'
+node bin/server.cjs

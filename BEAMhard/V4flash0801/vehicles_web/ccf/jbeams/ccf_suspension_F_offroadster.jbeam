{
"ccf_suspension_F_offroadster": {
    "information":{
        "authors":"Theo & Finn Wilkinson",
        "name":"Jacked Up Front Subframe",
        "value":4000,
    },
    "slotType" : "ccf_suspension_F",
    "slots": [
        ["type", "default", "description"],
        //The case() is for backwards compatibility for old configs that use "trackwidth_F" variable.
        //To change the base track width, edit the trackoffset_F offset in the expression.
     //   ["wheel_F_5","ccf_wheel_1a_lj_16x8_F_rework", "Front Wheels", {"nodeOffset":{"x":"$=case($trackwidth_F == nil, $trackoffset_F+0.245, $trackwidth_F)", "y":-1.1994, "z":0.28525}}],
        ["ccf_hub_F_offroadster","ccf_hub_6l_F_offroadster", "Front Hub"],
        ["ccf_wheeldata_F","ccf_wheeldata_F", "Front Spindles", {"coreSlot":true}],
        ["ccf_coilover_F_offroadster","ccf_coilover_F_offroadster", "Front Coilovers"],
        ["ccf_steering_offroadster","ccf_steering_offroadster", "Steering"], 
        ["ccf_hooks","ccf_hooks", "Tow Hooks"],
        ["ccf_swaybar_F_offroadster","ccf_swaybar_F_offroadster", "Front Sway Bar"],
    ],    
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$camber_FR", "range", "", "Wheel Alignment", 1.0005, 0.95, 1.05, "Camber Adjust", "Adjusts the wheel camber angle", {"subCategory":"Front"}],
        ["$caster_FR", "range", "", "Wheel Alignment", 1, 0.985, 1.015, "Caster Adjust", "Adjusts forward rake of the steering axis", {"subCategory":"Front"}],
        ["$trackoffset_F", "range", "+m", "Wheels", 0.0, -0.02, 0.1, "Wheel Offset", "Spacing of the wheel from the hub", {"stepDis":0.001,"subCategory":"Front"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
        ["ccf_subframe_F_offroadster", ["ccf_subframe_F"]],
        ["ccf_lowerarm_F_R_offroadster", ["ccf_lowerarm_F_R"]],
        ["ccf_upperarm_F_R_offroadster", ["ccf_upperarm_F_R"]],

         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"collision":true},
         {"selfCollision":true},
         {"nodeWeight":4.5},
         {"group":["ccf_subframe_F","ccf_lowerarm_F_L","ccf_tierod_F"]},
         //central 'box'
         ["fx1l", 0.38642, -1.2088, 0.0742],
         ["fx2l", 0.38642, -0.8847, 0.1027],
         {"group":["ccf_subframe_F","ccf_lowerarm_F_R","ccf_tierod_F"]},

{
"ccf_differential_F_LSD": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"Limited Slip Front Differential",
        "value":1900,
    },
    "slotType" : "ccf_differential_F",
    "slots": [
        ["type", "default", "description"],
        ["ccf_driveshaft_F","ccf_driveshaft_F", "Front Propshaft"],
        ["ccf_halfshafts_F","ccf_halfshafts_F", "Front Halfshafts"],
        ["ccf_finaldrive_F","ccf_finaldrive_F_358", "Front Final Drive", {"coreSlot":true}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
      //   ["ccf_diff_F", ["ccf_subframe_F","ccf_body"]],
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        ["torsionReactor", "torsionReactorF", "transfercase_F", 1],
        ["differential", "differential_F", "torsionReactorF", 1, {"diffType":"lsd", "gearRatio": 3.07, "lsdPreload":70, "lsdLockCoef":0.15, "lsdRevLockCoef":0.03, "uiName":"Front Differential","defaultVirtualInertia":0.25}],
    ],
    "differential_F": {
        "friction": 3.92,
        "dynamicFriction": 0.00184,
        "torqueLossCoef": 0.03,
    },    
    "torsionReactorF": {
        "torqueReactionNodes:":["fx2l","fx2r","fx1r"],
    },
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--diff weight--
         {"selfCollision":false},
         {"collision":false},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"ccf_diff_F"},
         {"nodeWeight":20},
         ["fdiff", 0, -1.2088, 0.25],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          //differential node
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":4800600,"beamDamp":138},
          {"beamDeform":27000,"beamStrength":"FLT_MAX"},
          {"deformGroup":"differential_F", "deformationTriggerRatio":0.001}
          ["fdiff","fx1r"],
          ["fdiff","fx1l"],
          ["fdiff","fx2r"],
          ["fdiff","fx2l"],
          ["fdiff","fx3r"],
          ["fdiff","fx3l"],
          ["fdiff","fx4r"],
          ["fdiff","fx4l"],
          {"deformGroup":""}
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          {"breakGroup":""},
          {"deformGroup":""},
    ],
},

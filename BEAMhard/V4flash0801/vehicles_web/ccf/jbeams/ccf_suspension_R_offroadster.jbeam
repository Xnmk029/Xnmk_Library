          {"beamDeform":32000,"beamStrength":"FLT_MAX"},
          ["rx1r", "rsf1r"],
          ["rx1l", "rsf1l"],
          ["rx2r", "rsf1r"],
          ["rx2l", "rsf1l"],
          ["rx3r", "rsf1r"],

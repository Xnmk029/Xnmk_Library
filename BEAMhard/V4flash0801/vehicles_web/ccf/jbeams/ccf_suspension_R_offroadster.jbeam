{
"ccf_suspension_R_offroadster": {
    "information":{
        "authors":"Theo & Finn Wilkinson",
        "name":"Jacked Up Rear Subframe",
        "value":4000,
    },
    "slotType" : "ccf_suspension_R",
    "slots": [
        ["type", "default", "description"],
        //The case() is for backwards compatibility for old configs that use "trackwidth_R" variable.
        //To change the base track width, edit the trackoffset_R offset in the expression.
        ["ccf_hub_R_offroadster","ccf_hub_6l_R_offroadster", "Rear Hub"],
        ["ccf_wheeldata_R","ccf_wheeldata_R", "Rear Spindles", {"coreSlot":true}],
        ["ccf_coilover_R_offroadster","ccf_coilover_R_offroadster", "Rear Coilovers"],
        ["ccf_swaybar_R_offroadster","ccf_swaybar_R_offroadster", "Rear Sway Bar"],
    ],    
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$camber_RR", "range", "", "Wheel Alignment", 1, 0.97, 1.03, "Camber Adjust", "Adjusts the wheel camber angle", {"subCategory":"Rear"}],
        ["$toe_RR", "range", "", "Wheel Alignment", 1, 1.02, 0.98, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Rear"}],
        ["$trackoffset_R", "range", "+m", "Wheels", 0.0, -0.02, 0.1, "Wheel Offset", "Spacing of the wheel from the hub", {"stepDis":0.001,"subCategory":"Rear"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
        ["ccf_subframe_R_offroadster", ["ccf_suspension_R"]],
        
        {"deformGroup":"lowerreararmL", "deformMaterialBase":"forreal", "deformMaterialDamaged":"invis"},
        ["ccf_lowerarm_R_L_offroadster", ["ccf_lowerarm_RL"]],
        {"deformGroup":"lowerreararmR", "deformMaterialBase":"forreal", "deformMaterialDamaged":"invis"},
        ["ccf_lowerarm_R_R_offroadster", ["ccf_lowerarm_RR"]],
        {"deformGroup":""},

        ["ccf_upperarm_R_L_offroadster", ["ccf_upperarm_RL"]],
        ["ccf_upperarm_R_R_offroadster", ["ccf_upperarm_RR"]],

        ["ccf_knuckle_RL_offroadster", ["ccf_knuckle_RL"]],
        ["ccf_knuckle_RR_offroadster", ["ccf_knuckle_RR"]],
        
        ["ccf_subframe_mount_RR_offroadster", ["ccf_suspension_R"]],
        ["ccf_subframe_mount_diff_offroadster", ["ccf_suspension_R"]],

    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.5},
        {"collision":true},
        {"selfCollision":true},
        {"nodeWeight":4.5},
        //central 'box'
        {"group":["ccf_suspension_R","ccf_lowerarm_RL"]},
        ["rx1l", 0.42, 1.2964, 0.0827],
        ["rx2l", 0.42, 0.86284, 0.1427],
        {"group":["ccf_suspension_R","ccf_lowerarm_RR"]},
        ["rx1r", -0.42, 1.2964, 0.0827],
        ["rx2r", -0.42, 0.86284, 0.1427],
        {"group":["ccf_suspension_R","ccf_upperarm_RL"]},
        ["rx3l", 0.42, 1.2964, 0.2577],
        {"selfCollision":false},
        ["rx4l", 0.42, 0.97299, 0.2577],
        {"group":["ccf_suspension_R","ccf_upperarm_RR"]},
        {"selfCollision":true},
        ["rx3r", -0.42, 1.2964, 0.2577],
        {"selfCollision":false},
        ["rx4r", -0.42, 0.97299, 0.2577],         
        
        //--REAR INDEPENDENT SUSPENSION--
        {"collision":true},
        {"selfCollision":false},
        //rear hub
        {"nodeWeight":6.5},
        {"group":["ccf_lowerarm_RR","ccf_knuckle_RR"]},
        ["rh1r",-0.6794, 1.1204, 0.1194],
        {"group":["ccf_lowerarm_RL","ccf_knuckle_RL"]},
        ["rh1l", 0.6794, 1.1204, 0.1194],    
        {"nodeWeight":4.75},
        {"selfCollision":false},
        {"group":["ccf_upperarm_RR","ccf_knuckle_RR"]},
        ["rh4r",-0.6794, 1.1204, 0.3087],
        {"group":["ccf_upperarm_RL","ccf_knuckle_RL"]},
        ["rh4l", 0.6794, 1.1204, 0.3087],
        //track bar repurposed from the front steering mount
        {"nodeWeight":3.0},
        {"group":["ccf_hub_RR"]},
        ["rw2r",-0.6794, 1.2846, 0.2137],
        {"group":["ccf_hub_RL"]},
        ["rw2l", 0.6794, 1.2846, 0.2137],
        
        {"group":["ccf_suspension_R"]},
        ["tba1r",-0.42, 1.2846, 0.1827],
        ["tba1l", 0.42, 1.2846, 0.1827],       


        //look at me, I'm the arb mount node now
        {"nodeWeight":2.0},
        {"group":["ccf_shockbottom_R","ccf_swaybar_R"]},
        {"selfCollision":false},
        ["rh2r",-0.5331, 1.1487, 0.1627],
        {"group":["ccf_shockbottom_R","ccf_swaybar_R"]},
        ["rh2l", 0.5331, 1.1487, 0.1627],     
        
        //flexbody nodes purely
        {"nodeWeight":4.5},
       //rear brackets
        {"group":["ccf_suspension_R"]},  
        ["rsf1r", -0.555, 0.59337, 0.0657],
        ["rsf1l",  0.555, 0.59337, 0.0657],
        
        {"group":["ccf_knuckle_RL"]},  
        ["rh5l",  0.637, 0.97, 0.2137],
        {"group":["ccf_knuckle_RR"]},  
        ["rh5r", -0.637, 0.97, 0.2137],
        {"group":""},     

   ],     
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          {"breakGroup":""},
          {"deformGroup":""},      
          {"beamSpring":3001000,"beamDamp":60},
          {"beamDeform":35000,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":1.1},
          //box lengthwise
          ["rx1l", "rx2l"],
          ["rx1r", "rx2r"],
          ["rx1l", "rxarbl"],
          ["rx1r", "rxarbr"],
          ["rxarbl", "rx3l"],

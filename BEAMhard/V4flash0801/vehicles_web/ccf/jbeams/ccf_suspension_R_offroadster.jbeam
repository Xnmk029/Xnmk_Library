"ccf_hub_6l_R_offroadster": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"6 Lug Rear Hubs",
        "value":900,
    },
    "slotType" : "ccf_hub_R_offroadster",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["ccf_hub_6l_RL_offroadster", ["wheel_RL","wheelhub_RL"]],
         ["ccf_hub_6l_RR_offroadster", ["wheel_RR","wheelhub_RR"]],
    ],    
    "slots": [
        ["type", "default", "description"],
        ["wheel_R_6","", "Rear Wheels", {"nodeOffset":{"x":"$=case($trackwidth_R == nil, $trackoffset_R+0.245, $trackwidth_R)", "y":1.11919, "z":0.21375}}],

        ["ccf_brake_R_offroadster","ccf_brake_R_offroadster", "Rear Brakes"],  
    ],  
},
"ccf_coilover_R_offroadster": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"Off-Roadster Rear Coilovers",
        "value":900,
    },
    "slotType" : "ccf_coilover_R_offroadster",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["ccf_coilover_R_offroadster", ["ccf_shockbottom_R","ccf_shocktop_R"]],
    ],
    "beams": [
          ["id1:", "id2:"],
          //rear springs
          {"beamPrecompression":1, "beamType":"|NORMAL"},
          {"beamDeform":350000,"beamStrength":200000},
          {"beamSpring":5500,"beamDamp":0},
          //MR 0.65
          ["rh4r","rs1r", {"name":"spring_RR", "precompressionRange":0.7,"soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.5,"attackFactor":10,"volumeFactor":1.3,"decayFactor":6,"noiseFactor":0.01,"pitchFactor":0.2,"maxStress":2900}],
          ["rh4l","rs1l", {"name":"spring_RL", "precompressionRange":0.7,"soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.5,"attackFactor":10,"volumeFactor":1.3,"decayFactor":6,"noiseFactor":0.01,"pitchFactor":0.2,"maxStress":2900}],
          //damper
          //MR 0.8
          {"beamPrecompression":1.0, "beamType":"|BOUNDED","beamLongBound":1, "beamShortBound":1},
          {"beamSpring":0,"beamDamp":4000},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          ["rh4r","rs1r", {"name":"damper_RR","beamDampFast":2300,"beamDampRebound":4400,"beamDampReboundFast":1500,"beamDampVelocitySplit":0.08,"dampCutoffHz":500}],
          ["rh4l","rs1l", {"name":"damper_RL","beamDampFast":2300,"beamDampRebound":4400,"beamDampReboundFast":1500,"beamDampVelocitySplit":0.08,"dampCutoffHz":500}],

        //soft bump stop
        {"beamSpring":0,"beamDamp":0},
        {"beamLimitSpring":0,"beamLimitDamp":12000},
        ["rh4r","rs1r", {"longBoundRange":0.08,"shortBoundRange":0.01,"boundZone":0.02,"beamLimitDampRebound":1000,"dampCutoffHz":500}],
        ["rh4l","rs1l", {"longBoundRange":0.08,"shortBoundRange":0.01,"boundZone":0.02,"beamLimitDampRebound":1000,"dampCutoffHz":500}],
        //hard bump stop
        {"beamSpring":0,"beamDamp":0},
        {"beamLimitSpring":501000,"beamLimitDamp":10000},
        ["rh4r","rs1r", {"longBoundRange":0.09,"shortBoundRange":0.04,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
        ["rh4l","rs1l", {"longBoundRange":0.09,"shortBoundRange":0.04,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          {"breakGroup":""},
          {"deformGroup":""},
    ],
},
"ccf_swaybar_R_offroadster": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"Disconnectable Rear Sway Bar",
        "value":200,
    },
    "slotType" : "ccf_swaybar_R_offroadster",

    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["ccf_swaybar_R_offroadster", ["ccf_swaybar_R"]],
        ["ccf_swaybar_R_links_offroadster", ["ccf_swaybar_R"]],
    ],
    "controller": [
        ["fileName"],
        ["drivingDynamics/actuators/adaptiveTorsionBars" {"name":"adaptiveRearSwayBar", "torsionBarNames":["torsionBarRear"]}]
    ],
    "adaptiveRearSwayBar": {
        "modes": [
            ["name",    "springCoef", "dampCoef"]
            ["regular", 1,            1]
            ["off",    0,        1] //29mm
        ]
    },
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //anti-roll
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"ccf_swaybar_R"},
         {"selfCollision":false},
         {"collision":true},
         {"nodeWeight":2.0},
        //arb mounts on the subframe
        ["rxarbl", -0.41, 1.36, 0.2027],
        ["rxarbr",  0.41, 1.36, 0.2027],

         //ARB ends
        ["arbrl", 0.537126, 1.1487, 0.2327],
        ["arbrr", -0.537126,1.1487, 0.2327],
         {"group":""},
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        {"spring":4920, "damp":10, "deform":10000, "strength":9999999},
        ["arbrr", "rxarbr", "rxarbl", "arbrl", {"name": "torsionBarRear"}],
    ],
    "beams": [
          ["id1:", "id2:"],
          //--ANTI-ROLL--
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          {"breakGroup":""},
          {"deformGroup":""},
          {"beamSpring":2001000,"beamDamp":100},
          {"beamDeform":155000,"beamStrength":350000},
          //ARB main beams
          ["arbrr","rxarbr"],
          ["rxarbl","rxarbr"],
          ["arbrl","rxarbl"],
          ["arbrl","rxarbr"],
          ["arbrr","rxarbl"],
          
        //linkets

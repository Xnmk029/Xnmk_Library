        ["sf2rr", "sf1r"],
        ["sf2r", "sf3rr"],
        ["sf3r", "sf2rr"],
        ["sf4r", "sf3rr"],
        ["sf3r", "sf4rr"],
        //corners
        {"beamDeform":3000},
        ["sf3r", "sf1r"],
        ["sf3rr", "sf1rr"],
        ["sf2r", "sf4r"],
        ["sf2rr", "sf4rr"],

        ["sf4rr", "sf1rr"],

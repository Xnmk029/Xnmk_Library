"ccf_centraltray_country": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"Country Powertrain Control",
        "value":150,
    },
    "slotType" : "ccf_centraltray", 
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["ccf_centraltray_country", ["ccf_body","ccf_dash","ccf_bootfloor"]],
    ],    
    "triggerEventLinks":[
        ["triggerId:triggers", "action", "targetEventId:events"],
        ["modeRangeBox", "action0", "modeRangeBox"],
        ["mode4WD", "action0", "mode4WD"],
        ["diffLockR", "action0", "diffLockR"],
        ["diffLockM", "action0", "diffLockM"],
        ["diffLockF", "action0", "diffLockF"],
    ],
    "events":[
        ["id", "title", "desc"],
        ["modeRangeBox", "", "", {"onDown": "for _,v in pairs(controller.getControllersByType('4wd')) do v.toggleRange() end", "order": 1}],
        ["mode4WD", "", "", {"onDown": "if electrics.values.mode4WD == 1 then powertrain.getDevice('transfercase_F'):setMode('disconnected') else powertrain.getDevice('transfercase_F'):setMode('connected') end", "order": 1}],

        ["diffLockR", "", "", {"onDown":"if electrics.values.diffLockR == 1 then powertrain.getDevice('differential_R'):setMode('lsd') else powertrain.getDevice('differential_R'):setMode('locked') end", "order": 1}],
        ["diffLockM", "", "", {"onDown": "if electrics.values.diffLockM == 1 then powertrain.getDevice('transfercase'):setMode('lsd') else powertrain.getDevice('transfercase'):setMode('locked') end", "order": 1}],
        ["diffLockF", "", "", {"onDown": "if electrics.values.diffLockF == 1 then powertrain.getDevice('differential_F'):setMode('lsd') else powertrain.getDevice('differential_F'):setMode('locked') end", "order": 1}],
   ],   
    "triggers":[
        ["id", "label", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["modeRangeBox","", "int1","int1r","intb2",    "box", {"x":0.015, "y":0.015, "z":0.015}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":-0.0565, "y":0.185, "z":0.362}],
        ["mode4WD","", "int1","int1r","intb2",    "box", {"x":0.015, "y":0.015, "z":0.015}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":-0.0415, "y":0.185, "z":0.358}],

        ["diffLockR","", "int1","int1r","intb2",    "box", {"x":0.015, "y":0.015, "z":0.015}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":-0.0715, "y":0.19, "z":0.384}],
        ["diffLockM","", "int1","int1r","intb2",    "box", {"x":0.015, "y":0.015, "z":0.015}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":-0.0565, "y":0.19, "z":0.382}],
        ["diffLockF","", "int1","int1r","intb2",    "box", {"x":0.015, "y":0.015, "z":0.015}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":-0.0415, "y":0.19, "z":0.380}],
    ],
    "glowMap":{
            //COUNTRY (top left to bottom right buttons)
            "ccf_antirollbarofflight":{"simpleFunction":{"adaptiveSwayBar":1}, "off":"ccf_interiorbuttons_on", "on":"ccf_interior"},
            "ccf_antirollbaronlight":{"simpleFunction":{"adaptiveSwayBar":1}, "off":"ccf_interior", "on":"ccf_interiorbuttons_on"},

            "ccf_rangeboxlowlight":{"simpleFunction":{"modeRangeBox":1}, "off":"ccf_interior", "on":"ccf_interiorbuttons_on"},
            "ccf_rangeboxhighlight":{"simpleFunction":{"modeRangeBox":1}, "off":"ccf_interiorbuttons_on", "on":"ccf_interior"},

            "ccf_rwdlight":{"simpleFunction":{"mode4WD":1}, "off":"ccf_interiorbuttons_on", "on":"ccf_interior"},

        //attach
        {"beamSpring":182000,"beamDamp":37.6},
        {"beamDeform":55000,"beamStrength":240000},
        {"deformGroup":"seatbelt_R", "deformationTriggerRatio":0.04},
        ["sf1r", "f4l"],

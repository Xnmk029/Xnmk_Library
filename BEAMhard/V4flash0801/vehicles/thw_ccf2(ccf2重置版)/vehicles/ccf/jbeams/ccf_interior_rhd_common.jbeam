    "events":[
        ["id", "title", "desc"],
        ["hazard_light", "", "", {"onDown"  :"electrics.toggle_warn_signal()"}],
        ["parkingsensorsoff", "", "", {"onDown"  :"electrics.values.parkingSensorsEnabled = 1-(electrics.values.parkingSensorsEnabled or 0)"}],
        ["escmodecycle", "", ""{"onDown"  :"if controller.getController('driveModes') then controller.getController('driveModes').nextDriveMode() else controller.getControllerSafe('esc').toggleESCMode() end"}],
        ["ignition", "", "", {"onDown"  :"electrics.toggleIgnitionLevelOnDown()","onUp"  :"electrics.toggleIgnitionLevelOnUp()"}],
    ],   
    "triggers":[
        ["id", "label", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],

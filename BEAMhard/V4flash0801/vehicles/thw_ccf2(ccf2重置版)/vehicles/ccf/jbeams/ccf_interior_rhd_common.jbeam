        ["LightOff", "event:>Vehicle>Interior>Light>POL_Light_On"],
        //soundscape_handbrake2
        {"node:":"int1"},
        ["handbrakeEngaging","event:>Vehicle>Interior>Handbrake_Ratchet>Ratchet_08_Ratchet"],
        ["handbrakeDisengaging","event:>Vehicle>Interior>Handbrake_Ratchet>Ratchet_08_Button"],
        ["handbrakeDisengaged","event:>Vehicle>Interior>Handbrake_Ratchet>Ratchet_08_Thump"],
        //affects horn location because horn soundscape is loaded after
        {"node:":"f15"},
    ],
    "slots": [
        ["type", "default", "description"],
        //interior
        ["ccf_shifter","ccf_shifter_M", "Shifter", {"coreSlot":true}],
        ["skin_interior","ccf_skin_interior_black", "Interior Colour", {"coreSlot":true}],
        ["ccf_gaugecluster","ccf_gaugecluster", "Gauge Cluster", {"coreSlot":true}],
        ["ccf_handbrake","ccf_handbrake", "Handbrake", {"coreSlot":true}],
        ["ccf_centraltray","ccf_centraltray", "Central Tray", {"coreSlot":true}],
        ["ccf_screen","ccf_screen", "Centre Screen", {"coreSlot":true}],
        ["ccf_steer","ccf_steer", "Steering Wheel"],
        ["ccf_stalks","ccf_stalks_ukdm", "Stalks"],
        ["ccf_dashbadge","ccf_dashbadgeccf2", "Dashboard Badge"],
        ["ccf_interior_accessory","", "Interior Accessories"],

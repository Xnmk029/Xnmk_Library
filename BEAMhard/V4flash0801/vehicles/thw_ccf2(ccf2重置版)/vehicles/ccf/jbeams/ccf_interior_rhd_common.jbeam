"ccf_gaugecluster": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"Gauge Cluster",
        "value":50,
    },
    "slotType" : "ccf_gaugecluster", 
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        {"deformGroup":"dashboard_break", "deformMaterialBase":"ccf_gauges", "deformMaterialDamaged":"ccf_gauges"},
        ["ccf_gaugecluster", ["ccf_body","ccf_dash","ccf_bootfloor"]],
        {"deformGroup":""},
    ],    
    "slots": [
        ["type", "default", "description"],
        ["ccf_tachometer","ccf_tachometer", "Tachometer", {"coreSlot":true}],
        ["ccf_gaugeglass","ccf_gaugeglass", "Gauge Glass"],
        ["ccf_gaugescreens","ccf_gaugescreens", "Gauge Cluster Screens", {"coreSlot":true}],
    ],    
    "controller": [
        ["fileName"],
        ["shiftLights"],
    ],
    "shiftLights": {
        "engineName":"mainEngine",
        "maxEngineRPMOffset": 300,
        "rpmRange": 400,
        "outputElectrics": ["shiftup"],
        "flashingOutputElectrics": ["shiftup"],
    },
    "glowMap":{
        "ccf_gauges_baked":{"simpleFunction":{"ignitionLevel":0.5}, "off":"ccf_gauges", "on":"ccf_gauges_dim", "on_intense":"ccf_gauges_dim"},
        //extra theo custom gauge lights (based on my sunburst facelift)
        "ccf_deadbatterylight":{"simpleFunction":"battery", "off":"invis", "on":"decals_gauges"},
        "ccf_readylight":      {"simpleFunction":"engineRunning", "off":"invis", "on":"ccf_thw_extra_decals_gauges"},
        "ccf_oilpanlight":     {"simpleFunction":"oilPanLeak", "off":"invis", "on":"ccf_thw_decals_gauges"},
        "ccf_warninglight":    {"simpleFunction":"generalWarning", "off":"invis", "on":"ccf_thw_decals_gauges"},
        "ccf_abslight":    {"simpleFunction":"abs", "off":"invis", "on":"ccf_thw_extra_decals_gauges"},
        "ccf_brakefadelight":  {"simpleFunction":"brakeFade", "off":"invis", "on":"ccf_thw_extra_decals_gauges"},
        "ccf_indicator_L":     {"simpleFunction":"signal_L", "off":"invis", "on":"ccf_thw_decals_gauges"},
        "ccf_indicator_R":     {"simpleFunction":"signal_R", "off":"invis", "on":"ccf_thw_decals_gauges"},
        "ccf_shiftup":         {"simpleFunction":{"shiftup":1}, "off":"invis", "on":"ccf_gaugeshiftup", "on_intense":"ccf_gaugeshiftup"},
    }
},

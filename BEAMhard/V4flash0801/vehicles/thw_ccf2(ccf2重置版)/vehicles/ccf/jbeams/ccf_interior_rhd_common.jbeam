        ["escmodecycle","", "int1","int1r","intb2",    "box", {"x":0.03, "y":0.03, "z":0.03}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.0595, "y":0.16, "z":0.249}],
        ["ignition","", "int1","int1r","intb2",    "box", {"x":0.04, "y":0.04, "z":0.04}, {"x":-30, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.202, "y":0.035, "z":-0.035}],

"ccf_race_seat_FL": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"Left Bucket Seat",
        "value":1100,
    },
    "slotType" : "ccf_seat_L",
    "slots": [
        ["type", "default", "description"],
        ["skin_race_seat_FL","skin_race_seat_FL_gray", "Seat Color", {"coreSlot":true}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["ccf_racingseat_L" ["ccf_seat_FL"],[]],
         {"deformGroup":"seatbelt_L", "deformMaterialBase":"ccf_intcarpet", "deformMaterialDamaged":"invis"},
         ["ccf_seatbelt_L_raceseat", ["ccf_seat_FL"],[],{"pos":{"x":0,"y":0,"z":0}}],         
         {"deformGroup":""},
         ["ccf_seatbeltsocket_L", ["ccf_seat_FL"],[],{"pos":{"x":0,"y":0,"z":0}}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"collision":true},
         {"selfCollision":false},
         {"nodeWeight":15},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         //seats flexbody
         {"group":"ccf_seat_FL"},
         {"collision":true},
         {"selfCollision":true},
         {"nodeWeight":1.0},
         {"selfCollision":false},
         ["sf1l", 0.13076, 0.051, 0.472],
         ["sf1ll", 0.595898, 0.051, 0.472],
         ["sf2l", 0.13076, 0.439, 0.472],
         ["sf2ll", 0.595898, 0.439, 0.472],
         {"selfCollision":true},
         ["sf3l", 0.160322, 0.63, 0.65],
         ["sf3ll", 0.566336, 0.63, 0.65],
         {"collision":false},
         ["sf4l", 0.281115, 0.65, 1.08],
         ["sf4ll", 0.445543, 0.65, 1.08],
         {"group":""},
    ],
    "beams":[
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //main shape
        {"beamSpring":1501000,"beamDamp":200},
        {"beamDeform":50000,"beamStrength":"FLT_MAX"},
        {"deformLimitExpansion":1.1},
        ["sf1l", "sf1ll"],
        ["sf2l", "sf2ll"],
        ["sf3l", "sf3ll"],
        ["sf4l", "sf4ll"],

        ["sf2ll", "sf3ll"],
        ["sf3ll", "sf4ll"],
        //crossing
        {"beamDeform":40000,"beamStrength":"FLT_MAX"},
        {"deformLimitExpansion":""},
        ["sf1ll", "sf2l"],
        ["sf2ll", "sf1l"],
        ["sf2l", "sf3ll"],
        ["sf3l", "sf2ll"],
        ["sf4l", "sf3ll"],
        ["sf3l", "sf4ll"],
        //corners
        {"beamDeform":3000},
        ["sf3l", "sf1l"],
        ["sf3ll", "sf1ll"],
        ["sf2l", "sf4l"],
        ["sf2ll", "sf4ll"],

        ["sf4ll", "sf1ll"],
        ["sf4l", "sf1l"],
        ["sf4l", "sf1ll"],
        ["sf4ll", "sf1l"],

        //attach
        {"beamSpring":182000,"beamDamp":37.6},
        {"beamDeform":55000,"beamStrength":"FLT_MAX"},
        {"deformGroup":"seatbelt_L", "deformationTriggerRatio":0.04},
        ["sf1l", "f4r"],

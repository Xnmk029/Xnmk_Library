"ccf_mirror_L": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"Left Mirror",
        "value":350,
    },
    "slotType" : "ccf_mirror_L",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["ccf_wingmirror_L", ["ccf_mirror_L"]],
         {"deformGroup":"mirrorsignal_L_break", "deformMaterialBase":"ccf_mirror_L", "deformMaterialDamaged":"ccf_mirror_L_dmg"},
         ["ccf_wingmirror_L_glass", ["ccf_mirror_L"]],         
         {"deformGroup":""},
         ["ccf_mirrorstand_L", ["ccf_door_L"]],
         {"deformGroup":"mirrorsignal_L_break", "deformMaterialBase":"ccf_lights", "deformMaterialDamaged":"ccf_lights"},
         ["ccf_wingmirror_L_indicator", ["ccf_mirror_L"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>glassbreaksound2", "deformVolume":0.2}],
         {"deformGroup":""},
    ],
 /*   "mirrors": [
        ["mesh", "idRef:", "id1:", "id2:"],
        ["ccf_wingmirror_L_glass","mi4l","mi3l","mi2l",{"refBaseTranslation":{"x":-0.089,"y":-0.045,"z":0.058},"baseRotationGlobal":{"x":2.3,"y":0,"z":-11.8},"offsetRotationGlobal":{"x":-11.7,"y":0.0,"z":-7.9}}],
   ],*/
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--MIRROR--
         {"collision":true},
         {"selfCollision":true},
         {"nodeWeight":0.3},
         {"frictionCoef":1},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"group":"ccf_mirror_L"},
         ["mi1l",0.7876, -0.012, 0.92],
         ["mi2l",0.966, 0.04226, 0.92],
         ["mi3l",0.787, -0.012, 0.806],
         ["mi4l",0.966, 0.04226, 0.806],
         ["mi5l",0.877, -0.10, 0.86],
         {"collision":false},
         {"selfCollision":false},
         {"group":""},
         ["mi6l", 0.786, -0.098, 0.751],
         ["mi7l", 0.756, -0.098, 0.792],
    ],
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        {
            "lightInnerAngle":0,
            "lightOuterAngle":120,
            "lightRange":8,
            "lightColor":{"r":255, "g":255, "b":0, "a":255},
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":false,
            "cookieName":"art/special/BNG_light_cookie_headlight.dds",
            "flareName":"vehicleBrakeLightFlare",
        },
        ["signal_L" ,         "SPOTLIGHT"        , "mi4l", "mi3l", "mi2l", {"x":-30, "y":0, "z":80} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.35, "y":0.15, "z":0.06},"flareScale":0,"lightBrightness":0.05,"deformGroup":"mirrorsignal_L_break"}],
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          //--MIRRORS--
          {"deformGroup":"mirrorsignal_L_break", "deformationTriggerRatio":0.01},
          {"beamSpring":401000,"beamDamp":25},
          {"beamDeform":4000,"beamStrength":62500},
          //mirror
          {"deformLimitExpansion":1.1},
          //l
          ["mi1l","mi2l"],
          ["mi1l","mi3l"],
          ["mi1l","mi4l"],
          ["mi1l","mi5l"],
          ["mi2l","mi3l"],
          ["mi2l","mi4l"],
          ["mi2l","mi5l"],
          ["mi3l","mi4l"],
          ["mi3l","mi5l"],
          ["mi4l","mi5l"],

          //attach
          {"deformLimitExpansion":""},
          {"beamDeform":3000,"beamStrength":7000},
          {"breakGroup":"mirror_L"},
          ["mi1l","mi7l"],
          ["mi2l","mi7l"],
          ["mi3l","mi7l"],
          ["mi4l","mi7l"],
          ["mi5l","mi7l"],

          ["mi1l","mi6l"],
          ["mi2l","mi6l"],
          ["mi3l","mi6l"],
          ["mi4l","mi6l"],
          ["mi5l","mi6l"],

          {"beamDeform":2000,"beamStrength":3000},
          {"beamSpring":101000,"beamDamp":120},
          {"breakGroupType":1},
          ["mi2l","d8l"],
          ["mi4l","d8l"],
          ["mi4l","d4l"],
          ["mi5l","d7l"],
          ["mi5l","d4l"],
          ["mi3l","d8l"],
          ["mi3l","d4l"],

          ["mi3l","d5l"],
          ["mi5l","d5l"],

       /*   ["mi1l","d7l"],
          ["mi2l","d7l"],
          ["mi3l","d7l"],
          ["mi4l","d7l"],
          ["mi5l","d7l"],
          ["mi4l","d4l"],*/
          {"breakGroupType":0},
          {"breakGroup":""},

          {"beamSpring":601000,"beamDamp":30},
          {"beamDeform":7000,"beamStrength":"FLT_MAX"},
          ["mi6l","mi7l"],
          ["mi6l","d4l"],
          ["mi7l","d4l"],
          ["mi6l","d7l"],
          ["mi7l","d7l"],

          ["mi6l","d8l"],
          ["mi7l","d8l"],
          ["mi6l","d5l"],
          ["mi7l","d5l"],
          ["mi6l","d14l"],
          ["mi7l","d14l"],
          {"deformGroup":""},
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.1},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            //left mirror
            {"groundModel":"plastic"},
            {"dragCoef":35},
            {"group":"ccf_mirror_L"},
            ["mi1l","mi2l","mi3l"],
            ["mi3l","mi2l","mi4l"],

            ["mi2l","mi1l","mi5l"],
            ["mi4l","mi2l","mi5l"],
            ["mi3l","mi4l","mi5l"],

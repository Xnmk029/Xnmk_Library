{
    "ccf_skin_interior_black_lhd": {
        "information":{
            "authors":"Theo Wilkinson",
            "name":"Obsidian Black & Leather",
            "value":100
        },
        "slotType" : "skin_interior_lhd",
        "skinName" : "black",    
        "flexbodies": [
            ["mesh", "[group]:", "nonFlexMaterials"],
            {"deformGroup":"dashboard_break", "deformMaterialBase":"ccf_interior.skin_interior.black", "deformMaterialDamaged":"ccf_interior.skin_interior.black"},
            ["ccf_dashboard_lhd", ["ccf_body","ccf_dash","ccf_bootfloor"]],
            {"deformGroup":""},
        ],
        "glowMap":{
                "ccf_interiorbuttons":{"simpleFunction":{"ignitionLevel":0.5}, "off":"ccf_interior", "on":"ccf_interiorbuttons_on", "on_intense":"ccf_interiorbuttons_on"},
                "ccf_interior":{"simpleFunction":{"ignitionLevel":0.5}, "off":"ccf_interior", "on":"ccf_interior", "on_intense":"ccf_interior_on"},
                "ccf_intcarpet":{"simpleFunction":{"ignitionLevel":0.5}, "off":"ccf_intcarpet", "on":"ccf_intcarpet_on", "on_intense":"ccf_intcarpet_on"},
        }
    },

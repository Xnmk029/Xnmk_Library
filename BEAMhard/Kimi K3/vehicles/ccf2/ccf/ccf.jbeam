{
"ccf": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"Hirochi CCF"
    },
    "slotType" : "main",
    "slots": [
        ["type", "default", "description"],
        ["paint_design", "", "Paint Design"],
        ["licenseplate_design_2_1","","License Plate Design"],
        ["ccf_body", "ccf_body", "Body", {"coreSlot":true}],
        ["ccf_mod", "", "Additional Modification"]
    ],
    "scalenodeWeight":0.8,
    "scalebeamSpring":0.78,
    "scalebeamDamp":0.78,
    "scalebeamDeform":1.0,
    "scalebeamStrength":1.0,
    "scaledragCoef":1.6,
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$brakestrength", "range", "", "Brakes", 1, 0.6, 1.0, "Brake Force Multiplier", "Scales the overall brake torque for this setup", {"minDis":60, "maxDis":100}],
        ["$ffbstrength", "range", "", "Chassis", 1, 0.5, 1.5, "Setup-Specific Force Feedback Multiplier", "Scales the force feedback strength for THIS SETUP ONLY", {"minDis":50, "maxDis":150}]
    ],
    "glowMap":{
            "ccf_signal_L":{"simpleFunction":{"signal_L":0.49}, "off":"ccf_lights", "on":"ccf_lights_on_yellow"},
            "ccf_signal_R":{"simpleFunction":{"signal_R":0.49},"off":"ccf_lights", "on":"ccf_lights_on_yellow"},
            "ccf_rearlight":{"simpleFunction":{"brakelights":10}, "off":"ccf_lights", "on":"ccf_lights_on_red", "on_intense":"ccf_lights_on_red_intense"},
            "ccf_drl":{"simpleFunction":{"engineRunning":0.49}, "off":"ccf_lights", "on":"ccf_lights_on_intense"},
            "ccf_drlbumper":{"simpleFunction":{"engineRunning":0.49}, "off":"ccf_main", "on":"ccf_main_on"},
            "ccf_drl2":{"simpleFunction":{"engineRunning":0.49,"lowhighbeam":1}, "off":"ccf_lights", "on":"ccf_lights_on_intense", "on_intense":"ccf_lights_on_red"},
            "ccf_reflectors":{"simpleFunction":{"lowhighbeam":1}, "off":"ccf_lights", "on":"ccf_lights_on_red"},
            "ccf_drlsignal_L":{"simpleFunction":{"signal_left_input":-1,"engineRunning":0.49,"signal_L": 2}, "off":"ccf_lights", "on":"ccf_lights_on_intense", "on_intense":"ccf_lights_on_yellow"},
            "ccf_drlsignal_R":{"simpleFunction":{"signal_right_input":-1,"engineRunning":0.49,"signal_R": 2}, "off":"ccf_lights", "on":"ccf_lights_on_intense", "on_intense":"ccf_lights_on_yellow"},
            "ccf_runninglight":{"simpleFunction":{"engineRunning":0.49}, "off":"ccf_lights", "on":"ccf_lights_on"},
            "ccf_highbeam":{"simpleFunction":{"highbeam_moveupanim":1}, "off":"ccf_lights", "on":"ccf_lights_on_intense_headlight"},
            "ccf_lowbea":{"simpleFunction":{"lowbeam":0.49,"highbeam":1}, "off":"ccf_lights", "on":"ccf_lights_on_intense_headlight"},
            "ccf_numberplatelight":{"simpleFunction":{"lowhighbeam":1}, "off":"ccf_lights", "on":"ccf_lights_on_intense_headlight"},
            "ccf_highbeam_glass":{"simpleFunction":{"highbeam_moveupanim":1}, "off":"ccf_glass", "on":"ccf_glass_on"},
            "ccf_lowbeam_glass":{"simpleFunction":{"lowbeam":0.49,"highbeam":1}, "off":"ccf_glass", "on":"ccf_glass_on"},
            "ccf_highbeamemit":{"simpleFunction":{"highbeam_moveupanim":1}, "off":"ccf_lights", "on":"ccf_lights_on_pbr"},

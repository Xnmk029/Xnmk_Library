},
"ccf_coilover_R_ca": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"Country Rear Coilovers",
        "value":900,
    },
    "slotType" : "ccf_coilover_R",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["ccf_coilover_R_yellow", ["ccf_shockbottom_R","ccf_shocktop_R"]],
    ],    
    "controller": [
        ["fileName"],
        ["drivingDynamics/actuators/adaptiveDampers" {"name":"adaptiveRearDamper", "dampBeamNames":["damper_RR", "damper_RL"]}]
    ],
    "adaptiveRearDamper": {
        "modes": [
            ["name",    "beamDampCoef", "beamDampFastCoef", "beamDampReboundCoef", "beamDampReboundFastCoef","beamDampVelocitySplitCoef",    "beamSpringCoef"]
            ["nonexistent",    0.15,           1,                  0.2,                   1,                        0.3,              1]
            ["soft",    0.65,           1,                  0.6,                   1,                        0.7,              1]
            ["regular", 1,              1,                  1,                     1,                        1,              1]
            ["hard", 1.5,              1,                  1.6,                     1,                        1.6,              1.6]
        ]
    },
    "beams": [
          ["id1:", "id2:"],
          //rear springs
          {"beamPrecompression":1, "beamType":"|NORMAL"},
          {"beamDeform":30000,"beamStrength":40000},
          {"beamSpring":15000,"beamDamp":0},
          //MR 0.65
          ["rh4r","rs1r", {"name":"spring_RR", "precompressionRange":0.3,"soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.5,"attackFactor":10,"volumeFactor":1.3,"decayFactor":6,"noiseFactor":0.01,"pitchFactor":0.2,"maxStress":2900}],
          ["rh4l","rs1l", {"name":"spring_RL", "precompressionRange":0.3,"soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.5,"attackFactor":10,"volumeFactor":1.3,"decayFactor":6,"noiseFactor":0.01,"pitchFactor":0.2,"maxStress":2900}],
          //damper
          //MR 0.8
          {"beamPrecompression":1.0, "beamType":"|BOUNDED","beamLongBound":1, "beamShortBound":1},
          {"beamSpring":0,"beamDamp":3000},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          ["rh4r","rs1r", {"name":"damper_RR","beamDampFast":2300,"beamDampRebound":4400,"beamDampReboundFast":1500,"beamDampVelocitySplit":0.08,"dampCutoffHz":500}],
          ["rh4l","rs1l", {"name":"damper_RL","beamDampFast":2300,"beamDampRebound":4400,"beamDampReboundFast":1500,"beamDampVelocitySplit":0.08,"dampCutoffHz":500}],
          //soft bump stop
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":35000,"beamLimitDamp":2000},
          ["rh4r","rs1r", {"longBoundRange":0.06,"shortBoundRange":0.035,"boundZone":0.05,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["rh4l","rs1l", {"longBoundRange":0.06,"shortBoundRange":0.035,"boundZone":0.05,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          //hard bump stop
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":201000,"beamLimitDamp":10000},
          ["rh4r","rs1r", {"longBoundRange":0.07,"shortBoundRange":0.05,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["rh4l","rs1l", {"longBoundRange":0.07,"shortBoundRange":0.05,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          {"breakGroup":""},
          {"deformGroup":""},
    ],
},

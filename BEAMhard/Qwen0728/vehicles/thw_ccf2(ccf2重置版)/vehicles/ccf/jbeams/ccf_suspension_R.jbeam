{
"ccf_suspension_R": {
    "information":{
        "authors":"Theo & Finn Wilkinson",
        "name":"Rear Subframe",
        "value":4000,
    },
    "slotType" : "ccf_suspension_R",
    "slots": [
        ["type", "default", "description"],
        //The case() is for backwards compatibility for old configs that use "trackwidth_R" variable.
        //To change the base track width, edit the trackoffset_R offset in the expression.
        ["ccf_hub_R","ccf_hub_5l_R", "Rear Hub"],
        ["ccf_wheeldata_R","ccf_wheeldata_R", "Rear Spindles", {"coreSlot":true}],
        ["ccf_coilover_R","ccf_coilover_R", "Rear Coilovers"],
        ["ccf_swaybar_R","ccf_swaybar_R", "Rear Sway Bar"],
        ["ccf_shielding_R","ccf_shielding_R", "Shielding"],
    ],    
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$camber_RR", "range", "", "Wheel Alignment", 1, 0.95, 1.05, "Camber Adjust", "Adjusts the wheel camber angle", {"subCategory":"Rear"}],
        ["$toe_RR", "range", "", "Wheel Alignment", 1, 1.02, 0.98, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Rear"}],
        ["$trackoffset_R", "range", "+m", "Wheels", 0.0, -0.02, 0.1, "Wheel Offset", "Spacing of the wheel from the hub", {"stepDis":0.001,"subCategory":"Rear"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
        ["ccf_subframe_R", ["ccf_suspension_R"]],
        
        {"deformGroup":"lowerreararmL", "deformMaterialBase":"forreal", "deformMaterialDamaged":"invis"},
        ["ccf_lowerarm_R_L", ["ccf_lowerarm_RL"]],
        {"deformGroup":"lowerreararmR", "deformMaterialBase":"forreal", "deformMaterialDamaged":"invis"},
        ["ccf_lowerarm_R_R", ["ccf_lowerarm_RR"]],
        {"deformGroup":""},

        ["ccf_upperarm_R_L", ["ccf_upperarm_RL"]],
        ["ccf_upperarm_R_R", ["ccf_upperarm_RR"]],

        ["ccf_knuckle_RL", ["ccf_knuckle_RL"]],
        ["ccf_knuckle_RR", ["ccf_knuckle_RR"]],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"collision":true},
         {"selfCollision":true},
         {"nodeWeight":4.5},
         //central 'box'
         {"group":["ccf_suspension_R","ccf_lowerarm_RL"]},
         ["rx1l", 0.42, 1.2964, 0.16],
         ["rx2l", 0.42, 0.86284, 0.22],
         {"group":["ccf_suspension_R","ccf_lowerarm_RR"]},
         ["rx1r", -0.42, 1.2964, 0.16],
         ["rx2r", -0.42, 0.86284, 0.22],
         {"group":["ccf_suspension_R","ccf_upperarm_RL"]},
         ["rx3l", 0.42, 1.2964, 0.335],
         {"selfCollision":false},
         ["rx4l", 0.42, 0.97299, 0.335],
         {"group":["ccf_suspension_R","ccf_upperarm_RR"]},
         {"selfCollision":true},
         ["rx3r", -0.42, 1.2964, 0.335],
         {"selfCollision":false},
         ["rx4r", -0.42, 0.97299, 0.335],         
         
         //--REAR INDEPENDENT SUSPENSION--
         {"collision":true},
         {"selfCollision":false},
         //rear hub
         {"nodeWeight":6.5},
         {"group":["ccf_lowerarm_RR","ccf_knuckle_RR"]},
         ["rh1r",-0.6794, 1.1204, 0.19668],
         {"group":["ccf_lowerarm_RL","ccf_knuckle_RL"]},
         ["rh1l", 0.6794, 1.1204, 0.19668],    
         {"nodeWeight":4.75},
         {"selfCollision":false},
         {"group":["ccf_upperarm_RR","ccf_knuckle_RR"]},
         ["rh4r",-0.6794, 1.1204, 0.386],
         {"group":["ccf_upperarm_RL","ccf_knuckle_RL"]},
         ["rh4l", 0.6794, 1.1204, 0.386],
         //track bar repurposed from the front steering mount
         {"nodeWeight":3.0},
         {"group":["ccf_hub_RR"]},
         ["rw2r",-0.6794, 1.2846, 0.291],
         {"group":["ccf_hub_RL"]},
         ["rw2l", 0.6794, 1.2846, 0.291],
         
         {"group":["ccf_suspension_R"]},
         ["tba1r",-0.42, 1.2846, 0.26],
         ["tba1l", 0.42, 1.2846, 0.26],       


         //look at me, I'm the arb mount node now
         {"nodeWeight":2.0},
         {"group":["ccf_shockbottom_R","ccf_swaybar_R"]},
         {"selfCollision":false},
         ["rh2r",-0.5331, 1.1487, 0.24],
         {"group":["ccf_shockbottom_R","ccf_swaybar_R"]},
         ["rh2l", 0.5331, 1.1487, 0.24],     
         

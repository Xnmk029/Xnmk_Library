        ["ccf_wheel_4a_15x8_thw", ["wheel_RR","wheelhub_RR"], [], {"pos":{"x":-0.52, "y":-0.0, "z":0.0}, "rot":{"x":180, "y":0, "z":180}, "scale":{"x":1, "y":1, "z":1}}],
        ["ccf_wheel_4a_15x8_thw", ["wheel_RL","wheelhub_RL"], [], {"pos":{"x": 0.52, "y":-0.0, "z":0.0}, "rot":{"x":180, "y":0, "z":0},   "scale":{"x":1, "y":1, "z":1}}],
    ],
    "nodes": [

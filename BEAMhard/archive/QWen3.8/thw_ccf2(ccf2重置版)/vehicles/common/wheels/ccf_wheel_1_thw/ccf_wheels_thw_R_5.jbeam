        {"nodeMaterial":"|NM_METAL"},
        {"selfCollision":true},
        {"collision":true},
        {"nodeWeight":5.0},
        {"group":"wheelhub_RR"},
        {"chemEnergy":200,"burnRate":0.12,"flashPoint":200},
        ["rw1r", -0.33, 0.0, 0.0, {"staticCollision":false}],
        {"group":"wheelhub_RL"},
        ["rw1l", 0.33, 0.0, 0.0, {"staticCollision":false}],
        {"selfCollision":true},
        {"collision":true},
        {"group":"wheelhub_RR"},

        ["ccf_bonnetlights","","Country Bonnet Lights"],
    ],

    "controller": [
        ["fileName"],
        ["advancedCouplerControl", {"name":"hoodLatchCoupler"}],
        ["advancedCouplerControl", {"name":"hoodCatchCoupler"}],
    ],
    "hoodLatchCoupler":{
        "groupType": "autoCoupling",
        "couplerNodes":[
            ["cid1",    "cid2",     "autoCouplingStrength",    "autoCouplingRadius",   "autoCouplingLockRadius",   "autoCouplingSpeed"]
            ["f16",     "h7",       30000,                  0.01,                   0.005,                      0.2]
        ],
        "attachSoundVolume":1,
        "detachSoundVolume":1,
        "soundNode:":["f16"],
        "attachSoundEvent": "event:>Vehicle>Latches>Hood>modern_01_close",
        "detachSoundEvent": "event:>Vehicle>Latches>Hood>modern_02_open_lever",
        "breakSoundEvent":"",
        "openForceMagnitude": 0,
        "openForceDuration": 0.0,

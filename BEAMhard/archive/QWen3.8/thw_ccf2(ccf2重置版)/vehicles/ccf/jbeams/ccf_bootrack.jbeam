         ["rfb6r",-0.521, 1.528, 0.885],

         ["rfb7l", 0.485, 1.667, 0.860],
         ["rfb7r",-0.485, 1.667, 0.860],

         {"group":""},
         //rigidifier
         {"collision":false},
         {"selfCollision":false},
         {"group":""},
         ["rfb8",  0   , 1.602, 1.102],   

{
"ccf_boostgauge": {
    "information":{
        "authors":"Theo Wilkinson",
        "name":"1 Extra Gauge Display",
        "value":10
    },
    "slotType" : "ccf_extragauges", 
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["ccf_digiboost", ["ccf_body","ccf_pillar","ccf_bootfloor"]],
    ],        
    "slots":[
        ["type", "default", "description"],
        ["1_digidash_cells_bottom_left_ccf","ccf_digidash_cells_bottom_left_boost", "Display"],
    ],         
    "glowMap":{
        "digidash_screen_ccf":{"simpleFunction":{"ignitionLevel":0.5}, "off":"ccf_offscreen", "on":"ccf_offscreen", "on_intense":"digidash_screen_ccf"},
    }   ,
    "controller": [
        ["fileName"],
        ["gauges/genericGauges", {"name":"gaugeextra"}],
        ["gauges/customModules/environmentData"],
        ["gauges/customModules/combustionEngineData"],
        ["gauges/customModules/electricMotorData"],
        ["gauges/customModules/accelerationData"],
        ["gauges/customModules/tireData"],
    ],
    "gaugeextra": {
        "configuration": {
            "materialName": "@digidash_screen_ccf"
            "htmlPath": "local://local/vehicles/common/racinginterior/digidash/screen_v1.0.html"
            "displayWidth":1024,
            "displayHeight":512,
            "cells":{} //incase no subparts
        },
        "displayData": {
            "electrics": [
                "gear",
                "fuel",
                "watertemp",
                "wheelspeed",
                "linelock",
                "transbrake",
                "rpmTacho",
                "airspeed",
                "watertemp",
                "oiltemp",
                "maxrpm",
                "fuelVolume",
                "engineRunning",
                "lowfuel",
                "turboBoost",
                "hasABS",
                "absActive",
                "hasESC",
                "escActive",
                "hasTCS",
                "tcsActive",
                "throttle_input",
                "brake_input",
                "clutch_input",
                "checkengine",
                "lights",
                "odometer",
                "trip"
            ],
            "customModules": [
                ["moduleName", "property"]
                ["environmentData", "time"],
                ["environmentData", "temperature"],
                ["combustionEngineData", "currentPower"],
                ["combustionEngineData", "fuelConsumption"],
                ["combustionEngineData", "remainingRange"],
                ["electricMotorData", "currentPower"],
                ["electricMotorData", "remainingRange"],
                ["tireData", "pressures"]
                ["tireData", "temperatures"]
                ["accelerationData", "accelerationSmooth"]
            ]
        },
    },
},

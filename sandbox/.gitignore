# sandbox 自管理忽略规则 —— 新增"不可入库"内容请先在此登记。
# 协议与源码（AGENTS.md / README.md / scripts/*.py / review-lab 源码）保持入库。

# 临时 run（隔离测试工作区，永不入库）
runs/

# 外部 Agent / IDE 工具状态 —— 依 AGENTS.md 不得写在本目录；历史遗留仅忽略不删除
.arts/
.codeartsdoer/
.merkle-snapshot.json
.cursor/
.claude/
.devin/
.windsurf/
.trae/

# review-lab 生成物与外部参考资产（由 review-lab/build_*.py 重建；vendor/参考实现来自外部）
review-lab/review.html
review-lab/index.html
review-lab/catalog.json
review-lab/reference-assets/
review-lab/shots/
review-lab/dev/review-check.js

# 兼容归位前的旧布局生成物
/review.html
/index.html
/catalog.json
/reference-assets/

# 调试与截图残留
*.png
*.jpg
scripts/.review-check.js
scripts/.debug.cjs
scripts/.offline.cjs

# Python 缓存
__pycache__/
*.pyc

{
  "protocol_version": "1.1",
  "entry_doc": "sandbox/AGENTS.md",
  "readme": "sandbox/README.md",
  "root": "sandbox/",
  "isolation": "dir+discipline",
  "roles": {
    "orchestrator": {
      "workspace": "repo root",
      "can_read": ["repo"],
      "can_write": ["sandbox/runs/**", "sandbox docs per protocol"],
      "must_not_leak": ["other models' deliverables", "project README rubrics", "DOMAIN_INDEX*"]
    },
    "tested_model": {
      "workspace": "one run dir only: sandbox/runs/<model>/<run_id>/",
      "can_read": ["TASK.md", "PROJECT_PROMPT.md", "own files"],
      "can_write": ["that run dir only"],
      "must_not": ["cd ..", "read other runs/models", "create agent tool state dirs", "edit PROJECT_PROMPT.md"]
    },
    "reviewer": {
      "workspace": "one run dir (read-only for prompt+deliverables)",
      "can_read": ["run dir only"],
      "can_write": ["REVIEW.md", "meta.json in that run dir"],
      "must_not": ["read project README rubric", "read other runs/models", "edit prompt or deliverables"]
    }
  },
  "pipeline": {
    "prepare": "python sandbox/scripts/prepare_run.py --project <P> --model <M>",
    "review": "python sandbox/scripts/review_run.py --run <run_dir> [--strict]",
    "collect": "python sandbox/scripts/collect_run.py --run <run_dir> [--dry-run] [--with-review] [--force]",
    "status": "python sandbox/scripts/status.py [--model M] [--pending] [--json]"
  },
  "run_files": {
    "TASK.md": "discipline + prompt copy + answer contract (generated)",
    "PROJECT_PROMPT.md": "verbatim prompt copy (sha256 in meta.prompt_sha256, do not edit)",
    "meta.json": "run metadata; verdict/status lifecycle: prepared → reviewed → collected",
    "result.json": "model self-report, REQUIRED — must include integrity{read_prompt_only,read_other_model_outputs,external_help} and deliverable",
    "REVIEW.md": "reviewer output (generated)"
  },
  "verdicts": ["PASS", "PASS_WITH_WARNINGS", "FAIL", "INVALID"],
  "collect_gate": {
    "allowed_verdicts": ["PASS", "PASS_WITH_WARNINGS"],
    "refused": ["FAIL", "INVALID", "unreviewed"],
    "override": "--force (logged into MIGRATION.md)"
  },
  "forbidden_inside_run": [".git", "node_modules", "暂存", "_archives", "FARM100", "Vision", "DOMAIN_INDEX.*", "session.v2.jsonl"],
  "agent_tool_state": "forbidden inside sandbox/ and run dirs — keep tool config at repo root or system level",
  "review_lab": {
    "path": "sandbox/review-lab/",
    "scope": "offline comparison UI; NOT part of the tested-model pipeline",
    "build": ["python sandbox/review-lab/build_catalog.py", "python sandbox/review-lab/build_review_ui.py"]
  }
}

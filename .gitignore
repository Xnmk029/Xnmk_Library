# Only include prompts, docs, and lightweight source files (.md, .html, .js, .css, .py, etc.)
# Exclude heavy binaries, 3D meshes, archives, images, media & node_modules

*
!/
!*.md
!*.txt
!*.json
!*.html
!*.css
!*.js
!*.ts
!*.jsx
!*.tsx
!*.py
!*.sh
!*.ps1
!*.yml
!*.yaml
!.gitignore

# Exclude node_modules, build output, scratch, and archives explicitly
node_modules/
dist/
build/
.venv/
venv/
scratch/
*.zip
*.rar
*.7z
*.tar.gz
*.apk
*.dae
*.bin
*.exe
*.iso
*.psd
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.wav
*.mp3

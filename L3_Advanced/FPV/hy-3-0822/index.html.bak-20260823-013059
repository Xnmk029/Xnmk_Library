function applyExpo(v, expo) { const a = Math.abs(v); return sgn(v) * (a * a * a * expo + a * (1 - expo)); }

function readChannel(name, dt) {
  const cfg = S.input.map[name];
  if (usingPad && cfg.axis >= 0 && cfg.axis < rawAxes.length) {
    let v = rawAxes[cfg.axis];
    if (cfg.invert) v = -v;
    v += cfg.trim;
    const db = cfg.deadband;
    const a = Math.abs(v);
    v = a < db ? 0 : sgn(v) * (a - db) / (1 - db);
    v = clamp(v, -1, 1);
    v = applyExpo(v, cfg.expo);
    if (name === 'throttle') return cfg.unipolar ? clamp((v + 1) * 0.5, 0, 1) : clamp(v, 0, 1);
    return v;
  }
  /* 键盘回退 */
  if (name === 'throttle') {
    if (keys['w']) kbThrottle += dt * 1.7;
    if (keys['s']) kbThrottle -= dt * 1.9;
    if (keys[' ']) kbThrottle = 1;
    kbThrottle = clamp(kbThrottle, 0, 1);
    return kbThrottle;
  }
  let tgt = 0;
  if (name === 'yaw') tgt = (keys['d'] ? 1 : 0) - (keys['a'] ? 1 : 0);
  if (name === 'roll') tgt = (keys['ArrowRight'] ? 1 : 0) - (keys['ArrowLeft'] ? 1 : 0);
  /* pitch：↑ 等价于摇杆前推（通道 −1 → 机头下压），与真机 Mode-2 手感一致 */
  if (name === 'pitch') tgt = (keys['ArrowDown'] ? 1 : 0) - (keys['ArrowUp'] ? 1 : 0);
  const rate = tgt === 0 ? 14 : 9;
  kbSmooth[name] += (tgt - kbSmooth[name]) * clamp(dt * rate, 0, 1);
  return clamp(kbSmooth[name], -1, 1);
}

let prevBtn = [];
function pollInput(dt) {
  const pads = navigator.getGamepads ? navigator.getGamepads() : [];
  let pad = null;
  for (const p of pads) if (p && p.connected && p.axes && p.axes.length >= 2) { pad = p; break; }
  usingPad = !!pad;
  if (pad) {
    rawAxes = Array.prototype.slice.call(pad.axes);
    rawButtons = pad.buttons.map(b => b.value);
    padInfo = pad.id;
  } else { rawAxes = []; rawButtons = []; }

  /* 通道学习：捕捉第一个显著变化的轴 */
  if (learn && usingPad) {
    for (let i = 0; i < rawAxes.length; i++) {
      const base = learn.base[i] === undefined ? 0 : learn.base[i];
      if (Math.abs(rawAxes[i] - base) > 0.42) {
        S.input.map[learn.ch].axis = i;
        toast('通道 ' + learn.ch.toUpperCase() + ' → 轴 ' + i, '#5dff9b');
        learn = null; saveSettings(); buildInputTab();
        break;
      }
    }
  }

  channels.throttle = readChannel('throttle', dt);
  channels.yaw = readChannel('yaw', dt);
  channels.roll = readChannel('roll', dt);
  channels.pitch = readChannel('pitch', dt);

  /* 手柄按键：A=解锁 B=复位 START=设置 */
  for (let i = 0; i < rawButtons.length; i++) {
    const now = rawButtons[i] > 0.5, was = prevBtn[i] > 0.5;
    if (now && !was) {
      if (i === 0) toggleArm();
      else if (i === 1) respawn(true);
      else if (i === 9 || i === 8) togglePanel();
    }
    prevBtn[i] = rawButtons[i];
  }
}

/* ------------------------------------------------------------------ 7. DYNAMICS --------- */
const drone = {
  p: HOME.slice(), v: [0, 0, 0],
  R: M3.id(),                      /* 姿态 ∈ SO(3)：列 = 机体 X(右)/Y(上)/Z(前) 在世界系的表达 */
  w: [0, 0, 0],                    /* 机体角速度 ω = [pitch(X), yaw(Y), roll(Z)] rad/s */
  wPrev: [0, 0, 0],
  iTerm: [0, 0, 0], dLpf: [0, 0, 0], sp: [0, 0, 0], tau: [0, 0, 0],
  thr: 0, thrCmd: 0, spin: 0,
  armed: false, crashed: false, respawnT: 0,
  batt: { soc: 1, v: 25.2, mah: 0, amps: 0 },
  orthoT: 0
};
const sim = { t: 0, paused: false, flightT: 0, gates: 0, sig: 1, sigRaw: 1, lost: 0, lostT: 0, failsafe: false, started: false };

function respawn(msg) {
  drone.p = HOME.slice(); drone.v = [0, 0, 0];
  drone.R = M3.id(); drone.w = [0, 0, 0]; drone.wPrev = [0, 0, 0];
  drone.iTerm = [0, 0, 0]; drone.dLpf = [0, 0, 0];
  drone.thr = 0; drone.thrCmd = 0; drone.armed = false; drone.crashed = false; drone.respawnT = 0;
  drone.batt = { soc: 1, v: 25.2, mah: 0, amps: 0 };
  sim.flightT = 0; sim.gates = 0; sim.failsafe = false; sim.lostT = 0; sim.sig = 1; sim.sigRaw = 1; sim.lost = 0;
  for (const g of gates) g.side = 0;
  kbThrottle = 0;
  if (msg) toast('已复位到起飞点', '#3ff0ff');
}
function toggleArm() {
  if (drone.crashed) { respawn(true); return; }
  drone.armed = !drone.armed;
  if (drone.armed) { drone.iTerm = [0, 0, 0]; sim.flightT = 0; toast('ARMED · 已解锁', '#5dff9b'); Sound.arm(); }
  else toast('DISARMED · 已上锁', '#ff8a2b');
}
function crash(speed) {
  if (drone.crashed) return;
  drone.crashed = true; drone.armed = false; drone.thrCmd = 0; drone.thr = 0;
  drone.respawnT = 2.4;
  drone.w = [drone.w[0] * 0.3, drone.w[1] * 0.3, drone.w[2] * 0.3];
  toast('CRASH · 炸机', '#ff3b4e');
  Sound.crash(clamp(speed / 20, 0.2, 1));
}

/* Betaflight 风格速率曲线：摇杆 → 目标角速度（rad/s） */
function stickToRate(x, rc, sup, expo) {
  const a = Math.abs(clamp(x, -1, 1));
  const e = a * (a * a * expo + (1 - expo));
  let deg = 200 * rc * e;
  if (sup > 0.01) deg *= 1 / Math.max(0.01, 1 - Math.min(a * sup, 0.99));
  return sgn(x) * deg * DEG;
}
function maxRateDeg() {
  const r = S.rates;
  return Math.round(stickToRate(1, r.rcRate, r.superRate, r.expo) * RAD);
}

/* 自稳（Angle / Failsafe 使用）：由 R 直接构造角速度指令，不使用欧拉角积分 */
function levelTargetOmega(tiltPitch, tiltRoll, yawRate) {
  /* 期望机体上方向（世界系）：由目标倾角构造 */
  const wUp = [0, 1, 0];
  const bodyZ = M3.col(drone.R, 2);
  const headXZ = V3.norm([bodyZ[0], 0, bodyZ[2] || 1e-6]);
  const headRight = [headXZ[2], 0, -headXZ[0]];
  /* 目标上向量 = 世界上向量绕机头方向偏转 */
  const desUp = V3.norm(V3.add(V3.add(wUp, V3.mul(headXZ, Math.tan(tiltPitch))), V3.mul(headRight, Math.tan(tiltRoll))));
  const d = M3.mulTV(drone.R, desUp);                 /* 机体系下的期望上方向 */
  const axis = [d[2], 0, -d[0]];                      /* (0,1,0) × d */
  const ang = Math.acos(clamp(d[1], -1, 1));
  const L = Math.hypot(axis[0], axis[2]) || 1e-9;
  const k = 9.0;
  return [axis[0] / L * ang * k, yawRate, axis[2] / L * ang * k];
}

function pidStep(h, target) {
  const cfg = [S.pid.pitch, S.pid.yaw, S.pid.roll];
  const alphaD = 1 - Math.exp(-h * 2 * Math.PI * S.pid.dLpf);
  for (let i = 0; i < 3; i++) {
    const g = cfg[i];
    const e = target[i] - drone.w[i];
    const dGyro = (drone.w[i] - drone.wPrev[i]) / h;
    drone.dLpf[i] += (dGyro - drone.dLpf[i]) * alphaD;
    const pTerm = g.p * e;
    const dTerm = -g.d * drone.dLpf[i];
    let u = pTerm + drone.iTerm[i] + dTerm;
    /* 抗积分饱和：仅在未饱和或误差反向时积分 */
    if (Math.abs(u) < 1 || sgn(e) !== sgn(u)) {
      drone.iTerm[i] = clamp(drone.iTerm[i] + g.i * e * h, -S.pid.iLimit, S.pid.iLimit);
    }
    u = clamp(pTerm + drone.iTerm[i] + dTerm, -1, 1);
    const tMax = (i === 1) ? S.phys.tMaxY : S.phys.tMaxRP;
    drone.tau[i] = u * tMax;
  }
}

function collideAt(p, rad) {
  for (const c of colliders) {
    if (c.type === 'box') {
      const dx = p[0] - c.c[0], dz = p[2] - c.c[2];
      const cs = Math.cos(-c.yaw), sn = Math.sin(-c.yaw);
      const lx = dx * cs - dz * sn, lz = dx * sn + dz * cs, ly = p[1] - c.c[1];
      const qx = Math.max(Math.abs(lx) - c.h[0], 0);
      const qy = Math.max(Math.abs(ly) - c.h[1], 0);
      const qz = Math.max(Math.abs(lz) - c.h[2], 0);
      if (qx * qx + qy * qy + qz * qz < rad * rad) return c;
    } else if (c.type === 'cyl') {
      const dx = p[0] - c.c[0], dz = p[2] - c.c[2];
      const dr = Math.max(Math.hypot(dx, dz) - c.r, 0);
      const dy = Math.max(Math.abs(p[1] - c.c[1]) - c.h / 2, 0);
      if (dr * dr + dy * dy < rad * rad) return c;
    } else if (c.type === 'ring') {
      const d = V3.sub(p, c.c);
      const along = V3.dot(d, c.n);
      const radial = V3.sub(d, V3.mul(c.n, along));
      const L = V3.len(radial);
      const dd = Math.hypot(L - c.R, along);
      if (dd < rad + c.r) return c;
    }
  }
  return null;
}

function checkGates() {
  for (const g of gates) {
    const d = V3.sub(drone.p, g.c);
    const along = V3.dot(d, g.n);
    const s = along > 0 ? 1 : -1;
    if (g.side === 0) { g.side = s; continue; }
    if (s !== g.side) {
      const radial = V3.len(V3.sub(d, V3.mul(g.n, along)));
      if (radial < g.R && Math.abs(along) < 1.2) {
        sim.gates++; Sound.blip();
        toast('穿门 +1  (' + sim.gates + ')', '#5dff9b', 0.6);
      }
      g.side = s;
    }
  }
}

function physicsStep(h) {
  const P = S.phys;

  /* ---------- 1. 摇杆 → 目标角速度（Acro：直接映射速率） ---------- */
  let target;
  if (sim.failsafe) {
    target = levelTargetOmega(0, 0, 0);
  } else if (S.sim.mode === 'angle') {
    target = levelTargetOmega(-channels.pitch * 38 * DEG, channels.roll * 38 * DEG,
                              stickToRate(channels.yaw, S.rates.yawRcRate, S.rates.yawSuper, S.rates.expo));
  } else {
    target = [
      -stickToRate(channels.pitch, S.rates.rcRate, S.rates.superRate, S.rates.expo),  /* X: 俯仰 */
       stickToRate(channels.yaw, S.rates.yawRcRate, S.rates.yawSuper, S.rates.expo),  /* Y: 偏航 */
      -stickToRate(channels.roll, S.rates.rcRate, S.rates.superRate, S.rates.expo)    /* Z: 横滚 */
    ];
  }
  if (!drone.armed) target = [0, 0, 0];
  drone.sp = target;

  /* ---------- 2. 三轴 PID：角速度误差 → 控制力矩 ---------- */
  pidStep(h, target);
  if (!drone.armed) { drone.tau = [0, 0, 0]; drone.iTerm = [0, 0, 0]; }

  /* ---------- 3. 角动力学：I ω̇ = τ − ω×(Iω) − c·ω，SO(3) 指数映射积分 ---------- */
  const I = [P.iPitch, P.iYaw, P.iRoll];
  const Iw = [I[0] * drone.w[0], I[1] * drone.w[1], I[2] * drone.w[2]];
  const gyro = V3.cross(drone.w, Iw);
  const wm = V3.len(drone.w);
  const alpha = [0, 0, 0];
  for (let i = 0; i < 3; i++) {
    const damp = -(P.angDamp * drone.w[i] + P.angDamp * 0.45 * drone.w[i] * wm);
    alpha[i] = (drone.tau[i] - gyro[i] + damp) / I[i];
  }
  drone.wPrev = drone.w.slice();
  const wNew = [drone.w[0] + alpha[0] * h, drone.w[1] + alpha[1] * h, drone.w[2] + alpha[2] * h];
  /* 中点法角速度用于姿态演化，提高积分精度 */
  const wMid = [(drone.w[0] + wNew[0]) * 0.5, (drone.w[1] + wNew[1]) * 0.5, (drone.w[2] + wNew[2]) * 0.5];
  drone.w = wNew;
  drone.R = M3.mul(drone.R, M3.expMap(wMid, h));      /* R ← R · exp([ω]× h) */
  drone.orthoT += h;
  if (drone.orthoT > 0.05) { drone.R = M3.orthonormalize(drone.R); drone.orthoT = 0; }

  /* ---------- 4. 电机 / 电池 ---------- */
  /* Failsafe：接管油门至略低于悬停值，实现自稳缓降 */
  const thrIn = sim.failsafe ? clamp(hoverThrottle() - 0.10, 0, 1) : channels.throttle;
  drone.thrCmd = drone.armed ? thrIn : 0;
  const tauM = Math.max(0.004, P.motorTau);
  drone.thr += (drone.thrCmd - drone.thr) * (1 - Math.exp(-h / tauM));
  const b = drone.batt;
  b.amps = drone.armed ? (2.5 + 92 * Math.pow(clamp(drone.thr, 0, 1), 1.75)) : 0.35;
  b.mah += b.amps * h / 3.6;
  b.soc = clamp(1 - b.mah / 1350, 0, 1);
  const vCell = 3.42 + 0.78 * Math.pow(b.soc, 0.55) - b.amps * 0.0042;
  b.v = clamp(vCell, 2.9, 4.25) * 6;
  const battFactor = clamp((b.v / 25.2) * 1.02, 0.55, 1.04);

  /* ---------- 5. 平动动力学：F = R·[0,T,0] + m·g + F_drag(v²) ---------- */
  const thrustMax = P.twr * P.mass * G;
  const thrNorm = drone.armed ? (P.idle + (1 - P.idle) * Math.pow(clamp(drone.thr, 0, 1), P.thrustExpo)) : 0;
  const T = thrustMax * thrNorm * battFactor;
  const Fthrust = M3.mulV(drone.R, [0, T, 0]);
  const speed = V3.len(drone.v);
  const Fdrag = [
    -P.dragK * speed * drone.v[0],
    -P.dragK * P.dragUp * speed * drone.v[1],
    -P.dragK * speed * drone.v[2]
  ];
  const F = [Fthrust[0] + Fdrag[0], Fthrust[1] - P.mass * G + Fdrag[1], Fthrust[2] + Fdrag[2]];
  const a = [F[0] / P.mass, F[1] / P.mass, F[2] / P.mass];
  drone.v = [drone.v[0] + a[0] * h, drone.v[1] + a[1] * h, drone.v[2] + a[2] * h];
  const np = [drone.p[0] + drone.v[0] * h, drone.p[1] + drone.v[1] * h, drone.p[2] + drone.v[2] * h];

  /* ---------- 6. 碰撞 ---------- */
  const RAD = 0.135;
  const hit = collideAt(np, RAD);
  if (hit) {
    const sp = V3.len(drone.v);
    if (sp > 2.2) { drone.p = np; crash(sp); }
    else drone.v = V3.mul(drone.v, -0.25);   /* 低速轻触：反弹并保持原位，不炸机 */
  } else drone.p = np;

  /* 地面 */
  if (drone.p[1] < RAD) {
    const vy = drone.v[1];
    drone.p[1] = RAD;
    const hs = Math.hypot(drone.v[0], drone.v[2]);
    if ((-vy > 5.5 || hs > 8.5) && !drone.crashed) crash(Math.max(-vy, hs));
    drone.v[1] = Math.abs(vy) > 0.6 ? -vy * 0.22 : 0;
    const fr = drone.crashed ? 0.86 : 0.94;
    drone.v[0] *= fr; drone.v[2] *= fr;
    if (!drone.armed || drone.crashed) {
      /* 停机时逐渐水平静置 */
      drone.w = V3.mul(drone.w, 0.90);
      const lv = levelTargetOmega(0, 0, 0);
      drone.R = M3.orthonormalize(M3.mul(drone.R, M3.expMap(V3.mul(lv, 0.55), h)));
    }
  }
  if (drone.p[1] > 260) { drone.p[1] = 260; drone.v[1] = Math.min(0, drone.v[1]); }
  const far = Math.hypot(drone.p[0], drone.p[2]);
  if (far > 250) { const k = 250 / far; drone.p[0] *= k; drone.p[2] *= k; drone.v[0] *= -0.2; drone.v[2] *= -0.2; }

  checkGates();

  drone.spin += h * (18 + 320 * drone.thr);
  if (drone.armed && !drone.crashed) sim.flightT += h;
  if (drone.crashed) { drone.respawnT -= h; if (drone.respawnT <= 0) respawn(false); }
  if (b.soc <= 0.001 && drone.armed) { drone.armed = false; toast('电池耗尽 · AUTO DISARM', '#ff3b4e'); }
}

/* ------------------------------------------------------------------ 8. VTX SIGNAL ------- */
function updateSignal(dt) {
  const V = S.vtx;
  const dist = V3.dist(drone.p, HOME);
  /* 距离衰减：全信号半径内 100%，到最大链路距离线性→0 */
  let q = 1 - smoothstep(V.fullRange, V.maxRange, dist);
  /* 多径起伏（模拟 5.8G 抖动） */
  const t = sim.t;
  const flick = 0.5 + 0.5 * Math.sin(t * 5.7 + Math.sin(t * 2.3) * 2.1);
  q *= 1 - 0.22 * (1 - q) * flick;
  /* 贴地/贴障碍时菲涅尔遮挡损耗 */
  q *= lerp(0.80, 1.0, clamp(drone.p[1] / 2.2, 0, 1));
  if (dist >= V.maxRange) q = 0;
  q = clamp(q, 0, 1);
  sim.sigRaw = q;
  sim.sig += (q - sim.sig) * (1 - Math.exp(-dt * 7));

  const lostNow = sim.sig < V.cutoff;
  sim.lost += ((lostNow ? 1 : 0) - sim.lost) * (1 - Math.exp(-dt * (lostNow ? 6 : 3.5)));
  if (lostNow) sim.lostT += dt; else sim.lostT = Math.max(0, sim.lostT - dt * 2);

  /* 失控保护：链路丢失 0.35s 触发自稳下降 */
  if (V.failsafe && sim.lostT > 0.35 && drone.armed && !sim.failsafe) {
    sim.failsafe = true; toast('FAILSAFE · 失控保护', '#ff3b4e');
  }
  if (sim.failsafe) {
    /* 油门接管在 physicsStep 内完成（自稳缓降）；着陆后自动上锁 */
    if (drone.p[1] < 0.35) { drone.armed = false; sim.failsafe = false; toast('FAILSAFE LANDED', '#ff8a2b'); }
    if (sim.sig > 0.22 && sim.lostT <= 0) { sim.failsafe = false; toast('LINK RESTORED', '#5dff9b'); }
  }
  document.getElementById('lostBanner').style.display = (sim.lost > 0.55) ? 'block' : 'none';
}
function hoverThrottle() {
  const P = S.phys;
  const need = 1 / Math.max(0.5, P.twr);                 /* 悬停推力 / 最大推力 */
  return clamp(Math.pow(Math.max(0, (need - P.idle) / (1 - P.idle)), 1 / P.thrustExpo), 0, 1);
}

/* ------------------------------------------------------------------ 9. RENDER ----------- */
const SUN = V3.norm([0.42, 0.66, -0.62]);
let camPos = HOME.slice(), camRight = [1, 0, 0], camUp = [0, 1, 0], camFwd = [0, 0, 1];
let chasePos = [0, 2, -24];
const droneParts = [];

function buildDroneParts() {
  droneParts.length = 0;
  const M = M4.fromRT(drone.R, drone.p, 1);
  const put = (m, lp, lr, ls, color, mat, opt) => {
    opt = opt || {};
    const local = M4.fromRT(lr || M3.id(), lp, ls);
    const mm = M4.mul(M, local);
    droneParts.push({
      mesh: m, model: new Float32Array(mm), nrm: new Float32Array(M4.normal3(mm)),
      color: color, color2: opt.color2 || C.white, mat: mat, uv: opt.uv || [1, 1],
      spec: opt.spec === undefined ? 0.6 : opt.spec
    });
  };
  /* 机架 */
  put(MESH.box, [0, 0, 0.005], null, [0.085, 0.030, 0.165], C.carbon, 4, { uv: [4, 8] });
  put(MESH.box, [0, 0.028, -0.03], null, [0.062, 0.026, 0.075], C.dark, 4, { uv: [3, 3] });
  /* 摄像头（带前倾角） */
  put(MESH.box, [0, 0.040, 0.045], M3.fromAxisAngle([1, 0, 0], -S.view.camTilt * DEG),
      [0.040, 0.040, 0.048], C.dark, 4);
  put(MESH.disc, [0, 0.046, 0.070], M3.fromAxisAngle([1, 0, 0], (90 - S.view.camTilt) * DEG),
      [0.026, 0.010, 0.026], hex('#101418'), 4, { spec: 0.95 });
  /* 四臂 + 电机 + 桨 */
  const arm = 0.115;
  let k = 0;
  for (const sx of [-1, 1]) for (const sz of [-1, 1]) {
    const ax = sx * arm, az = sz * arm;
    const ang = Math.atan2(ax, az);
    put(MESH.box, [ax * 0.5, 0, az * 0.5], M3.fromAxisAngle([0, 1, 0], ang),
        [0.022, 0.012, arm * 1.5], C.carbon, 4, { uv: [2, 6] });
    put(MESH.cyl, [ax, 0.016, az], null, [0.046, 0.030, 0.046], C.steel, 4, { spec: 0.9 });
    const dir = (k % 2 === 0) ? 1 : -1;
    put(MESH.disc, [ax, 0.036, az], M3.fromAxisAngle([0, 1, 0], drone.spin * dir),
        [0.128, 0.004, 0.128], k < 2 ? C.cyan : C.magenta, 5);
    put(MESH.disc, [ax, 0.036, az], M3.fromAxisAngle([0, 1, 0], drone.spin * dir + 1.05),
        [0.128, 0.003, 0.128], k < 2 ? C.cyan : C.magenta, 5);
    k++;
  }
  /* 尾部 LED + 天线 */
  put(MESH.box, [0, 0.018, -0.088], null, [0.055, 0.010, 0.012], drone.armed ? C.green : C.red, 5);
  put(MESH.cyl, [0.03, 0.055, -0.075], M3.fromAxisAngle([1, 0, 0], 0.4), [0.006, 0.09, 0.006], C.orange, 5);
}

function updateCamera(dt) {
  if (S.view.chase) {
    const off = M3.mulV(drone.R, [0, 0.42, -1.55]);
    const want = V3.add(drone.p, off);
    const k = 1 - Math.exp(-dt * 6.5);
    chasePos = [lerp(chasePos[0], want[0], k), lerp(chasePos[1], Math.max(0.35, want[1]), k), lerp(chasePos[2], want[2], k)];
    camPos = chasePos;
    const look = V3.add(drone.p, V3.mul(drone.v, 0.10));
    camFwd = V3.norm(V3.sub(look, camPos));
    camRight = V3.norm(V3.cross(camFwd, [0, 1, 0]));
    camUp = V3.cross(camRight, camFwd);
  } else {
    const Rc = M3.mul(drone.R, M3.fromAxisAngle([1, 0, 0], -S.view.camTilt * DEG));
    camPos = V3.add(drone.p, M3.mulV(drone.R, [0, 0.035, 0.055]));
    camRight = M3.col(Rc, 0); camUp = M3.col(Rc, 1); camFwd = M3.col(Rc, 2);
  }
}

function drawObjects(list, VP) {
  const u = progObj.u;
  for (const o of list) {
    gl.uniformMatrix4fv(u.uModel, false, o.model);
    gl.uniformMatrix3fv(u.uNrm, false, o.nrm);
    gl.uniform3fv(u.uColor, o.color);
    gl.uniform3fv(u.uColor2, o.color2);
    gl.uniform2fv(u.uUVScale, o.uv);
    gl.uniform1i(u.uMat, o.mat);
    gl.uniform1f(u.uSpec, o.spec);
    gl.bindVertexArray(o.mesh.vao);
    gl.drawElements(gl.TRIANGLES, o.mesh.count, gl.UNSIGNED_SHORT, 0);
  }
}

function render(dt) {
  const asp = CW / CH;
  const fovH = S.view.fov * DEG;
  const fovY = 2 * Math.atan(Math.tan(fovH / 2) / Math.max(0.4, asp));
  const proj = M4.perspective(fovY, asp, 0.035, 900);
  const view = M4.view(camRight, camUp, camFwd, camPos);
  const VP = M4.mul(proj, view);
  const invVP = M4.invert(VP);

  gl.bindFramebuffer(gl.FRAMEBUFFER, target.fbo);
  gl.viewport(0, 0, target.w, target.h);
  gl.disable(gl.CULL_FACE);
  gl.enable(gl.DEPTH_TEST);
  gl.depthFunc(gl.LEQUAL);
  gl.clearColor(0.05, 0.07, 0.10, 1);
  gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);

  /* --- 天空 --- */
  gl.useProgram(progSky.p);
  gl.depthMask(false); gl.disable(gl.DEPTH_TEST);
  gl.uniformMatrix4fv(progSky.u.uInvVP, false, new Float32Array(invVP));
  gl.uniform3fv(progSky.u.uCamPos, camPos);
  gl.uniform3fv(progSky.u.uSunDir, SUN);
  gl.uniform1f(progSky.u.uTime, sim.t);
  gl.uniform1f(progSky.u.uExposure, S.view.exposure);
  gl.bindVertexArray(emptyVAO);
  gl.drawArrays(gl.TRIANGLES, 0, 3);
  gl.enable(gl.DEPTH_TEST); gl.depthMask(true);

  /* --- 场景物体 --- */
  gl.useProgram(progObj.p);
  gl.uniformMatrix4fv(progObj.u.uVP, false, new Float32Array(VP));
  gl.uniform3fv(progObj.u.uCamPos, camPos);
  gl.uniform3fv(progObj.u.uSunDir, SUN);
  gl.uniform1f(progObj.u.uTime, sim.t);
  gl.uniform1f(progObj.u.uFog, S.view.fog);
  gl.uniform1f(progObj.u.uExposure, S.view.exposure);
  gl.uniform3fv(progObj.u.uDrone, drone.p);
  drawObjects(drawList, VP);
  if (S.view.chase) { buildDroneParts(); drawObjects(droneParts, VP); }

  /* --- VTX 后处理 --- */
  gl.bindFramebuffer(gl.FRAMEBUFFER, null);
  gl.viewport(0, 0, CW, CH);
  gl.disable(gl.DEPTH_TEST); gl.depthMask(false);
  gl.useProgram(progPost.p);
  gl.activeTexture(gl.TEXTURE0);
  gl.bindTexture(gl.TEXTURE_2D, target.tex);
  gl.uniform1i(progPost.u.uScene, 0);
  gl.uniform2f(progPost.u.uRes, target.w, target.h);
  gl.uniform1f(progPost.u.uTime, sim.t);
  gl.uniform1f(progPost.u.uSig, sim.sig);
  gl.uniform1f(progPost.u.uLost, sim.lost);
  gl.uniform1f(progPost.u.uOn, S.vtx.enabled ? 1 : 0);
  gl.uniform1f(progPost.u.uNoise, S.vtx.noise);
  gl.uniform1f(progPost.u.uTear, S.vtx.tear);
  gl.uniform1f(progPost.u.uBands, S.vtx.bands);
  gl.uniform1f(progPost.u.uChroma, S.vtx.chroma);
  gl.uniform1f(progPost.u.uScan, S.vtx.scan);
  gl.uniform1f(progPost.u.uVig, S.vtx.vig);
  gl.bindVertexArray(emptyVAO);
  gl.drawArrays(gl.TRIANGLES, 0, 3);
  gl.depthMask(true);
}


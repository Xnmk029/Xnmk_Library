/* ---------- 物体 ---------- */
const OBJ_VS = `#version 300 es
layout(location=0) in vec3 aPos;
layout(location=1) in vec3 aNrm;
layout(location=2) in vec2 aUV;
uniform mat4 uModel, uVP;
uniform mat3 uNrm;
out vec3 vWorld; out vec3 vNormal; out vec2 vUV;
void main(){

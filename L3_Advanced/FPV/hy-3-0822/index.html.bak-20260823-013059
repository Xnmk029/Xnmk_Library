  } else if (curTab === 'view') {
    html = group('摄像头 / 画面', [
      { label: 'FOV 水平 (°)', path: 'view.fov', min: 70, max: 165, step: 1 },
      { label: '摄像头上仰角 (°)', path: 'view.camTilt', min: 0, max: 60, step: 1 },

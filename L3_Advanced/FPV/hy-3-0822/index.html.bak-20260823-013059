  .chn .liveBar{height:6px;border:1px solid var(--line);position:relative;margin:5px 0 3px;background:rgba(0,0,0,.4);}
  .chn .liveBar i{position:absolute;top:0;bottom:0;background:var(--orange);}
  .btn{background:#0a1620;border:1px solid var(--line);color:var(--cyan);font-family:inherit;
       font-size:10.5px;padding:3px 8px;cursor:pointer;}
  .btn:hover{background:rgba(63,240,255,.16);}
  .btn.wide{width:100%;padding:6px;margin-top:4px;}
  .note{font-size:10px;color:var(--dim);line-height:1.6;margin:4px 0 2px;}
  .kbd{display:inline-block;border:1px solid var(--line);padding:0 4px;border-radius:2px;color:var(--cyan);font-size:10px;}

  /* ---------------- intro ---------------- */
  #intro{position:fixed;inset:0;z-index:40;background:radial-gradient(circle at 50% 40%,#0b1a24 0%,#03060a 70%);
         display:flex;align-items:center;justify-content:center;}
  #introCard{max-width:660px;padding:26px 30px;border:1px solid var(--line);background:rgba(4,10,15,.86);}
  #introCard h1{font-size:22px;color:var(--cyan);letter-spacing:2px;}

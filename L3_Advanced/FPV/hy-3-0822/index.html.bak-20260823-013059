        { type: 'note', text: '控制律：τ = clamp(P·e + ∫I·e + (−D·dω/dt), ±1) × τ_max，e = ω_target − ω。D 项作用于陀螺测量值以避免设定值突跳，并带一阶低通与抗积分饱和。' }
      ]);
  } else if (curTab === 'phys') {
    html = group('机体与气动参数', [
      { label: '质量 (kg)', path: 'phys.mass', min: 0.2, max: 2.0, step: 0.01 },
      { label: '推重比 T/W', path: 'phys.twr', min: 1.5, max: 16, step: 0.1 },
      { label: '阻尼系数 k (v²)', path: 'phys.dragK', min: 0, max: 0.05, step: 0.0005 },
      { label: '垂直阻尼倍率', path: 'phys.dragUp', min: 0.5, max: 3, step: 0.05 },
      { label: '角阻尼', path: 'phys.angDamp', min: 0, max: 0.02, step: 0.0002 },
      { type: 'note', text: 'F = R·[0,T,0] + m·g + F_drag，其中 F_drag = −k·|v|·v（与速度平方成正比）。' }
    ]) + group('转动惯量 / 力矩上限', [
      { label: 'I 俯仰 (kg·m²)', path: 'phys.iPitch', min: 0.001, max: 0.03, step: 0.0002 },
      { label: 'I 偏航 (kg·m²)', path: 'phys.iYaw', min: 0.001, max: 0.05, step: 0.0002 },
      { label: 'I 横滚 (kg·m²)', path: 'phys.iRoll', min: 0.001, max: 0.03, step: 0.0002 },
      { label: 'τ max 横滚/俯仰', path: 'phys.tMaxRP', min: 0.05, max: 2.0, step: 0.01 },
      { label: 'τ max 偏航', path: 'phys.tMaxY', min: 0.02, max: 1.2, step: 0.01 },
      { label: '电机时间常数 (s)', path: 'phys.motorTau', min: 0.005, max: 0.2, step: 0.001 },
      { label: '油门曲线指数', path: 'phys.thrustExpo', min: 0.8, max: 2.2, step: 0.01 },
      { label: '怠速推力比', path: 'phys.idle', min: 0, max: 0.2, step: 0.005 },
      { type: 'note', text: '角动力学：I·ω̇ = τ − ω×(Iω) − c·ω，姿态经 R ← R·exp([ω]×Δt) 积分（Rodrigues 闭式指数映射，500 Hz 定步长）。' }
    ]);
  } else if (curTab === 'vtx') {
    html = group('5.8G 链路预算', [
      { type: 'check', label: '启用图传后处理', path: 'vtx.enabled' },
      { label: '满信号半径 (m)', path: 'vtx.fullRange', min: 10, max: 250, step: 1 },
      { label: '最大链路距离 (m)', path: 'vtx.maxRange', min: 30, max: 600, step: 1 },
      { label: '失联阈值', path: 'vtx.cutoff', min: 0.01, max: 0.3, step: 0.005 },
      { type: 'check', label: '启用 Failsafe 失控保护', path: 'vtx.failsafe' },
      { type: 'note', text: '信号强度 = 1 − smoothstep(满信号半径, 最大距离, |p − 起点|)，再叠加多径起伏与贴地遮挡损耗。' }
    ]) + group('模拟图传视效强度', [
      { label: '雪花噪点', path: 'vtx.noise', min: 0, max: 2, step: 0.05 },
      { label: '横向撕裂', path: 'vtx.tear', min: 0, max: 2, step: 0.05 },

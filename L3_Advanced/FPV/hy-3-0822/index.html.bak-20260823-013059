function compile(type, src) {
  const s = gl.createShader(type);
  gl.shaderSource(s, src); gl.compileShader(s);
  if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
    console.error(gl.getShaderInfoLog(s), src.split('\n').map((l, i) => (i + 1) + ': ' + l).join('\n'));
    throw new Error('shader compile error');
  }
  return s;
}
function program(vs, fs, uniforms) {
  const p = gl.createProgram();
  gl.attachShader(p, compile(gl.VERTEX_SHADER, vs));
  gl.attachShader(p, compile(gl.FRAGMENT_SHADER, fs));
  gl.linkProgram(p);
  if (!gl.getProgramParameter(p, gl.LINK_STATUS)) { console.error(gl.getProgramInfoLog(p)); throw new Error('link error'); }
  const u = {};
  for (const n of uniforms) u[n] = gl.getUniformLocation(p, n);
  return { p, u };
}

/* ---------- GLSL 公共块：hash / value noise / fbm / 程序化天空 / tonemap ---------- */
const COMMON = `
uniform float uTime;
uniform vec3  uSunDir;
uniform float uExposure;
float h11(float p){ p=fract(p*0.1031); p*=p+33.33; p*=p+p; return fract(p); }
float h21(vec2 p){ vec3 q=fract(vec3(p.xyx)*0.1031); q+=dot(q,q.yzx+33.33); return fract((q.x+q.y)*q.z); }
float vnoise(vec2 p){
  vec2 i=floor(p), f=fract(p);
  f=f*f*(3.0-2.0*f);
  float a=h21(i), b=h21(i+vec2(1.0,0.0)), c=h21(i+vec2(0.0,1.0)), d=h21(i+vec2(1.0,1.0));
  return mix(mix(a,b,f.x), mix(c,d,f.x), f.y);
}
float fbm(vec2 p){
  float s=0.0, a=0.5;
  for(int i=0;i<5;i++){ s+=a*vnoise(p); p=p*2.03+vec2(17.3,9.1); a*=0.5; }
  return s;
}
vec3 skyColor(vec3 d){
  d = normalize(d);
  float up = max(d.y, 0.0);
  vec3 zenith = vec3(0.10,0.26,0.58);
  vec3 horiz  = vec3(0.62,0.74,0.88);
  vec3 col = mix(horiz, zenith, pow(up, 0.55));
  col = mix(col, vec3(0.30,0.30,0.29), smoothstep(0.0,-0.22,d.y));
  float sun = max(dot(d, uSunDir), 0.0);
  col += vec3(1.0,0.88,0.66) * pow(sun, 900.0) * 12.0;
  col += vec3(1.0,0.72,0.42) * pow(sun, 14.0)  * 0.32;
  col += vec3(1.0,0.85,0.70) * pow(sun, 3.0)   * 0.07;
  if(d.y > 0.015){
    vec2 cp = d.xz / (d.y + 0.10) * 0.55;
    float c1 = fbm(cp*0.55 + vec2(uTime*0.0035, 0.0));
    float c2 = fbm(cp*1.60 - vec2(uTime*0.0060, 0.0));
    float c  = smoothstep(0.50, 0.92, c1*0.72 + c2*0.35);
    c *= smoothstep(0.015, 0.30, d.y);
    vec3 cc = mix(vec3(0.55,0.58,0.64), vec3(1.25,1.22,1.18), smoothstep(0.35,0.85,c1));
    col = mix(col, cc, c*0.88);
  }
  return col;
}
vec3 tonemap(vec3 c){
  c *= uExposure;
  c = c / (1.0 + c);
  return pow(clamp(c,0.0,1.0), vec3(1.0/2.2));
}
`;


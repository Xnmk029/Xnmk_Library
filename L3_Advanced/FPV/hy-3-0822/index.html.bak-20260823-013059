  #introCard ul{list-style:none;font-size:11.5px;line-height:1.95;color:var(--txt);}
  #introCard ul b{color:var(--cyan);}
  #startBtn{margin-top:18px;width:100%;padding:11px;font-size:13px;letter-spacing:3px;font-weight:700;
            background:var(--cyan);color:#04141a;border:0;cursor:pointer;font-family:inherit;}
  #startBtn:hover{background:#8bf6ff;}
  #padState{font-size:11px;color:var(--dim);margin-top:10px;}
  #help{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:35;display:none;
        border:1px solid var(--line);background:rgba(4,10,15,.93);padding:18px 22px;font-size:11.5px;line-height:2;}
  #help h3{color:var(--cyan);margin-bottom:8px;font-size:13px;letter-spacing:1px;}

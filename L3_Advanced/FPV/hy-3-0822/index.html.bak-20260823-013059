const OBJ_FS = `#version 300 es
precision highp float;
in vec3 vWorld; in vec3 vNormal; in vec2 vUV;
out vec4 frag;
uniform vec3 uCamPos, uColor, uColor2, uDrone;
uniform vec2 uUVScale;
uniform int  uMat;
uniform float uFog, uSpec;
${COMMON}

float gridLine(vec2 p, float period, float w){
  vec2 g = abs(fract(p/period + 0.5) - 0.5) * period;
  return 1.0 - smoothstep(w, w*2.4, min(g.x, g.y));
}

void main(){
  vec3 N = normalize(vNormal);
  if(!gl_FrontFacing) N = -N;
  vec2 uv = vUV * uUVScale;
  vec3 albedo = uColor;
  float spec = uSpec;
  float shade = 1.0;
  float dist = length(uCamPos - vWorld);

  if(uMat == 1){
    /* ---- 地表：草地 + 中央混凝土花飞场 + 涂装 ---- */
    vec2 wp = vWorld.xz;
    vec3 grass = mix(vec3(0.035,0.070,0.024), vec3(0.085,0.135,0.045), fbm(wp*0.33));
    grass *= 0.80 + 0.42*fbm(wp*2.30);
    float dirt = smoothstep(0.52, 0.78, fbm(wp*0.115 + 21.0));
    grass = mix(grass, vec3(0.115,0.088,0.058), dirt*0.75);

    float cn = fbm(wp*1.15);
    vec3 conc = vec3(0.140,0.146,0.156) * (0.78 + 0.46*cn);
    conc += vec3(0.05) * step(0.86, h21(floor(wp*24.0)));
    float joints = gridLine(wp, 4.0, 0.035) * smoothstep(90.0, 22.0, dist);
    conc = mix(conc, vec3(0.045,0.048,0.052), joints*0.85);
    float ring = abs(length(wp) - 13.0);
    conc = mix(conc, vec3(0.42,0.16,0.03), smoothstep(0.30,0.10,ring)*0.85);
    float lane = abs(abs(wp.x) - 9.0);
    conc = mix(conc, vec3(0.50,0.50,0.48), smoothstep(0.16,0.05,lane)*0.55*step(abs(wp.y),26.0));

    /* 场地边界带噪声扰动，避免死板直线 */
    float edge = max(abs(wp.x), abs(wp.y)) + (fbm(wp*0.10) - 0.5) * 4.0;
    float pad = smoothstep(31.0, 27.0, edge);
    albedo = mix(grass, conc, pad);

    /* 机身软阴影 */
    vec2 dxz = wp - uDrone.xz;
    float rr = 0.55 + uDrone.y*0.55;
    float blob = exp(-dot(dxz,dxz)/max(0.12, rr*rr)) * exp(-uDrone.y*0.10);
    shade = 1.0 - 0.62*clamp(blob,0.0,1.0);
    spec = 0.05;
  } else if(uMat == 2){
    /* ---- 高对比警示斜条纹 ---- */
    float s = step(0.5, fract((uv.x*0.8 + uv.y) * 1.4));
    albedo = mix(uColor, uColor2, s);
  } else if(uMat == 3){
    /* ---- 混凝土 / 废墟 ---- */
    float n = fbm(vWorld.xz*1.8 + vWorld.y*0.7);
    float n2 = fbm(vWorld.xz*9.0 + vWorld.y*3.1);
    albedo = uColor * (0.66 + 0.55*n) + vec3(0.035)*step(0.80, n2);
    float crack = smoothstep(0.46,0.50, fbm(vWorld.xz*3.4 + vec2(vWorld.y*1.7)));
    albedo *= 1.0 - 0.30*crack;
    spec = 0.06;
  } else if(uMat == 4){
    /* ---- 金属 / 碳纤 ---- */
    float w = step(0.5, fract(uv.x*26.0)) * step(0.5, fract(uv.y*26.0));
    albedo = uColor * (0.82 + 0.30*w);
    spec = 0.85;
  } else if(uMat == 5){
    /* ---- 自发光（灯标 / LED / 门框霓虹） ---- */
    vec3 c = uColor * 2.4;
    float f = 1.0 - exp(-dist*uFog*0.55);
    c = mix(c, skyColor(normalize(vWorld - uCamPos)), f*0.75);
    frag = vec4(tonemap(c), 1.0);
    return;
  } else if(uMat == 6){
    /* ---- 棋盘（高对比视觉参照） ---- */
    float c = mod(floor(uv.x) + floor(uv.y), 2.0);
    albedo = mix(uColor, uColor2, c);
  }

  /* ---- 光照：定向太阳 + 半球环境光 + Blinn 高光 ---- */
  float ndl = max(dot(N, uSunDir), 0.0);
  float sunVis = shade;
  vec3 sun = vec3(1.0, 0.955, 0.885) * 2.35 * ndl * sunVis;
  vec3 amb = mix(vec3(0.115,0.135,0.115), vec3(0.30,0.40,0.58), 0.5 + 0.5*N.y);
  vec3 Vd = normalize(uCamPos - vWorld);
  vec3 H = normalize(Vd + uSunDir);
  float sp = pow(max(dot(N,H),0.0), 46.0) * spec * ndl * sunVis;
  vec3 col = albedo * (sun + amb) + vec3(sp) * vec3(1.0,0.97,0.92);

  /* ---- 指数雾（融入天空色，提供纵深参照） ---- */
  float f = 1.0 - exp(-dist * uFog);
  col = mix(col, skyColor(normalize(vWorld - uCamPos)), clamp(f,0.0,1.0));
  frag = vec4(tonemap(col), 1.0);
}`;

/* ---------- VTX 图传后处理：雪花噪点 / 横向撕裂 / 滚动条纹 / 失联黑屏 ---------- */
const POST_FS = `#version 300 es
precision highp float;
in vec2 vUV;
out vec4 frag;
uniform sampler2D uScene;
uniform vec2  uRes;
uniform float uTime, uSig, uLost, uOn;
uniform float uNoise, uTear, uBands, uChroma, uScan, uVig;

float h11(float p){ p=fract(p*0.1031); p*=p+33.33; p*=p+p; return fract(p); }
float h21(vec2 p){ vec3 q=fract(vec3(p.xyx)*0.1031); q+=dot(q,q.yzx+33.33); return fract((q.x+q.y)*q.z); }
vec3 tex(vec2 uv){ return texture(uScene, clamp(uv, vec2(0.0005), vec2(0.9995))).rgb; }

void main(){
  vec2 uv0 = vUV;
  if(uOn < 0.5){ frag = vec4(tex(uv0), 1.0); return; }

  float d  = clamp(1.0 - uSig, 0.0, 1.0);     /* 信号劣化度 0..1 */
  float dd = d * d;
  float t  = uTime;

  /* 护目镜镜筒轻微桶形畸变 */
  vec2 c = uv0 - 0.5;
  vec2 uv = 0.5 + c * (1.0 + (0.035 + 0.05*d) * dot(c, c));

  /* --- 横向撕裂：按扫描行随机水平位移 --- */
  float rowH = 240.0;
  float row  = floor(uv.y * rowH);
  float tf   = floor(t * 28.0);
  float rs   = h21(vec2(row, tf));
  float tearOn  = step(1.0 - d * 0.55 * uTear, rs);
  float tearAmt = (h21(vec2(row * 1.73, tf + 7.0)) - 0.5) * (0.020 + 0.24 * dd) * uTear;
  uv.x += tearOn * tearAmt;
  /* 大块撕裂（低信号时整段画面横向错位） */
  float blk = floor(uv.y * 9.0);
  float bs  = h21(vec2(blk, floor(t*6.0)));
  uv.x += step(1.0 - dd*0.35, bs) * (bs - 0.5) * 0.16 * uTear;

  /* --- 不同步滚动条纹（垂直滚动的同步失锁带） --- */
  float rollPos = fract(t * (0.075 + 0.60 * d));
  float bandW   = 0.045 + 0.20 * d;
  float bdist   = abs(fract(uv.y - rollPos + 0.5) - 0.5);
  float band    = smoothstep(bandW, 0.0, bdist) * uBands;
  uv.x += band * (0.012 + 0.085 * d) * sin(t * 9.0 + uv.y * 34.0);
  uv.y += band * 0.0045 * d;
  /* 50Hz 电源哼声横纹 */
  float hum = smoothstep(0.03, 0.0, abs(fract(uv.y * 2.0 - t * 0.19 + 0.5) - 0.5)) * uBands;

  /* --- 色度分离（模拟色副载波失锁） --- */
  float ca = (0.0012 + 0.0135 * dd) * uChroma * (1.0 + band * 2.5);
  vec3 col;
  col.r = tex(uv + vec2(ca, 0.0)).r;
  col.g = tex(uv).g;
  col.b = tex(uv - vec2(ca * 0.85, 0.0)).b;

  /* 模拟信号去饱和 + 亮度抖动 */
  float lum = dot(col, vec3(0.299, 0.587, 0.114));
  col = mix(col, vec3(lum), 0.58 * d);
  col *= 1.0 - 0.22 * band;
  col += 0.11 * band + 0.05 * hum * d;
  col *= 1.0 + 0.05 * d * (h11(floor(t * 34.0)) - 0.5);

  /* --- 雪花噪点：细颗粒 + 横向拉丝 --- */
  vec2 np1 = vec2(floor(uv.x * uRes.x * 0.5), floor(uv.y * uRes.y * 0.5));
  vec2 np2 = vec2(floor(uv.x * uRes.x * 0.10), floor(uv.y * uRes.y * 0.5));
  float n1 = h21(np1 + vec2(t * 331.0, t * 57.0));
  float n2 = h21(np2 + vec2(t * 97.0, t * 13.0));
  float snow = mix(n1, n2, 0.45);
  float amt = clamp(d * 1.18 - 0.09, 0.0, 1.0);
  amt = amt * amt * uNoise;
  float drop = step(0.994 - 0.03 * d, h21(vec2(row, floor(t * 47.0) + 31.0))) * d;
  col = mix(col, vec3(snow), clamp(amt * 0.95 + drop * 0.55, 0.0, 1.0));
  /* 行噪压暗 */
  col *= 1.0 - 0.20 * d * h21(vec2(row * 0.31, floor(t * 24.0)));

  /* --- 扫描线 / 暗角 --- */
  col *= 1.0 - uScan * 0.32 * (0.5 + 0.5 * sin(uv.y * uRes.y * 3.14159));
  float vg = smoothstep(1.20, 0.28, length(c * vec2(1.06, 1.0)) * 1.34);
  col *= mix(1.0, vg, uVig);

  /* --- 失联：整屏黑屏，偶发同步雪花闪断 --- */
  if(uLost > 0.001){
    float ln = h21(uv * uRes * 0.55 + vec2(t * 211.0, t * 97.0));
    float burst = step(0.90, h11(floor(t * 2.7))) * step(0.45, h11(floor(t * 19.0)));
    vec3 lostCol = vec3(ln) * 0.85 * burst;
    col = mix(col, lostCol, uLost);
  }

}

/* 环形门：门圈 + 两侧立柱 + 底座；同时注册穿门检测与门圈碰撞 */
function addRingGate(x, z, yawDeg, R, cy, color, tube) {
  tube = tube || 0.085;
  const rot = yawRot(yawDeg);
  const n = [Math.sin(yawDeg * DEG), 0, Math.cos(yawDeg * DEG)];
  addObj(getTorus(R, tube), [x, cy, z], rot, 1, color, 6, { color2: C.white, uv: [1.4, 3.0], spec: 0.45 });
  addObj(getTorus(R, tube * 0.45), [x, cy, z], rot, 1, color === C.orange ? C.cyan : C.magenta, 5);
  const rx = Math.cos(yawDeg * DEG), rz = -Math.sin(yawDeg * DEG);   /* 门平面内的水平方向 */
  for (const s of [-1, 1]) {
    const px = x + rx * R * s, pz = z + rz * R * s;
    const hgt = Math.max(0.4, cy);
    addCyl([px, hgt / 2, pz], 0.075, hgt, C.yellow, 2, true, { color2: C.carbon, uv: [1, hgt * 1.6] });
    addBox([px, 0.06, pz], [0.6, 0.12, 0.6], 0, C.dark, 3, false);
  }
  colliders.push({ type: 'ring', c: [x, cy, z], n: n, R: R, r: tube + 0.02 });
  gates.push({ c: [x, cy, z], n: n, R: R - 0.15, side: 0, name: 'R' });
}

/* 方门（旗门）：两立柱 + 上下横梁，中间为可穿越窗口 */
function addSquareGate(x, z, yawDeg, w, bottom, top, color) {
  const rot = yawRot(yawDeg);
  const rx = Math.cos(yawDeg * DEG), rz = -Math.sin(yawDeg * DEG);
  const n = [Math.sin(yawDeg * DEG), 0, Math.cos(yawDeg * DEG)];
  for (const s of [-1, 1]) {
    const px = x + rx * (w / 2) * s, pz = z + rz * (w / 2) * s;
    addBox([px, top / 2, pz], [0.16, top, 0.16], yawDeg, color, 2, true, { color2: C.white, uv: [1, top * 1.4] });
  }
  addBox([x, top, z], [w + 0.16, 0.16, 0.16], yawDeg, color, 2, true, { color2: C.white, uv: [w * 1.4, 1] });
  addBox([x, bottom, z], [w + 0.16, 0.14, 0.14], yawDeg, color, 2, true, { color2: C.white, uv: [w * 1.4, 1] });
  /* 窗口下沿霓虹提示条（贴在下横梁上，不阻挡航线） */
  addObj(MESH.box, [x, bottom + 0.10, z], rot, [w, 0.04, 0.04], C.cyan, 5);
  gates.push({ c: [x, (bottom + top) / 2 + 0.2, z], n: n, R: Math.min(w, top - bottom) / 2 - 0.1, side: 0, name: 'S' });
}

/* 墙体废墟：带两个可穿越窗洞 + 破损顶沿 */
function addRuinWall(x, z, yawDeg, W, H) {
  const rot = yawRot(yawDeg);
  const T = 0.55;
  const winW = 3.0, winB = 1.35, winT = 4.35;
  const colW = (W - winW * 2) / 3;
  const put = (ox, oy, sx, sy) => {
    const px = x + Math.cos(yawDeg * DEG) * ox, pz = z - Math.sin(yawDeg * DEG) * ox;
    addBox([px, oy, pz], [sx, sy, T], yawDeg, C.concrete, 3, true, { uv: [sx, sy], spec: 0.08 });
  };
  const local = ox => [x + Math.cos(yawDeg * DEG) * ox, z - Math.sin(yawDeg * DEG) * ox];
  put(0, winB / 2, W, winB);                                 /* 窗台以下的整段墙体 */
  put(0, (H + winT) / 2, W, H - winT);                       /* 窗楣以上的整段墙体 */
  for (const ox of [-(W / 2 - colW / 2), 0, W / 2 - colW / 2])
    put(ox, (winB + winT) / 2, colW, winT - winB);           /* 三处墙垛，其间为两个可穿越窗洞 */

  /* 破损顶沿碎块（废墟感） */
  for (let i = 0; i < 7; i++) {
    const ox = (i / 6 - 0.5) * (W - 1.4);
    const hh = 0.45 + ((i * 37) % 11) / 11 * 1.6;
    const p = local(ox);
    addBox([p[0], H + hh / 2 - 0.1, p[1]], [1.5, hh, T * 0.92], yawDeg + (i % 3 - 1) * 4,
           C.concrete, 3, true, { uv: [1.5, hh], spec: 0.08 });
  }
  /* 窗台高对比涂装 */
  addObj(MESH.box, [x, winB + 0.07, z], rot, [W, 0.14, T + 0.03], C.orange, 5);

  /* 两个窗洞：霓虹上下沿 + 穿越检测 */
  const winOff = W / 2 - colW - winW / 2;
  for (const s of [-1, 1]) {
    const p = local(s * winOff);
    const cyy = (winB + winT) / 2;
    addObj(MESH.box, [p[0], winB + 0.16, p[1]], rot, [winW, 0.05, T + 0.06], C.cyan, 5);
    addObj(MESH.box, [p[0], winT - 0.16, p[1]], rot, [winW, 0.05, T + 0.06], C.cyan, 5);
    gates.push({
      c: [p[0], cyy, p[1]], n: [Math.sin(yawDeg * DEG), 0, Math.cos(yawDeg * DEG)],
      R: Math.min(winW, winT - winB) / 2 - 0.15, side: 0, name: 'W'
    });
  }
}


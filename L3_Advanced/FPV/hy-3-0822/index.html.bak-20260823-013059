const drawList = [];      /* 静态几何 */
const colliders = [];     /* 碰撞体 */
const gates = [];         /* 穿门检测 */

function addObj(m, pos, rot, scale, color, mat, opt) {
  opt = opt || {};
  const mm = M4.fromRT(rot || M3.id(), pos, scale === undefined ? 1 : scale);
  drawList.push({
    mesh: m, model: new Float32Array(mm), nrm: new Float32Array(M4.normal3(mm)),
    color: color, color2: opt.color2 || C.white, mat: mat,
    uv: opt.uv || [1, 1], spec: opt.spec === undefined ? 0.22 : opt.spec
  });
}
function yawRot(deg) { return M3.fromAxisAngle([0, 1, 0], deg * DEG); }

function addBox(pos, size, yawDeg, color, mat, collide, opt) {
  opt = opt || {};
  addObj(MESH.box, pos, opt.rot || yawRot(yawDeg), size, color, mat, opt);
  if (collide) colliders.push({ type: 'box', c: pos.slice(), h: [size[0] / 2, size[1] / 2, size[2] / 2], yaw: yawDeg * DEG });
}
function addCyl(pos, r, h, color, mat, collide, opt) {
  opt = opt || {};
  addObj(opt.hi ? MESH.cylHi : MESH.cyl, pos, opt.rot || M3.id(), [r * 2, h, r * 2], color, mat, opt);

const TABS = [
  { id: 'input', name: '输入' }, { id: 'rates', name: '手感' }, { id: 'pid', name: 'PID' },
  { id: 'phys', name: '物理' }, { id: 'vtx', name: '图传' }, { id: 'view', name: '画面' }
];
let curTab = 'input';

function itemRow(it) {
  if (it.type === 'note') return '<div class="note">' + it.text + '</div>';
  if (it.type === 'check') {
    return '<div class="row"><label>' + it.label + '</label><input type="checkbox" data-bind="' + it.path + '" data-kind="check">' +
           '<span class="num"></span></div>';
  }
  if (it.type === 'select') {
    return '<div class="row"><label>' + it.label + '</label><select data-bind="' + it.path + '" data-kind="select">' +
           it.options.map(o => '<option value="' + o[0] + '">' + o[1] + '</option>').join('') + '</select></div>';
  }
  return '<div class="row"><label>' + it.label + '</label>' +
    '<input type="range" min="' + it.min + '" max="' + it.max + '" step="' + it.step + '" data-bind="' + it.path + '" data-kind="range">' +
    '<span class="num" data-for="' + it.path + '"></span></div>';
}
function group(title, items) {
  return '<div class="grp"><h3>' + title + '</h3>' + items.map(itemRow).join('') + '</div>';
}
function bindAll(root) {
  root.querySelectorAll('[data-bind]').forEach(el => {
    const path = el.dataset.bind, kind = el.dataset.kind;
    const val = getPath(S, path);
    if (kind === 'check') el.checked = !!val;
    else el.value = val;
    const num = root.querySelector('[data-for="' + path + '"]');
    const show = () => { if (num) num.textContent = (typeof getPath(S, path) === 'number' ? (+getPath(S, path)).toFixed(String(el.step || '').includes('.') ? (String(el.step).split('.')[1] || '').length : 0) : ''); };
    show();
    el.addEventListener('input', () => {
      let v;
      if (kind === 'check') v = el.checked;
      else if (kind === 'select') v = el.value;
      else v = parseFloat(el.value);
      setPath(S, path, v);
      show(); saveSettings();
      if (path === 'view.renderScale') resizeCanvas();
      if (path === 'audio.volume' || path === 'audio.enabled') Sound.setVol();
    });
  });
}


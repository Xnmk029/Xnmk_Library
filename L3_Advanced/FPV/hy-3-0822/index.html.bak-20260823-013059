    ]) + group('快捷键', [
      { type: 'note', text: '<span class="kbd">Enter</span> 解锁/上锁　<span class="kbd">R</span> 复位　<span class="kbd">C</span> 视角　<span class="kbd">V</span> 图传特效　<span class="kbd">M</span> 模式　<span class="kbd">P</span> 暂停　<span class="kbd">Tab</span> 设置　<span class="kbd">H</span> 帮助' }
    ]);
  }
  body.innerHTML = html;
  bindAll(body);
}
function refreshPanel() { if ($('panel').classList.contains('open')) renderTab(); }

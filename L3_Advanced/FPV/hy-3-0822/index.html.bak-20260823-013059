    addCyl([px, 1.6, pz], 0.09, 3.2, C.steel, 4, false);
    addObj(MESH.sphere, [px, 3.4, pz], M3.id(), 0.26, i % 2 ? C.orange : C.red, 5);
  }
}
buildWorld();

/* ------------------------------------------------------------------ 6. INPUT ------------ */
const channels = { throttle: 0, yaw: 0, roll: 0, pitch: 0 };
const keys = Object.create(null);
let rawAxes = [], rawButtons = [], padInfo = null, learn = null;
let kbThrottle = 0;
const kbSmooth = { yaw: 0, roll: 0, pitch: 0 };
let usingPad = false;

window.addEventListener('keydown', e => {

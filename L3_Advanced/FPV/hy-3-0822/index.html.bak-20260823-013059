function hex(h) {                                          /* sRGB hex → 近似线性 */
  const n = parseInt(h.slice(1), 16);
  const f = v => Math.pow(v / 255, 2.2);
  return [f((n >> 16) & 255), f((n >> 8) & 255), f(n & 255)];
}
const C = {
  ground: hex('#3a5a26'), concrete: hex('#8e9298'), dark: hex('#2b3138'),
  orange: hex('#ff7a1a'), white: hex('#f2f4f6'), cyan: hex('#25e6ff'),

/* ---------- PID 示波器 ---------- */
const scope = $('scope'), sctx = scope.getContext('2d');
const SCN = 260;
const scopeBuf = { sp: new Float32Array(SCN), gy: new Float32Array(SCN), i: 0 };
function pushScope() {
  const ax = S.pid.scope === 'pitch' ? 0 : S.pid.scope === 'yaw' ? 1 : 2;
  scopeBuf.sp[scopeBuf.i] = drone.sp[ax] * RAD;
  scopeBuf.gy[scopeBuf.i] = drone.w[ax] * RAD;
  scopeBuf.i = (scopeBuf.i + 1) % SCN;
}
function drawScope() {
  const w = scope.width, h = scope.height;
  sctx.clearRect(0, 0, w, h);
  sctx.fillStyle = 'rgba(0,10,16,.55)'; sctx.fillRect(0, 0, w, h);
  sctx.strokeStyle = 'rgba(63,240,255,.16)'; sctx.lineWidth = 1;
  for (let i = 1; i < 4; i++) { const y = h * i / 4; sctx.beginPath(); sctx.moveTo(0, y); sctx.lineTo(w, y); sctx.stroke(); }
  const range = Math.max(200, maxRateDeg() * 1.15);
  const map = v => h / 2 - clamp(v / range, -1, 1) * (h / 2 - 3);
  const trace = (buf, col, lw) => {
    sctx.strokeStyle = col; sctx.lineWidth = lw; sctx.beginPath();
    for (let k = 0; k < SCN; k++) {
      const idx = (scopeBuf.i + k) % SCN;
      const x = k / (SCN - 1) * w, y = map(buf[idx]);
      k ? sctx.lineTo(x, y) : sctx.moveTo(x, y);
    }
    sctx.stroke();
  };
  trace(scopeBuf.sp, '#ff8a2b', 2.4);
  trace(scopeBuf.gy, '#3ff0ff', 2.0);
  sctx.fillStyle = 'rgba(207,233,242,.55)'; sctx.font = '18px monospace';
  sctx.fillText('±' + Math.round(range) + '°/s', 8, 20);
  $('scopeAxis').textContent = S.pid.scope.toUpperCase();
}

/* ---------- OSD ---------- */
let hudT = 0;
function updateHUD(dt) {
  if (toastT > 0) { toastT -= dt; if (toastT <= 0) $('toast').style.opacity = 0; }
  hudT += dt;
  /* 姿态角仅用于显示，不参与积分 */
  const bx = M3.col(drone.R, 0), bz = M3.col(drone.R, 2);
  const roll = Math.atan2(-bx[1], Math.hypot(bx[0], bx[2]) || 1e-6) * RAD;
  const pitch = Math.asin(clamp(bz[1], -1, 1)) * RAD;
  const hz = $('horizon');
  hz.style.transform = 'rotate(' + (-roll).toFixed(1) + 'deg) translateY(' + clamp(pitch * 2.2, -120, 120).toFixed(1) + 'px)';

  const spd = V3.len(drone.v) * 3.6;
  const dist = V3.dist(drone.p, HOME);
  $('tSpd').textContent = spd.toFixed(0);
  $('tAlt').textContent = drone.p[1].toFixed(1);
  $('tVs').textContent = (drone.v[1] >= 0 ? '+' : '') + drone.v[1].toFixed(1);
  $('tDist').textContent = dist.toFixed(0) + ' m';
  $('tTime').textContent = String(Math.floor(sim.flightT / 60)).padStart(2, '0') + ':' +
                           (sim.flightT % 60).toFixed(1).padStart(4, '0');
  $('tGate').textContent = sim.gates;
  $('tRate').textContent = maxRateDeg();
  $('tSrc').textContent = usingPad ? 'RC PAD' : 'KEYBOARD';
  $('tSrc').className = usingPad ? 'v ok' : 'v amber';

  const as = $('armState');
  if (drone.crashed) { as.textContent = 'CRASHED'; as.className = 'warn'; }
  else if (sim.failsafe) { as.textContent = 'FAILSAFE'; as.className = 'warn'; }
  else if (drone.armed) { as.textContent = 'ARMED'; as.className = 'ok'; }
  else { as.textContent = 'DISARMED'; as.className = 'warn'; }
  $('modeState').textContent = sim.paused ? 'PAUSED' : S.sim.mode.toUpperCase();

  const rssi = Math.round(sim.sig * 100);
  $('tRssi').textContent = rssi + '%';
  $('tRssi').className = 'v ' + (rssi > 55 ? 'ok' : rssi > 22 ? 'amber' : 'warn');
  $('rssiFill').style.width = rssi + '%';
  $('tVtx').textContent = '5.8G · ' + (sim.sig <= 0.001 ? 'NO LINK' : (-30 - Math.round((1 - sim.sig) * 60)) + ' dBm');
  $('tBat').textContent = drone.batt.v.toFixed(1) + 'V · ' + Math.round(drone.batt.soc * 100) + '%';
  $('batFill').style.width = (drone.batt.soc * 100).toFixed(0) + '%';
  $('batFill').style.background = drone.batt.soc > 0.35 ? '#5dff9b' : drone.batt.soc > 0.15 ? '#ff8a2b' : '#ff3b4e';
  $('thrFill').style.height = (channels.throttle * 100).toFixed(0) + '%';

  $('gL').style.left = (50 + channels.yaw * 46) + '%';
  $('gL').style.top = (100 - channels.throttle * 92 - 4) + '%';
  $('gR').style.left = (50 + channels.roll * 46) + '%';
  $('gR').style.top = (50 + channels.pitch * 46) + '%';   /* 通道 −1 = 摇杆前推（显示在上方） */

  /* 设置面板中的通道实时条 */
  if ($('panel').classList.contains('open')) {
    for (const ch of ['throttle', 'yaw', 'roll', 'pitch']) {
      const bar = $('lb_' + ch);
      if (!bar) continue;
      const v = channels[ch];
      if (ch === 'throttle') { bar.style.left = '0%'; bar.style.width = (v * 100).toFixed(1) + '%'; }
      else { bar.style.left = (50 + Math.min(0, v) * 50).toFixed(1) + '%'; bar.style.width = (Math.abs(v) * 50).toFixed(1) + '%'; }
      const num = $('ln_' + ch);
      if (num) num.textContent = v.toFixed(2);
    }
    const ai = $('axisInfo');
    if (ai) ai.textContent = usingPad ? (rawAxes.map((a, i) => i + ':' + a.toFixed(2)).join('  ')) : '未检测到手柄（使用键盘）';
  }
  drawScope();
}


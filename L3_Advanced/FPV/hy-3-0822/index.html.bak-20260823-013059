<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<title>FPV 穿越机花飞模拟器 · SO(3) 刚体动力学 / PID / VTX 图传衰减</title>
<style>
  :root{
    --cyan:#3ff0ff; --orange:#ff8a2b; --red:#ff3b4e; --green:#5dff9b;
    --bg:#05070a; --panel:rgba(8,13,20,.92); --line:rgba(63,240,255,.28);
    --txt:#cfe9f2; --dim:#7f97a4;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{width:100%;height:100%;overflow:hidden;background:var(--bg);}
  body{
    font-family:"Consolas","SF Mono","Menlo",monospace;
    color:var(--txt); user-select:none; -webkit-user-select:none;
  }
  canvas#gl{position:fixed;inset:0;width:100%;height:100%;display:block;background:#000;}

  /* ---------------- OSD ---------------- */
  #osd{position:fixed;inset:0;pointer-events:none;z-index:10;
       text-shadow:0 0 4px rgba(0,0,0,.9),0 0 12px rgba(0,0,0,.6);}
  .osd-box{position:absolute;font-size:12px;line-height:1.55;letter-spacing:.5px;}
  #osdTL{top:14px;left:16px;}
  #osdTR{top:14px;right:16px;text-align:right;}
  #osdBL{bottom:16px;left:16px;}
  #osdBR{bottom:16px;right:16px;text-align:right;}
  .k{color:var(--dim);}
  .v{color:var(--cyan);}
  .big{font-size:19px;font-weight:700;letter-spacing:1px;}
  .warn{color:var(--red);}
  .ok{color:var(--green);}
  .amber{color:var(--orange);}
  .bar{display:inline-block;width:96px;height:7px;border:1px solid var(--line);
       vertical-align:middle;margin-left:6px;position:relative;background:rgba(0,0,0,.35);}
  .bar > i{position:absolute;left:0;top:0;bottom:0;background:var(--cyan);display:block;}
  #rssiFill{background:linear-gradient(90deg,var(--red),var(--orange),var(--green));}

  /* throttle vertical bar */
  #thrWrap{position:absolute;left:16px;bottom:120px;width:12px;height:170px;
           border:1px solid var(--line);background:rgba(0,0,0,.35);}
  #thrFill{position:absolute;left:0;right:0;bottom:0;background:linear-gradient(0deg,var(--cyan),var(--orange));}
  #thrWrap:after{content:"THR";position:absolute;bottom:-16px;left:-6px;font-size:10px;color:var(--dim);}

  /* center reticle + horizon */
  #center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:340px;height:340px;}
  #cross{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:34px;height:34px;}
  #cross:before,#cross:after{content:"";position:absolute;background:var(--cyan);opacity:.85;}
  #cross:before{left:0;top:50%;width:100%;height:1px;}
  #cross:after{top:0;left:50%;height:100%;width:1px;}
  #horizon{position:absolute;left:50%;top:50%;width:260px;height:2px;margin:-1px 0 0 -130px;}
  #horizon i{position:absolute;top:0;height:2px;background:var(--cyan);opacity:.75;}
  #horizon i:first-child{left:0;width:95px;}
  #horizon i:last-child{right:0;width:95px;}

  /* stick monitors */
  #sticks{position:absolute;left:16px;bottom:20px;display:flex;gap:10px;}
  .gimbal{width:76px;height:76px;border:1px solid var(--line);position:relative;background:rgba(0,0,0,.32);}
  .gimbal:before,.gimbal:after{content:"";position:absolute;background:rgba(63,240,255,.18);}
  .gimbal:before{left:0;right:0;top:50%;height:1px;}
  .gimbal:after{top:0;bottom:0;left:50%;width:1px;}
  .gimbal b{position:absolute;width:9px;height:9px;margin:-4.5px 0 0 -4.5px;border-radius:50%;
            background:var(--orange);box-shadow:0 0 8px var(--orange);}
  .gimbal span{position:absolute;bottom:-15px;left:0;font-size:10px;color:var(--dim);}

  #scopeWrap{position:absolute;right:16px;bottom:78px;}
  #scope{width:270px;height:92px;border:1px solid var(--line);background:rgba(0,0,0,.42);display:block;}
  #scopeLbl{font-size:10px;color:var(--dim);margin-top:2px;text-align:right;}

  #toast{position:absolute;left:50%;top:16%;transform:translateX(-50%);
         font-size:24px;font-weight:800;letter-spacing:3px;text-align:center;opacity:0;
         transition:opacity .18s;}
  #lostBanner{position:absolute;left:50%;top:44%;transform:translate(-50%,-50%);
              font-size:30px;font-weight:900;letter-spacing:6px;color:var(--red);display:none;
              text-shadow:0 0 18px rgba(255,59,78,.7);}

  /* ---------------- Settings panel ---------------- */
  #gear{position:fixed;top:12px;right:12px;z-index:30;width:34px;height:34px;border:1px solid var(--line);
        background:var(--panel);color:var(--cyan);cursor:pointer;font-size:17px;line-height:32px;text-align:center;}
  #gear:hover{background:rgba(63,240,255,.14);}
  #panel{position:fixed;top:0;right:0;bottom:0;width:392px;z-index:25;background:var(--panel);
         border-left:1px solid var(--line);display:none;flex-direction:column;
         backdrop-filter:blur(7px);box-shadow:-14px 0 40px rgba(0,0,0,.6);}
  #panel.open{display:flex;}
  #panelHead{padding:12px 14px 8px;border-bottom:1px solid var(--line);}
  #panelHead h1{font-size:14px;letter-spacing:1px;color:var(--cyan);font-weight:700;}
  #panelHead p{font-size:10.5px;color:var(--dim);margin-top:3px;}
  #tabs{display:flex;flex-wrap:wrap;gap:4px;padding:8px 10px;border-bottom:1px solid var(--line);}
  .tab{font-size:11px;padding:4px 9px;border:1px solid rgba(63,240,255,.22);color:var(--dim);cursor:pointer;}
  .tab.on{color:#04141a;background:var(--cyan);border-color:var(--cyan);font-weight:700;}
  #tabBody{flex:1;overflow-y:auto;padding:10px 12px 26px;}
  #tabBody::-webkit-scrollbar{width:7px;}
  #tabBody::-webkit-scrollbar-thumb{background:rgba(63,240,255,.3);}
  .grp{border:1px solid rgba(63,240,255,.16);padding:8px 9px 10px;margin-bottom:10px;}
  .grp > h3{font-size:11px;color:var(--orange);letter-spacing:1px;margin-bottom:7px;}
  .row{display:flex;align-items:center;gap:8px;margin:5px 0;font-size:11px;}
  .row label{flex:0 0 132px;color:var(--txt);opacity:.9;}
  .row input[type=range]{flex:1;height:16px;accent-color:#3ff0ff;background:transparent;}
  .row .num{flex:0 0 62px;text-align:right;color:var(--cyan);font-variant-numeric:tabular-nums;}
  .row select,.row input[type=number]{background:#0a1620;color:var(--cyan);border:1px solid var(--line);
        font-family:inherit;font-size:11px;padding:2px 4px;flex:1;min-width:0;}

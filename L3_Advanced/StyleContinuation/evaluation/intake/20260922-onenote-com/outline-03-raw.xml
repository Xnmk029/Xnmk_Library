&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{43}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[绿灯亮了。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{46}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[侯天一的右脚早就把油门垫了一半，灯一变，整台车像被人从后头踹了一脚，猛地蹿出去。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{48}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[奥德赛的CVT把转速按在三千转上下，前轮在薄雪里空转了半圈，才咬住地面。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{50}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[旁边那台86起步就难看。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{52}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[身后传来轮胎在雪地上撕心裂肺的空转声，尖得像指甲刮搪瓷盆。侯天一用眼角余光扫了一下，86的车尾往外甩了小半尺，又被方向一把薅了回来。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{54}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[半热熔在这种天，跟两块肥皂没什么区别。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{56}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“操操操操操。”小智整个人被按在座椅上，嘴里连滚带爬蹦出一串字。他两只手死抠着头顶的扶手，手背上的筋绷成了一根根小绳，喉结上下滚了一下。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{58}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“绑好安全带你喊个蛋。”侯天一头都没回。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{60}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[仪表盘上的数字往上蹿得很快。四十。六十。除夕夜前的曹州马路空空荡荡，路灯一盏一盏从挡风玻璃上划过去，晃得人眼睛发花。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{62}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[那首歌正唱到副歌，女声扯得老高。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{64}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[小智从扶手后面探出半张脸，扭头往后瞅。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{66}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“哥！他没跟上来！”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{68}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[后视镜里，86缩成了两个小红点，看着像在路口晃了一下，才歪歪扭扭地起步。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{70}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[侯天一没搭腔，只是把嘴里那根白将军拿下来，在烟灰缸里磕了磕灰。他嘴角翘着。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{72}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[前头是条长直道，过完这两个路口就是高架上口。雪比刚才密了点，打在车顶上沙沙地响。雨刮器吱嘎吱嘎地刮，刮不干净，玻璃上糊着一层薄水膜。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{74}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“哥……哥咱们这是……赢了？”小智的声音还在抖，分不清是兴奋还是吓的。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{76}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“赢个屁。”侯天一伸手又从小智手里把那半杯冰美式夺过来，嘬了一大口，冰碴子硌得后槽牙发酸。“他胎是半热熔，零度以下跟拖鞋没两样。你让他换套雪地胎再来蹦。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{78}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“那你刚才还跟他蹦？”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{80}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“我没跟他蹦啊。”侯天一眨了眨眼，“我就是正常过个绿灯。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:45.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{82}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[小智张了张嘴，半天没接上话。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{84}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[车又往前窜了两个灯。后视镜里那两个红点慢慢大了。86追上来了，隔着两三个车身，闷闷地轰了一脚油。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{86}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[侯天一往后视镜里看了一眼。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{88}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[副驾那女的还坐着，这次没伸手比。男的双手把着方向盘，脸看不清。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{90}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[前头路口又是红灯。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{92}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[侯天一松了油门，车慢慢滑到停止线前，和旁边车道并排停下。86这次停得规矩，隔着半个车头，没再把轮眉凑过来。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{94}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[两边车窗都关着。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{96}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[歌早就切到下一首了，是个慢板钢琴。车厢里一下安静，只剩雨刮器吱嘎吱嘎。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{98}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[小智还在后喘，他扭头盯着旁边那台86，又扭头看侯天一。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{100}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“哥，他会不会还想……”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{102}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“想什么。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{104}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“再蹦一把。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{106}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[侯天一乐了，伸手在小智后脑勺上拍了一巴掌，不轻不重。“蹦你妈。这路滑得跟溜冰场似的，真出了事，大过年的咱爸咱二伯在医院凑一桌打麻将啊。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{108}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[话音没落，旁边那台86的车窗摇下来一半。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{110}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[侯天一没转头。他用余光看见一只戴黑针织手套的手伸出来，大拇指直直地竖着。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{112}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[侯天一愣了半秒，也把手搭在车窗沿上，懒洋洋抬了抬下巴。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{114}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[绿灯。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{116}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[86一脚油先走了，这次没再轰那种挑衅的响，安安静静汇进前头的车流。粉色的车尾在雪里越变越小，拐进旁边一条支路，没影了。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{118}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[小智这才把攥了半天的手松开，掌心里全是汗，在裤子上蹭了蹭。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{120}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“哥，我刚才差点尿裤子。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{122}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“出息。”侯天一又点了根烟，打火机啪地一声，火苗在风里歪了一下。他把窗户摇上去一半，雪片子才没飘进来。“你刚拿本，以后这种事少掺和。今天要不是那哥们儿胎不行，咱们这大奥德赛连人家尾气都吃不上。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{124}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“知道了知道了。”小智瘫在座椅里，半天又憋出一句。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{126}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“哥，你刚才那一下，真跟拓海似的。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{128}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[侯天一嗤了一声，没接话。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{130}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[他把车打了个方向，拐进另一条路口。雪落在挡风玻璃上，化成一道一道的水痕。远处不知道谁家先点了烟花，闷声闷气响了一下，红光在云层底下闪了闪。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{132}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[中控屏震了一下。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{134}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[是二伯发来的语音。侯天一一只手解着安全带，一只手把语音点开，外放。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{136}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“天一啊，你到哪儿了？麻将桌都摆好了，你那位置二伯给你占着呢。带上小的那个，让他今晚给咱们点炮。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{138}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[侯天一看了一眼旁边还在喘的小智。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{140}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“听见没，二伯叫你去点炮。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:53:42.000Z" lastModifiedTime="2026-09-21T18:53:46.000Z" objectID="{3FBB5E66-D7E6-4887-9FFE-332F6FDB6200}{142}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[小智脸一下垮了下来。]]></one:T></one:OE></one:OEChildren></one:Outline>

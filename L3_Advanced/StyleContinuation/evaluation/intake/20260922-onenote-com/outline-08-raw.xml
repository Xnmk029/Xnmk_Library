<one:Outline lang="en-US" author="ming xiao" authorInitials="mx" lastModifiedBy="ming xiao" lastModifiedByInitials="mx" lastModifiedTime="2026-09-21T18:54:09.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{210}{B0}" xmlns:one="http://schemas.microsoft.com/office/onenote/2013/onenote"><one:Position x="13644.0" y="374.3999938964844" z="50" /><one:Size width="468.0" height="3990.39990234375" /><one:OEChildren><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:30.000Z" lastModifiedTime="2026-09-21T18:54:09.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{106}{B0}" alignment="left" quickStyleIndex="1"><one:T><![CDATA[Seed 2.1 pro]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:40.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{109}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{211}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[绿灯亮了。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{214}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[86的排气先炸了锅，嗡的一声闷响，车身猛地往前一蹿。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{216}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[然后横着滑了出去。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{218}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[半热熔胎在积雪的柏油面上根本咬不住地，后轮原地空转，白烟混着雪沫子往后甩，车头一歪，斜着溜向了旁边车道。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{220}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[奥德赛反倒四平八稳地蹿了出去。轮胎压过路口的雪水，方向盘在侯天一手里轻轻抖了两下，被他随手按住。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{222}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“卧槽！卧槽卧槽！”小智整个人从座椅上弹起来，安全带勒得锁骨生疼，“他飘了！哥你快看，他横着走了！哎哎，后边那车差点怼上他！”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{224}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[身后喇叭声响成一片。86在路口中间扭了个小半圈，好歹被车主救了回来，发动机还在一声接一声地干吼。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{226}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“说了，这个天套着半热熔跑大街的，都是傻X。”侯天一单手搭着方向盘，另一只手把烟屁股按进烟灰缸，语气平得像在报菜名。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{228}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“你……你早就料到了？”小智扒着后车窗往外看，粉色的86正在雪地里手忙脚乱地调头，“你刚才讲那一堆轮胎的事儿，是挖坑等他呢？”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{230}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“我讲给你听的。”侯天一拿起冰美式嘬了一口，冰块撞得杯壁咔咔响，“知识点，记牢。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{232}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[小智张了张嘴，半个字没接上。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{234}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[奥德赛汇入主路。雪还在下，雨刮器吱呀吱呀地刮，刮一下，留半道水痕。侯天一骂了句脏话，顺手把雨刮档位调高了一格。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{236}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[车里头文字D的原声还在轰，鼓点密得像砸铁皮。小智跟着节奏晃了两下腿，又想起正事来。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{238}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“哥，老车的事儿。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{240}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“嗯？”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{242}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“就你们家那台闲着的老车，借我练练手呗，我保证不造。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{244}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[侯天一盯着前车的尾灯看了几秒。红光落在湿路面上，拖出一道一道晃悠的影子。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{246}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“车是有一台，在我爸车库搁快两年了。”他顿了顿，“能不能开，得先看过才知道。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{248}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“啥车啊？”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{250}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“见着你就知道了。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{252}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[小智还想刨根问底，兜里的手机震了起来。掏出来一瞅，屏幕上跳着个“妈”字。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{C78890C3-0A86-44AC-88EF-30CEBF6BA370}{254}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“喂，妈……啊对，回来了，跟天一哥在一块儿呢……吃了，早吃了……啥？咱家车打不着火了？”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{10}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[他的声音一下子拔高，侯天一斜了他一眼。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{12}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“让我爸看一眼啊？……啊？我爸喝了多少？”小智捂着话筒，扭头冲侯天一挤眉弄眼，“哥，我妈说家里车趴窝了，我爸中午就喝上了，动不了。年夜饭还等我回去呢。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{14}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“你家老院子在城东吧？”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{16}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“对对对，城东。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{18}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[侯天一打着转向灯，奥德赛顺滑地并入左转车道，车身侧倾了一小下，又稳稳回正。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{20}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“先去你家。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{22}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“那你呢，你不回去过年？”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{24}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“我一个人住，早一顿晚一顿都一样。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{26}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[车厢静了几秒，只剩音响里的鼓点和雨刮的响动。小智盯着侯天一的侧脸看了一会儿，忽然觉得这哥比刚才路口那台86还让人看不透。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{28}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[就在这时候，后视镜里亮起两束远光。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{30}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[引擎声由远及近，改装排气特有的噼啪声混在风雪里，一下一下往耳朵里钻。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{32}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[粉色的86追上来了。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{34}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“操，他还真追！”小智刚松开的安全带又被他一把扯紧，“哥，他闪灯呢，他冲咱们闪灯！”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{36}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[86从右侧车道并排靠了上来，车窗摇下，驾驶位那张脸被雪光映得发青，嘴里不干不净地喊着什么，被风撕得只剩几个脏字。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{38}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[副驾的黑丝小姐姐也放下了手机，隔着两车之间的雪雾冲这边比手势。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{40}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“哥，他骂你！”小智的脸涨得通红，半个身子都要压到方向盘上，“你倒是开窗啊！骂人这事儿我专业！”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{42}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[侯天一没看右边，眼睛盯着前方。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{44}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[前面路口的绿灯开始闪，三下，转成了黄。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{46}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[他把冰美式塞进杯架，两只手重新搭上方向盘，右脚从油门上挪开，悬在刹车和油门之间。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{48}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[86的车主也看见了黄灯，排气声陡然拔高，车身往前蹿了半个头，摆明了要抢在红灯前冲过路口。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{50}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“他要闯灯！”小智喊。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{52}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“他轮胎热了。”侯天一的声音压得很低，“这段路撒过融雪盐，路面是干的。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{54}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[小智一愣，再看那台86，后轮果然不再空甩，胎面咬住干地，车头一下一下往前拱。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{56}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[黄灯最后一闪。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{58}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[86嗡地一声蹿了出去。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{60}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[奥德赛没动。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{62}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[红灯跳亮的瞬间，路口左侧的雪幕里猛地冲出两束灯光，一辆环卫除雪车按着喇叭横了过来，车前的推雪铲正好卡在86前一秒的位置。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{64}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[86的车主一脚刹车跺死，轮胎在干地上拉出两声尖啸，整车在停止线前哆嗦着停住，离推雪铲不到半米。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{66}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[小智的呼吸卡在嗓子眼里，半天没吐出来。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{68}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[除雪车司机探出头骂了两句，关上车窗，慢悠悠地开走了。雪还在下，路口重新安静下来，只剩86的发动机在怠速里一抖一抖地响。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{70}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[侯天一这才转过头，看了隔壁一眼，摇下自己这边的车窗。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{72}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[冷风裹着雪片灌进来，小智打了个寒颤。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{74}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“兄弟。”侯天一冲着86扬了扬下巴，声音不大，刚好够对方听见，“过年了，慢点开。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{76}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[说完他升上车窗。绿灯重新亮起，奥德赛稳稳起步，驶过路口，把那台粉色的86和满路口的尾气一起留在了身后。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{78}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[小智瘫在座椅里，后背的汗被冷风一激，凉得贴肉。他扭头看了侯天一半天，憋出一句。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{80}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“哥，你早就看见那除雪车了？”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{82}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[侯天一没答，伸手把音响音量拧小了一格。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{84}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“这条路这个点，环卫除雪的车准在。”他说，“我下班天天走。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{86}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[小智咽了口唾沫，把这话在心里翻来覆去嚼了几遍，总觉得方向盘后边坐着的这人，心里头还藏着别的东西。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{88}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[奥德赛拐上城东的高架，雪小了些，远处的楼群里已经有人家放起了烟花，光在云层底下一明一灭。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{90}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[小智的手机又震了，这回是他爸的微信语音，老头舌头都直了，翻来覆去就一句。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{92}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“广智啊，回来……放鞭炮。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{94}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[他没忍住，笑出了声，笑着笑着扭头一看，侯天一也在笑，只是眼睛还盯着前头的路。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{96}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“哥。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{98}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“嗯。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{100}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“明天大年初一，别一个人待着了，上我家吃饺子。”]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{102}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[侯天一握着方向盘的手松了松，半晌，点了下头。]]></one:T></one:OE><one:OE authorResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" lastModifiedByResolutionID="&lt;resolutionId provider=&quot;Windows Live&quot; hash=&quot;7VBB3R4Oxezz4dDLg1XDkQ==&quot;&gt;&lt;localId cid=&quot;a21b323b213f5cb7&quot;/&gt;&lt;/resolutionId&gt;" creationTime="2026-09-21T18:51:21.000Z" lastModifiedTime="2026-09-21T18:51:41.000Z" objectID="{AB48A103-50A2-4EB4-A4CD-8FE0A08DE9BB}{104}{B0}" alignment="left" quickStyleIndex="1" lang="zh-CN"><one:T><![CDATA[“行。”]]></one:T></one:OE></one:OEChildren></one:Outline>

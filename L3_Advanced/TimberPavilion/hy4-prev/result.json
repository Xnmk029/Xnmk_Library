  "module_system": {
    "description": "以斗口 K（或材厚）为祖，分°=K/15。材广=caiRatio·K，栔=0.6K，足材=caiRatio·K+0.6K = 21分°（宋制）。全部构件尺寸皆由 K 与铺作制度按分°倍数推得。",
    "formulas": {
      "caiG_m": "caiRatio · K",
      "fen_m": "caiG / 15",
      "zuCai_m": "(caiRatio + 0.6) · K",
      "tiaoLen_m": "3 · K （30分°/3斗口）",
      "dgOut_m": "tiao · 3K + 0.6K",
      "dgH_m": "(2.0 + tiao·(caiRatio+1.4) + caiRatio + 2.4) · K",
      "beamH_m": "2.2 · caiG",
      "cWell_m": "0.34 · rPur",
      "raftD_m": "1.2 · K",
      "tileH_m": "0.42 · K + 0.012",
      "yEave_m": "yDgTop + raftD - profileH(tp)",
      "apex_m": "yEave + juTotal"
    }
  },
